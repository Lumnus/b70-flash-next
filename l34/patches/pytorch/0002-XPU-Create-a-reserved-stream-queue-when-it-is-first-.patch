From 1523650d89953cc3399f166d95f1455585715d82 Mon Sep 17 00:00:00 2001
From: Kaloyan Naumov <knaumov@gmail.com>
Date: Wed, 11 Nov 2026 18:27:12 +0000
Subject: [PATCH 2/2] [XPU] Create a reserved stream queue when it is first
 handed out

The reserved pool of a device, 3 priorities x 32 SYCL queues, was created
whole the first time any stream of the device was asked for. A queue holds
device memory (about 1.8 MiB each with the Level Zero v2 adapter, so about
170 MiB per pool), and a process normally uses one or two of them. Code
that only looks at a device, such as a loop that compares each device's
current queue, paid the whole pool on every device it touched.

Keep the pool layout and the stream ids, and create each queue under its
own once flag when XPUStream::queue() first needs it. Synchronizing a
device on the legacy path waits only on the queues that exist.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 c10/xpu/XPUStream.cpp               | 83 +++++++++++++++++++----------
 c10/xpu/test/impl/XPUStreamTest.cpp | 18 +++++++
 2 files changed, 74 insertions(+), 27 deletions(-)

diff --git a/c10/xpu/XPUStream.cpp b/c10/xpu/XPUStream.cpp
index 078701a..728b933 100644
--- a/c10/xpu/XPUStream.cpp
+++ b/c10/xpu/XPUStream.cpp
@@ -31,6 +31,16 @@ std::vector<std::array<
 std::deque<
     std::array<std::atomic<uint32_t>, max_compile_time_stream_priorities>>
     priority_counters;
+// A reserved SYCL queue is created when it is first handed out, not with its
+// pool: a queue holds device memory, and most of a pool is never used.
+std::deque<std::array<
+    std::array<c10::once_flag, kStreamsPerPool>,
+    max_compile_time_stream_priorities>>
+    stream_flags;
+std::deque<std::array<
+    std::array<std::atomic<bool>, kStreamsPerPool>,
+    max_compile_time_stream_priorities>>
+    stream_created;
 
 // NOLINTNEXTLINE(*c-arrays)
 thread_local std::unique_ptr<StreamId[]> current_streams = nullptr;
@@ -133,39 +143,54 @@ void initGlobalStreamState() {
   device_pool_ready.resize(num_gpus);
   streams.resize(num_gpus);
   priority_counters.resize(num_gpus);
+  stream_flags.resize(num_gpus);
+  stream_created.resize(num_gpus);
 }
 
-// Creates the reserved SYCL queue pools for the specified device. It should be
-// call only once.
+// Sets up the reserved SYCL queue pools of the specified device. It should be
+// call only once. The queues themselves are created by getOrCreateQueue().
 void initDeviceStreamState(DeviceIndex device) {
-  using namespace sycl::ext::oneapi::property;
-  // Need to align with StreamIdType.
-  const std::vector<sycl::property_list> properties = {
-      {sycl::property::queue::in_order(), queue::priority_low()},
-      {sycl::property::queue::in_order(), queue::priority_normal()},
-      {sycl::property::queue::in_order(), queue::priority_high()}};
-  TORCH_CHECK(
-      properties.size() == max_compile_time_stream_priorities,
-      "The number of stream priorities should be equal to max_compile_time_stream_priorities");
   for (const auto p : c10::irange(max_compile_time_stream_priorities)) {
-    for (const auto i : c10::irange(kStreamsPerPool)) {
-      auto& stream = streams[device][p][i];
-      stream = std::make_unique<sycl::queue>(sycl::queue(
-          c10::xpu::get_device_context(),
-          c10::xpu::get_raw_device(device),
-          c10::xpu::asyncHandler,
-          properties[p]));
-      const c10::impl::PyInterpreter* interp = c10::impl::GPUTrace::get_trace();
-      if (C10_UNLIKELY(interp)) {
-        (*interp)->trace_gpu_stream_creation(
-            c10::kXPU, reinterpret_cast<uintptr_t>(stream.get()));
-      }
-    }
     priority_counters[device][p] = 0;
   }
   device_pool_ready[device].store(true, std::memory_order_release);
 }
 
+// Returns the reserved queue of the pool slot, creating it on first use.
+sycl::queue& getOrCreateQueue(
+    DeviceIndex device,
+    uint8_t priority_idx,
+    uint8_t stream_idx) {
+  c10::call_once(
+      stream_flags[device][priority_idx][stream_idx],
+      [device, priority_idx, stream_idx] {
+        using namespace sycl::ext::oneapi::property;
+        // Need to align with StreamIdType.
+        const std::vector<sycl::property_list> properties = {
+            {sycl::property::queue::in_order(), queue::priority_low()},
+            {sycl::property::queue::in_order(), queue::priority_normal()},
+            {sycl::property::queue::in_order(), queue::priority_high()}};
+        TORCH_CHECK(
+            properties.size() == max_compile_time_stream_priorities,
+            "The number of stream priorities should be equal to max_compile_time_stream_priorities");
+        auto& stream = streams[device][priority_idx][stream_idx];
+        stream = std::make_unique<sycl::queue>(sycl::queue(
+            c10::xpu::get_device_context(),
+            c10::xpu::get_raw_device(device),
+            c10::xpu::asyncHandler,
+            properties[priority_idx]));
+        const c10::impl::PyInterpreter* interp =
+            c10::impl::GPUTrace::get_trace();
+        if (C10_UNLIKELY(interp)) {
+          (*interp)->trace_gpu_stream_creation(
+              c10::kXPU, reinterpret_cast<uintptr_t>(stream.get()));
+        }
+        stream_created[device][priority_idx][stream_idx].store(
+            true, std::memory_order_release);
+      });
+  return *streams[device][priority_idx][stream_idx];
+}
+
 void initXPUStreamsOnce() {
   auto static init_flag [[maybe_unused]] = [] {
     initGlobalStreamState();
@@ -244,8 +269,9 @@ sycl::queue& XPUStream::queue() const {
   switch (st) {
     case StreamIdType::NORMAL:
     case StreamIdType::HIGH:
-      // NOLINTNEXTLINE(performance-no-int-to-ptr)
-      return *streams[device_index][static_cast<uint8_t>(st)][si];
+      initXPUStreamsOnce();
+      initDeviceStreamOnce(device_index);
+      return getOrCreateQueue(device_index, static_cast<uint8_t>(st), si);
     // See Note [External XPU Stream]
     case StreamIdType::EXT:
       // NOLINTNEXTLINE(performance-no-int-to-ptr)
@@ -415,7 +441,10 @@ void syncStreamsOnDevice(DeviceIndex device) {
     // kStreamsPerPool (32) reserved queues per priority for each device.
     for (const auto p : c10::irange(max_compile_time_stream_priorities)) {
       for (const auto i : c10::irange(kStreamsPerPool)) {
-        streams[device][p][i]->wait();
+        // Only the queues that were handed out exist.
+        if (stream_created[device][p][i].load(std::memory_order_acquire)) {
+          streams[device][p][i]->wait();
+        }
       }
     }
     const c10::impl::PyInterpreter* interp = c10::impl::GPUTrace::get_trace();
diff --git a/c10/xpu/test/impl/XPUStreamTest.cpp b/c10/xpu/test/impl/XPUStreamTest.cpp
index f6bd6a1..217394f 100644
--- a/c10/xpu/test/impl/XPUStreamTest.cpp
+++ b/c10/xpu/test/impl/XPUStreamTest.cpp
@@ -312,3 +312,21 @@ TEST(XPUStreamTest, ExternalStreamDifferentPointersTest) {
 
   EXPECT_NE(myStream1, myStream2);
 }
+
+TEST(XPUStreamTest, QueuesAreCreatedOnFirstUse) {
+  if (!has_xpu()) {
+    return;
+  }
+  // Two slots of the same pool are distinct queues, each created by its own
+  // first use, and a slot always returns the same queue.
+  auto s1 = c10::xpu::getStreamFromPool(/*isHighPriority=*/false, 0);
+  auto s2 = c10::xpu::getStreamFromPool(/*isHighPriority=*/false, 0);
+  ASSERT_NE(s1, s2);
+  sycl::queue* q1 = &s1.queue();
+  sycl::queue* q2 = &s2.queue();
+  ASSERT_NE(q1, q2);
+  ASSERT_EQ(q1, &s1.queue());
+  ASSERT_EQ(s1.queue().get_device(), c10::xpu::get_raw_device(0));
+  // Synchronizing a device must cope with slots that were never used.
+  c10::xpu::syncStreamsOnDevice(0);
+}
