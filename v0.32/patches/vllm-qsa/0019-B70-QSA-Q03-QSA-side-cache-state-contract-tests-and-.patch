+def test_ring_contract_hook_cases():
+    """The B70_QSA_DEBUG_RING contract on hand-made frontiers."""
+    c = qsa_debug.QSARingContract(16, 4, "raise")
+    c.observe([5], [0, 37], [37])  # prefill 0..36
+    c.observe([5], [0, 8], [45])  # verify rows 37..44
+    c.observe([5], [0, 8], [46])  # 0 accepted: next verify starts at 38
+    assert c.counts["checked"] == 2
+    c.observe([6], [0, 3], [3])
+    with pytest.raises(qsa_debug.QSARingContractError, match="missing"):
+        c.observe([6], [0, 1], [10])  # starts at 9; ring stops at 2
+
+    c2 = qsa_debug.QSARingContract(8, 4, "raise")
+    c2.observe([2], [0, 41], [41])
+    c2.observe([2], [0, 8], [49])  # rows 41..48: 48 lands on 40's slot
+    with pytest.raises(qsa_debug.QSARingContractError, match="overwritten"):
+        c2.observe([2], [0, 8], [50])  # 0 accepted: starts at 42, needs 40
+
+    c3 = qsa_debug.QSARingContract(16, 4, "warn")
+    c3.observe([3], [0, 64], [832])  # aligned hit at 768: ring not read
+    c3.observe([4], [0, 30], [800])  # unaligned start 770 on a fresh block
+    c3.observe([0], [0, 8], [801])  # null block (padding): ignored
+    assert c3.counts["first_sight_unaligned"] == 1
+    assert c3.counts["missing"] == c3.counts["overwritten"] == 0
