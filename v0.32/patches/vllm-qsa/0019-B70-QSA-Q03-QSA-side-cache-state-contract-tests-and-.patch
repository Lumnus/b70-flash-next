+
+def _tie_logits(rows, width, visible, positive, gen):
+    """ReLU-shaped scores: ``positive`` columns > 0, the rest exactly 0."""
+    logits = torch.zeros(rows, width)
+    for r in range(rows):
+        cols = torch.randperm(int(visible[r]), generator=gen)[:positive]
+        logits[r, cols] = torch.rand(len(cols), generator=gen) + 0.01
+    logits[:, int(visible.max()) :] = 123.0  # garbage beyond visible
+    return logits
+
+
+@pytest.mark.parametrize("positive", [0, 100, 511, 512, 600])
+def test_native_det_repair_reproduces_torch_exactly(monkeypatch, positive):
+    """An adversarial 'native' that resolves ties toward the HIGHEST column
+    and returns its picks unsorted; native_det must turn it into the torch
+    selector's output, element for element. The rows with fewer positive
+    scores than k are exactly the tie rows."""
+    from vllm.models.qwen4_exp.nvidia.ops import qsa_indexer as qi
+
+    k = 512
+    gen = torch.Generator().manual_seed(positive)
+    visible = torch.tensor([700, 512, 300, 1000, 513], dtype=torch.int32)
+    logits = _tie_logits(5, 1024, visible, positive, gen)
+
+    def adversarial(logits, visible_blocks, block_topk, out):
+        rows, width = logits.shape
+        cols = torch.arange(width, dtype=torch.int64)
+        for r in range(rows):
+            v = int(visible_blocks[r])
+            key = (
+                logits[r, :v].double() * 4096 + cols[:v].double() / 4096
+            )  # high col wins
+            n = min(block_topk, v)
+            pick = torch.topk(key, n).indices
+            pick = pick[torch.randperm(n, generator=gen)]
+            out[r, :n] = pick.to(torch.int32)
+            out[r, n:] = -1
+
+    monkeypatch.setenv("B70_QSA_TOPK", "native_det")
+    monkeypatch.setattr(qi, "_qsa_topk_native", adversarial)
+    got = torch.empty(5, k, dtype=torch.int32)
+    qi._topk(logits, visible, 4 * k, 4, got, torch.empty(0, dtype=torch.uint8))
+    want = torch.empty_like(got)
+    qi._qsa_topk_torch(logits, visible, k, want)
+    assert torch.equal(got, want)
+
+    raw = torch.empty_like(got)
+    adversarial(logits, visible, k, raw)
+    tied = qsa_debug.boundary_tie_rows(logits, visible, raw, k)
+    assert tied.tolist() == [(int(v) > k and positive < k) for v in visible]
+
