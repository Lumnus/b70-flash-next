+@requires_gpu
+@pytest.mark.parametrize("positive", [0, 200, 600])
+def test_selector_identity_native_torch_native_det(monkeypatch, positive):
+    """All-zero or partly-zero indexer scores with distinct V per token.
+    Torch and native_det must agree exactly (ids and attention output) across
+    repeated launches and a graph replay. Native is compared too: a mismatch is
+    reported as XFAIL ('native tie order differs'), not hidden."""
+    from tests.models.qwen4_exp.test_qsa_reference import (
+        _qsa_sparse_paged_attention_reference,
+    )
+    from vllm.models.qwen4_exp.nvidia.ops import qsa_indexer as qi
+
+    if not hasattr(torch.ops._C, "top_k_per_row_decode"):
+        pytest.skip("native top-k op not registered")
+    dev = torch.device(_GPU)
+    rows, k, width = 8, 512, 1024
+    gen = torch.Generator().manual_seed(positive)
+    visible = torch.tensor([900] * rows, dtype=torch.int32)
+    logits = _tie_logits(rows, width, visible, positive, gen).to(dev)
+    visible = visible.to(dev)
+
+    def select(mode):
+        monkeypatch.setenv("B70_QSA_TOPK", mode)
+        out = torch.empty(rows, k, dtype=torch.int32, device=dev)
+        qi._topk(
+            logits,
+            visible,
+            4 * k,
+            4,
+            out,
+            torch.empty(1 << 20, dtype=torch.uint8, device=dev),
+        )
+        return out
+
+    t = select("torch")
+    for _ in range(3):
+        assert torch.equal(select("native_det"), t)
+    natives = [select("native") for _ in range(3)]
+    native_repeatable = all(torch.equal(natives[0], n) for n in natives[1:])
+
+    # Graph replay of the native selector (decode path is graph-captured).
+    Graph, graph_ctx, sync = _graph_api()
+    monkeypatch.setenv("B70_QSA_TOPK", "native")
+    out_g = torch.empty(rows, k, dtype=torch.int32, device=dev)
+    ws = torch.empty(1 << 20, dtype=torch.uint8, device=dev)
+    qi._topk(logits, visible, 4 * k, 4, out_g, ws)
+    g = Graph()
+    with graph_ctx(g):
+        qi._topk(logits, visible, 4 * k, 4, out_g, ws)
+    g.replay()
+    sync()
+    replay_equal = torch.equal(out_g, natives[0])
+
+    # Attention consequence: distinct V per token; same multiset of scores
+    # but different blocks gives different output.
+    hd, page = 256, 64
+    pages = (4 * width) // page + 1
+    kv = torch.randn(pages, page, 1, 2 * hd, dtype=torch.bfloat16, device=dev)
+    k_cache, v_cache = kv.split(hd, dim=-1)
+    table = torch.arange(pages, device=dev, dtype=torch.int32)[None]
+    q = torch.randn(1, 6, hd, dtype=torch.bfloat16, device=dev)
+
+    def attend(blocks_row):
+        tok = (
+            (
+                blocks_row[blocks_row >= 0].long()[:, None] * 4
+                + torch.arange(4, device=dev)
+            )
+            .flatten()
+            .to(torch.int32)
+        )
+        idx = torch.full((1, 4 * k + 3), -1, dtype=torch.int32, device=dev)
+        idx[0, : tok.numel()] = tok
+        return _qsa_sparse_paged_attention_reference(
+            q,
+            k_cache,
+            v_cache,
+            idx,
+            table,
+            torch.zeros(1, dtype=torch.int32, device=dev),
+            hd**-0.5,
+        )
+
+    differ_rows = [
+        r
+        for r in range(rows)
+        if not torch.equal(torch.sort(natives[0][r]).values, torch.sort(t[r]).values)
+    ]
+    attn_delta = max(
+        (
+            float((attend(natives[0][r]) - attend(t[r])).abs().max())
+            for r in differ_rows
+        ),
+        default=0.0,
+    )
+    print(
+        f"QSA-Q selector: positive={positive} native_repeatable={native_repeatable} "
+        f"native_graph_replay_equal={replay_equal} rows_native_set_differs="
+        f"{len(differ_rows)}/{rows} max_attention_delta={attn_delta:.4g}"
+    )
+    assert native_repeatable and replay_equal
+    if differ_rows:
+        pytest.xfail(
+            f"native tie order differs from torch on {len(differ_rows)} rows "
+            f"(max attention delta {attn_delta:.3g})"
+        )
+
+
+def test_ring_hook_runs_inside_the_metadata_builder(monkeypatch):
+    """B70_QSA_DEBUG_RING is wired into QSAMetadataBuilder.build."""
+    monkeypatch.setattr(qsa_debug, "RING_MODE", "raise")
+    monkeypatch.setattr(qsa_debug, "_ring_contracts", {})
+    sim = _Sim(
+        _RefOps,
+        torch.device("cpu"),
+        num_reqs=1,
+        cap=16,
+        comp_page=8,
+        max_groups=32,
+        seed=21,
+    )
+    sim.step([(0, 6, None)])  # positions 0..5
+    sim.committed[0] += [sim.key() for _ in range(4)]  # pretend 6..9 ran elsewhere
+    with pytest.raises(qsa_debug.QSARingContractError, match="missing"):
+        sim.step([(0, 1, None)])  # starts at 10, ring stops at 5
+
+
+def test_dump_hook_writes_logical_rows(tmp_path, monkeypatch):
+    monkeypatch.setattr(qsa_debug, "DUMP_DIR", str(tmp_path))
+    monkeypatch.setattr(qsa_debug, "DUMP_LAYERS", frozenset({3}))
+    sim = _Sim(
+        _RefOps,
+        torch.device("cpu"),
+        num_reqs=1,
+        cap=16,
+        comp_page=8,
+        max_groups=32,
+        seed=22,
+    )
+    _, comp_meta = sim.step([(0, 37, None)])
+    selected = torch.arange(37 * 4, dtype=torch.int32).view(37, 4)
+    qsa_debug.dump_prefill_state(
+        "model.layers.3.self_attn.indexer.k_cache", comp_meta, sim.comp, selected
+    )
+    qsa_debug.dump_prefill_state(
+        "model.layers.4.self_attn.indexer.k_cache", comp_meta, sim.comp, selected
+    )
+    (f,) = list(tmp_path.glob("qsa-L03-*.pt"))
+    d = torch.load(f, weights_only=False)
+    (req,) = d["requests"]
+    assert req["seq_len"] == 37 and req["compressed"].shape == (9, D)
+    truth = torch.stack(sim.committed[0][:36]).float().view(9, CR, D).mean(1)
+    assert torch.equal(req["compressed"], truth)
+    assert req["last_row_selected"].tolist() == selected[36].tolist()
