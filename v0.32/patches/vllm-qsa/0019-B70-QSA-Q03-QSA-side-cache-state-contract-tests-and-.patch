+# SPDX-License-Identifier: Apache-2.0
+"""B70-QSA-Q: engine-level state contracts of the QSA side caches.
+
+The kernel tests in test_qsa_reference.py check one launch against a reference.
+These tests drive the side caches through the sequences a serving engine
+produces -- chunked prefill, DFlash K=7 verify with every acceptance length,
+plain decode, ring wrap, compressed-page crossings, repeated execution under
+graph capture, prefix hits -- and check the state after every step against a
+ground truth built only from committed tokens:
+
+  * compressed row of every complete committed group == mean of its 4
+    committed raw keys (exact: keys are small integers in bf16);
+  * the ring holds the committed keys of each request's open group;
+  * the null block and blocks owned by nobody are never written.
+
+Draft rows get keys that differ from the committed ones, so a rejected draft
+that survives anywhere it is later read fails the comparison.
+
+Two backends run the same scenarios: ``ref`` (production metadata and slot
+mappings, torch compression/store with the kernel's semantics; runs on CPU)
+and ``triton`` (production metadata, compression and store kernels; needs an
+XPU or CUDA device). The compressed rows are stored before Gemma-norm/RoPE,
+which are row-wise maps that do not touch the state machine; the fused
+prepare arm compares against the unfused arm with those maps applied.
+"""
+
+import math
+import random
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.models.qwen4_exp.common import qsa_cache, qsa_debug
+from vllm.models.qwen4_exp.common.qsa_cache import QSAMetadataBuilder
+from vllm.platforms import current_platform
+from vllm.triton_utils import HAS_TRITON
+
+_ON_GPU = (current_platform.is_cuda() or current_platform.is_xpu()) and HAS_TRITON
+_GPU = "xpu" if current_platform.is_xpu() else "cuda"
+requires_gpu = pytest.mark.skipif(not _ON_GPU, reason="needs XPU/CUDA + Triton")
+
+
+@pytest.fixture
+def should_do_global_cleanup_after_test() -> bool:
+    # The ref backend runs on CPU-only hosts, where the global cleanup's
+    # accelerator calls raise.
+    return _ON_GPU
+
+
+CR = 4  # compression ratio
+K = 7  # DFlash2 draft length on the serving def
+D = 32  # raw-key width for state tests (production: 128; width is irrelevant)
+SENTINEL = -100.0  # never produced by a key or a group mean
+
+
+def _ring_capacity(block_size: int, num_spec: int = K) -> int:
+    """Production capacity rule (QSAKeyStateCache.get_kv_cache_spec)."""
+    layer = qsa_cache.QSAKeyStateCache(
+        head_size=64,
+        dtype=torch.bfloat16,
+        cache_config=SimpleNamespace(block_size=block_size),
+        prefix=f"cap.{block_size}.{num_spec}.{random.random()}",
+        vllm_config=SimpleNamespace(
+            compilation_config=SimpleNamespace(static_forward_context={})
+        ),
+        compress_ratio=CR,
+    )
+    return layer.get_kv_cache_spec(
+        SimpleNamespace(num_speculative_tokens=num_spec)
+    ).block_size
+
+
+def _builder(device, *, circular: bool, size: int, max_tokens=4096, max_reqs=8):
+    b = QSAMetadataBuilder.__new__(QSAMetadataBuilder)
+    b.compress_ratio = 1 if circular else CR
+    b.reorder_batch_threshold = 1 + K
+    b.is_circular_buffer = circular
+    b.kv_cache_spec = SimpleNamespace(block_size=size)
+    b.storage_block_size = size
+    b.request_capacity = max_reqs
+    b.token_to_req_buffer = torch.empty(max_tokens, dtype=torch.int32, device=device)
+    b.slot_mapping_buffer = torch.empty(max_tokens, dtype=torch.int64, device=device)
+    b.logical_positions_buffer = torch.empty(
+        max_tokens, dtype=torch.int64, device=device
+    )
+    b.visible_blocks_buffer = torch.empty(max_tokens, dtype=torch.int32, device=device)
+    if circular:
+        b.k_work_metadata_buffer = torch.empty(0, 2, dtype=torch.int32, device=device)
+    else:
+        b.k_work_metadata_buffer = torch.empty(
+            (max_tokens + (CR - 1) * max_reqs) // CR,
+            2,
+            dtype=torch.int32,
+            device=device,
+        )
+    b._debug_ring_ratio = CR
+    return b
+
+
+# --------------------------------------------------------------------------
+# Side-cache ops: torch reference with the kernel's semantics, or production.
+# --------------------------------------------------------------------------
+
+
+class _RefOps:
+    name = "ref"
+
+    @staticmethod
+    def compress(raw, ring, ring_table, token_to_req, qsl, logical, comp_slots):
+        rows = raw.shape[0]
+        cap = ring.shape[1]
+        pooled = torch.zeros_like(raw)
+        t2r = token_to_req.tolist()
+        pos = logical.tolist()
+        slots = comp_slots.tolist()
+        q = qsl.tolist()
+        for row in range(rows):
+            r, end = t2r[row], pos[row]
+            if slots[row] < 0 or end < CR - 1 or r < 0 or r >= len(q) - 1:
+                continue
+            if not (q[r] <= row < q[r + 1]):
+                continue
+            chunk_start = end - (row - q[r])
+            block = int(ring_table[r, 0])
+            acc = torch.zeros(raw.shape[-1], dtype=torch.float32, device=raw.device)
+            for member in range(end - CR + 1, end + 1):
+                if member >= chunk_start:
+                    acc += raw[q[r] + member - chunk_start, 0].float()
+                else:
+                    acc += ring[block, member % cap, 0].float()
+            pooled[row, 0] = (acc / CR).to(raw.dtype)
+        return pooled
+
+    @staticmethod
+    def store(cache, slots, rows):
+        page = cache.shape[1]
+        for row, slot in enumerate(slots.tolist()):
+            if 0 <= slot < cache.shape[0] * page:
+                cache[slot // page, slot % page, 0] = rows[row, 0]
+
+
+class _TritonOps:
+    name = "triton"
+
+    @staticmethod
+    def compress(raw, ring, ring_table, token_to_req, qsl, logical, comp_slots):
+        from vllm.models.qwen4_exp.nvidia.ops import qsa as qsa_ops
+
+        positions = logical.view(-1, 1, 1).expand(-1, 1, 3).contiguous()
+        pooled, _ = qsa_ops.qsa_compress_groups_with_ratio(
+            raw,
+            positions,
+            ring,
+            ring_table,
+            token_to_req,
+            qsl,
+            logical,
+            comp_slots,
+            CR,
+        )
+        return pooled
+
+    @staticmethod
+    def store(cache, slots, rows):
+        from vllm.models.qwen4_exp.nvidia.ops import qsa as qsa_ops
+
+        qsa_ops.qsa_store_cache_rows(cache, slots, rows)
+
+
+# --------------------------------------------------------------------------
+# The engine-shaped driver and its ground truth.
+# --------------------------------------------------------------------------
+
+
+class _Sim:
+    """Side caches of one QSA layer, driven step by step."""
+
+    def __init__(
+        self, ops, device, *, num_reqs, cap, comp_page, max_groups, seed=0, max_reqs=8
+    ):
+        self.ops, self.device = ops, device
+        self.cap, self.page = cap, comp_page
+        self.gen = torch.Generator().manual_seed(seed)
+        pages_per_req = math.ceil(max_groups / comp_page)
+        # Block 0 is the null block; two extra spare blocks nobody owns.
+        n_ring = num_reqs + 3
+        n_comp = num_reqs * pages_per_req + 3
+        self.ring = torch.full(
+            (n_ring, cap, 1, D), SENTINEL, dtype=torch.bfloat16, device=device
+        )
+        self.comp = torch.full(
+            (n_comp, comp_page, 1, D), SENTINEL, dtype=torch.bfloat16, device=device
+        )
+        ring_perm = torch.randperm(n_ring - 1, generator=self.gen)[:num_reqs] + 1
+        self.ring_table = ring_perm.view(-1, 1).to(torch.int32).to(device)
+        comp_perm = (
+            torch.randperm(n_comp - 1, generator=self.gen)[: num_reqs * pages_per_req]
+            + 1
+        )
+        self.comp_table = (
+            comp_perm.view(num_reqs, pages_per_req).to(torch.int32).to(device)
+        )
+        self.owned_ring = set(ring_perm.tolist())
+        self.owned_comp = set(comp_perm.tolist())
+        self.committed = [[] for _ in range(num_reqs)]
+        self.ring_b = _builder(device, circular=True, size=cap, max_reqs=max_reqs)
+        self.comp_b = _builder(
+            device, circular=False, size=comp_page, max_reqs=max_reqs
+        )
+        self.contract = qsa_debug.QSARingContract(cap, CR, "warn")
+        self.num_reqs = num_reqs
+
+    def key(self):
+        return torch.randint(-8, 9, (D,), generator=self.gen).to(torch.bfloat16)
+
+    def length(self, r):
+        return len(self.committed[r])
+
+    def _common(self, qsl, seq_lens, num_tokens, table):
+        q = torch.tensor(qsl, dtype=torch.int32, device=self.device)
+        t2r = torch.zeros(num_tokens, dtype=torch.int32, device=self.device)
+        for r in range(len(qsl) - 1):
+            t2r[qsl[r] : qsl[r + 1]] = r
+        main_slots = torch.full(
+            (num_tokens,), -1, dtype=torch.int64, device=self.device
+        )
+        main_slots[: qsl[-1]] = torch.arange(qsl[-1], device=self.device)
+        lens = [qsl[i + 1] - qsl[i] for i in range(len(qsl) - 1)]
+        return SimpleNamespace(
+            num_actual_tokens=num_tokens,
+            num_reqs=len(qsl) - 1,
+            max_query_len=max(lens),
+            max_seq_len=max(seq_lens),
+            query_start_loc=q,
+            query_start_loc_cpu=q.cpu(),
+            seq_lens=torch.tensor(seq_lens, dtype=torch.int32, device=self.device),
+            slot_mapping=main_slots,
+            block_table_tensor=table,
+            token_to_req_indices=lambda buf: buf[:num_tokens].copy_(t2r),
+        )
+
+    def step(self, plan, pad_tokens=0, repeat=1):
+        """plan: list of (request, n_rows, accepted) in batch order.
+
+        Rows start at the request's committed length. accepted=None: every row
+        is a committed token (prefill/plain decode). Otherwise row 0 is the
+        committed token and rows 1.. are drafts, of which ``accepted`` are kept.
+        """
+        qsl, seq_lens, keys, outcome = [0], [], [], []
+        for r, n, accepted in plan:
+            start = self.length(r)
+            rows = [self.key() for _ in range(n)]
+            keys += rows
+            qsl.append(qsl[-1] + n)
+            seq_lens.append(start + n)
+            keep = n if accepted is None else 1 + accepted
+            outcome.append((r, rows[:keep]))
+        num_tokens = qsl[-1] + pad_tokens
+        reqs = [r for r, _, _ in plan]
+        ring_table = self.ring_table[reqs]
+        comp_table = self.comp_table[reqs]
+        raw = torch.zeros(num_tokens, 1, D, dtype=torch.bfloat16)
+        raw[: len(keys), 0] = torch.stack(keys) if keys else raw[:0, 0]
+        raw = raw.to(self.device)
+        ring_meta = self.ring_b.build(
+            0, self._common(qsl, seq_lens, num_tokens, ring_table)
+        )
+        comp_meta = self.comp_b.build(
+            0, self._common(qsl, seq_lens, num_tokens, comp_table)
+        )
+        self.contract.observe(ring_table[:, 0].tolist(), qsl, seq_lens)
+        self._check_visible(comp_meta, qsl, seq_lens)
+        for _ in range(repeat):
+            pooled = self.ops.compress(
+                raw,
+                self.ring,
+                ring_table,
+                ring_meta.token_to_req,
+                ring_meta.query_start_loc,
+                ring_meta.logical_positions,
+                comp_meta.slot_mapping,
+            )
+            self.ops.store(self.comp, comp_meta.slot_mapping, pooled)
+            self.ops.store(self.ring, ring_meta.slot_mapping, raw)
+        for r, kept in outcome:
+            self.committed[r] += kept
+        return ring_meta, comp_meta
+
+    @staticmethod
+    def _check_visible(comp_meta, qsl, seq_lens):
+        vis = comp_meta.visible_blocks.tolist()
+        pos = comp_meta.logical_positions.tolist()
+        for r in range(len(qsl) - 1):
+            for row in range(qsl[r], qsl[r + 1]):
+                assert vis[row] == min((pos[row] + 1) // CR, seq_lens[r] // CR), (
+                    "a row may only see groups closed at or before its own position"
+                )
+        assert all(v == 0 for v in vis[qsl[-1] :]), "padding rows must see nothing"
+
+    def check(self, label=""):
+        ring, comp = self.ring.cpu().float(), self.comp.cpu().float()
+        for r in range(self.num_reqs):
+            keys = self.committed[r]
+            n = len(keys)
+            groups = n // CR
+            if groups:
+                truth = torch.stack(keys[: groups * CR]).float().view(groups, CR, D)
+                truth = truth.mean(dim=1)
+                g = torch.arange(groups)
+                pages = self.comp_table[r].cpu()[g // self.page].long()
+                got = comp[pages, g % self.page, 0]
+                bad = (got != truth).any(dim=1).nonzero().flatten().tolist()
+                assert not bad, (
+                    f"{label} req {r}: compressed groups {bad[:8]} differ from the "
+                    f"mean of their committed keys (committed length {n})"
+                )
+            block = int(self.ring_table[r, 0])
+            for x in range(n - n % CR, n):
+                assert torch.equal(ring[block, x % self.cap, 0], keys[x].float()), (
+                    f"{label} req {r}: ring slot {x % self.cap} does not hold the "
+                    f"committed key of open-group position {x}"
+                )
+        for block in range(ring.shape[0]):
+            if block not in self.owned_ring:
+                assert bool((ring[block] == SENTINEL).all()), (
+                    f"{label} ring block {block} (null/unowned) was written"
+                )
+        for block in range(comp.shape[0]):
+            if block not in self.owned_comp:
+                assert bool((comp[block] == SENTINEL).all()), (
+                    f"{label} compressed block {block} (null/unowned) was written"
+                )
+
+
+def _prefill(sim, r, total, chunks):
+    """Chunked prefill of request r to ``total`` tokens with given chunk sizes."""
+    done = sim.length(r)
+    for size in chunks:
+        if done >= total:
+            break
+        n = min(size, total - done)
+        sim.step([(r, n, None)])
+        done += n
+    if done < total:
+        sim.step([(r, total - done, None)])
+
+
+def _ops_for(backend):
+    if backend == "triton":
+        if not _ON_GPU:
+            pytest.skip("triton backend needs XPU/CUDA")
+        return _TritonOps, torch.device(_GPU)
+    return _RefOps, torch.device("cpu")
+
+
+BACKENDS = ["ref", pytest.param("triton", marks=requires_gpu)]
+
+
+# --------------------------------------------------------------------------
+# Test 1: speculative rollback at compression boundaries.
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("backend", BACKENDS)
+@pytest.mark.parametrize("residue", [0, 1, 2, 3])
+@pytest.mark.parametrize("accepted", list(range(K + 1)))
+def test_spec_rollback_every_residue_and_acceptance(backend, residue, accepted):
+    """verify(a) -> plain decode -> verify -> verify, three requests, ring 16.
+
+    Each request starts at a different residue mod 4 so every boundary case
+    of the open group meets every acceptance length.
+    """
+    ops, device = _ops_for(backend)
+    cap = _ring_capacity(832)
+    assert cap == 16
+    sim = _Sim(
+        ops,
+        device,
+        num_reqs=3,
+        cap=cap,
+        comp_page=8,
+        max_groups=64,
+        seed=residue * 31 + accepted,
+    )
+    for r in range(3):
+        _prefill(sim, r, 40 + (residue + r) % 4, chunks=[13, 11, 9])
+    sim.check("prefill")
+    sim.step([(r, K + 1, accepted) for r in range(3)])
+    sim.check(f"verify a={accepted}")
+    sim.step([(r, 1, None) for r in range(3)])
+    sim.check("plain decode")
+    sim.step([(r, K + 1, (accepted + 3 + r) % (K + 1)) for r in range(3)])
+    sim.check("verify 2")
+    sim.step([(r, K + 1, K - accepted) for r in range(3)])
+    sim.check("verify 3")
+    assert sim.contract.counts["missing"] == sim.contract.counts["overwritten"] == 0
+
+
+@pytest.mark.parametrize("backend", BACKENDS)
+@pytest.mark.parametrize("seed", [0, 1, 2, 3])
+def test_spec_rollback_long_random_run_wraps_ring_and_pages(backend, seed):
+    """60 steps of random acceptance with interleaved plain decodes: the ring
+    wraps every 16 positions and compressed pages cross every 32 tokens."""
+    ops, device = _ops_for(backend)
+    rnd = random.Random(seed)
+    sim = _Sim(
+        ops,
+        device,
+        num_reqs=4,
+        cap=_ring_capacity(832),
+        comp_page=8,
+        max_groups=160,
+        seed=100 + seed,
+    )
+    for r in range(4):
+        _prefill(sim, r, 21 + 5 * r, chunks=[7, 6])
+    for i in range(60):
+        if rnd.random() < 0.2:
+            sim.step([(r, 1, None) for r in range(4)])
+        else:
+            sim.step([(r, K + 1, rnd.randint(0, K)) for r in range(4)])
+        sim.check(f"step {i}")
+
+
+@pytest.mark.parametrize("backend", BACKENDS)
+@pytest.mark.parametrize("start", [826, 827, 828, 829])
+def test_spec_rollback_across_the_832_attention_block(backend, start):
+    """Serving geometry: attention block 832 = 208 compressed rows per page.
+    Verify rows straddle position 832 (the page crossing) at all residues."""
+    ops, device = _ops_for(backend)
+    sim = _Sim(
+        ops,
+        device,
+        num_reqs=2,
+        cap=_ring_capacity(832),
+        comp_page=208,
+        max_groups=420,
+        seed=start,
+    )
+    for r in range(2):
+        _prefill(sim, r, start + r, chunks=[512, 200])
+    for a in (0, 7, 3, 1, 6, 2, 5, 4):
+        sim.step([(r, K + 1, a) for r in range(2)])
+        sim.check(f"a={a}")
+
+
+@pytest.mark.parametrize("backend", BACKENDS)
+def test_mixed_decode_and_chunked_prefill_batch(backend):
+    """Decode-verify rows first, a prefill chunk after them (reordered batch),
+    with chunk boundaries off the group grid."""
+    ops, device = _ops_for(backend)
+    sim = _Sim(
+        ops,
+        device,
+        num_reqs=3,
+        cap=_ring_capacity(832),
+        comp_page=8,
+        max_groups=128,
+        seed=7,
+    )
+    _prefill(sim, 0, 29, chunks=[29])
+    _prefill(sim, 1, 30, chunks=[30])
+    for i, chunk in enumerate([37, 13, 50]):
+        sim.step(
+            [(0, K + 1, i % (K + 1)), (1, K + 1, (5 * i) % (K + 1)), (2, chunk, None)]
+        )
+        sim.check(f"mixed {i}")
+
+
+def test_rollback_check_discriminates_a_narrow_ring():
+    """Negative control: a ring of 8 with K=7 lets a rejected draft displace a
+    committed open-group key. The ground truth and the debug contract must
+    both catch it, or the tests above prove nothing."""
+    sim = _Sim(
+        _RefOps,
+        torch.device("cpu"),
+        num_reqs=1,
+        cap=8,
+        comp_page=8,
+        max_groups=32,
+        seed=3,
+    )
+    _prefill(sim, 0, 41, chunks=[41])  # open group holds position 40
+    sim.step([(0, K + 1, 0)])  # writes 41..48; 48 % 8 == 40 % 8
+    with pytest.raises(AssertionError, match="ring slot 0 does not hold"):
+        sim.check()
+    sim.step([(0, K + 1, 1)])  # row 43 closes group 40..43 from the clobbered slot
+    with pytest.raises(AssertionError, match="compressed groups"):
+        sim.check()
+    assert sim.contract.counts["overwritten"] >= 1
+
+
+# --------------------------------------------------------------------------
+# Test 2 (unit part): prefix hits, CPU reload, eagle block drop.
+# --------------------------------------------------------------------------
+
+
+def _new_request_from_cache(sim, src, dst, hit, reload_compressed=True):
+    """Request ``dst`` reuses ``src``'s first ``hit`` tokens as a cache hit.
+
+    Compressed rows for the hit are copied page by page (GPU hit / CPU
+    reload). The ring is never cached: ``dst`` gets a fresh ring block whose
+    contents are a previous request's leftovers.
+    """
+    groups = hit // CR
+    for g in range(groups):
+        s_page, d_page = (
+            sim.comp_table[src, g // sim.page],
+            sim.comp_table[dst, g // sim.page],
+        )
+        if reload_compressed:
+            sim.comp[d_page, g % sim.page] = sim.comp[s_page, g % sim.page]
+    blk = int(sim.ring_table[dst, 0])
+    sim.ring[blk] = (
+        torch.randint(-8, 9, sim.ring[blk].shape).to(sim.ring.dtype).to(sim.ring.device)
+    )
+    sim.committed[dst] = list(sim.committed[src][:hit])
+
+
+@pytest.mark.parametrize("backend", BACKENDS)
+@pytest.mark.parametrize("eagle_drop", [False, True])
+@pytest.mark.parametrize("prompt", [1700, 1703])
+def test_prefix_hit_and_reload_keep_side_caches_consistent(backend, eagle_drop, prompt):
+    """A hit is a multiple of the hash/scheduler block (here 64; serving 832).
+    With the EAGLE trailing-block drop the hit loses one more whole block --
+    still group-aligned, so the fresh ring is never read and every compressed
+    row of the reused prefix matches the recomputed one."""
+    ops, device = _ops_for(backend)
+    block = 64
+    sim = _Sim(
+        ops,
+        device,
+        num_reqs=2,
+        cap=_ring_capacity(832),
+        comp_page=16,
+        max_groups=600,
+        seed=prompt,
+    )
+    _prefill(sim, 0, prompt, chunks=[512, 512, 512])
+    hit = prompt // block * block
+    if eagle_drop:
+        hit -= block
+    sim.contract.last.pop(int(sim.ring_table[1, 0]), None)
+    _new_request_from_cache(sim, 0, 1, hit)
+    # Recompute the uncached tail with request 0's committed keys.
+    _step_with_keys(sim, 1, sim.committed[0][hit:prompt])
+    assert len(sim.committed[1]) == prompt
+    sim.check(f"hit={hit}")
+    assert sim.contract.counts["first_sight_unaligned"] == 0
+    sim.step([(1, K + 1, 3)])
+    sim.check("verify after hit")
+
+
+def _step_with_keys(sim, r, keys):
+    """One prefill step for request r whose rows carry the given keys."""
+    it = iter(keys)
+    original = sim.key
+    sim.key = lambda: next(it)
+    try:
+        if keys:
+            sim.step([(r, len(keys), None)])
+    finally:
+        sim.key = original
+
+
+def test_unaligned_hit_corrupts_a_group_and_the_contract_flags_it():
+    """Characterization: if a hit ever ended inside a compression group, the
+    group's earlier members would be read from a ring that never held them.
+    Hit lengths are multiples of the scheduler/hash block (both multiples of
+    4 on this model); B70_QSA_DEBUG_RING turns a violation into an error."""
+    sim = _Sim(
+        _RefOps,
+        torch.device("cpu"),
+        num_reqs=2,
+        cap=16,
+        comp_page=16,
+        max_groups=128,
+        seed=11,
+    )
+    _prefill(sim, 0, 300, chunks=[300])
+    hit = 258  # 258 % 4 == 2
+    _new_request_from_cache(sim, 0, 1, hit)
+    _step_with_keys(sim, 1, sim.committed[0][hit:300])
+    with pytest.raises(AssertionError, match="compressed groups"):
+        sim.check()
+    assert sim.contract.counts["first_sight_unaligned"] == 1
+
