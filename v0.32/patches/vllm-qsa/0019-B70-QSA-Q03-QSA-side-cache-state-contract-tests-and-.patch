+# --------------------------------------------------------------------------
+# Test 3 (graph part): real capture and replay of the side-cache step.
+# --------------------------------------------------------------------------
+
+
+def _graph_api():
+    if current_platform.is_xpu():
+        return torch.xpu.XPUGraph, torch.xpu.graph, torch.xpu.synchronize
+    return torch.cuda.CUDAGraph, torch.cuda.graph, torch.cuda.synchronize
+
+
+@requires_gpu
+@pytest.mark.parametrize("num_reqs", [1, 3, 4])
+@pytest.mark.parametrize("fallback", [False, True])
+def test_side_cache_graph_capture_matches_one_eager_pass(num_reqs, fallback):
+    """The TargetGraphs protocol on the production side-cache kernels:
+    eager -> warm-up -> capture -> replay (and, for a failed capture, the
+    eager fallback once more). Compare full tensors with one eager pass."""
+    ops, device = _TritonOps, torch.device(_GPU)
+    Graph, graph_ctx, sync = _graph_api()
+
+    def build():
+        sim = _Sim(
+            ops,
+            device,
+            num_reqs=num_reqs,
+            cap=_ring_capacity(832),
+            comp_page=8,
+            max_groups=64,
+            seed=40 + num_reqs,
+        )
+        for r in range(num_reqs):
+            _prefill(sim, r, 45 + r, chunks=[19])
+            sim.step([(r, K + 1, 6 - r)])
+        return sim
+
+    ref, cap_sim = build(), build()
+    state = ref.gen.get_state()
+    plan = [(r, K + 1, 2) for r in range(num_reqs)]
+    ref.step(plan, pad_tokens=8)
+    ref.check("eager reference")
+
+    # Same inputs for the captured sim: build metadata once, then the protocol.
+    cap_sim.gen.set_state(state)
+    keys, qsl, seq_lens = [], [0], []
+    for r, n, _ in plan:
+        start = cap_sim.length(r)
+        keys += [cap_sim.key() for _ in range(n)]
+        qsl.append(qsl[-1] + n)
+        seq_lens.append(start + n)
+    num_tokens = qsl[-1] + 8
+    raw = torch.zeros(num_tokens, 1, D, dtype=torch.bfloat16)
+    raw[: len(keys), 0] = torch.stack(keys)
+    raw = raw.to(device)
+    reqs = [r for r, _, _ in plan]
+    ring_table = cap_sim.ring_table[reqs]
+    ring_meta = cap_sim.ring_b.build(
+        0, cap_sim._common(qsl, seq_lens, num_tokens, ring_table)
+    )
+    comp_meta = cap_sim.comp_b.build(
+        0, cap_sim._common(qsl, seq_lens, num_tokens, cap_sim.comp_table[reqs])
+    )
+
+    def run():
+        pooled = ops.compress(
+            raw,
+            cap_sim.ring,
+            ring_table,
+            ring_meta.token_to_req,
+            ring_meta.query_start_loc,
+            ring_meta.logical_positions,
+            comp_meta.slot_mapping,
+        )
+        ops.store(cap_sim.comp, comp_meta.slot_mapping, pooled)
+        ops.store(cap_sim.ring, ring_meta.slot_mapping, raw)
+
+    run()  # eager pass
+    sync()
+    run()  # warm-up
+    sync()
+    graph = Graph()
+    with graph_ctx(graph):
+        run()
+    graph.replay()
+    sync()
+    if fallback:
+        run()
+        sync()
+    graph.replay()  # a second replay of the same step
+    sync()
+    for r, n, accepted in plan:
+        cap_sim.committed[r] += keys[
+            qsl[reqs.index(r)] : qsl[reqs.index(r)] + 1 + accepted
+        ]
+    assert torch.equal(ref.ring.cpu(), cap_sim.ring.cpu())
+    assert torch.equal(ref.comp.cpu(), cap_sim.comp.cpu())
+    cap_sim.check("captured")
+
