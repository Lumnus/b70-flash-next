+@requires_gpu
+@pytest.mark.parametrize("decode_query_len", [1, K + 1])
+@pytest.mark.parametrize("context", [2049, 2051, 2052, 2056])
+def test_boundary_sparse_attention_equals_dense_through_2051(
+    monkeypatch, decode_query_len, context
+):
+    """Production decode selection + expansion + sparse attention on one card.
+    Rows with <= 2,051 visible tokens must match dense causal attention; rows
+    past it must match the sparse reference over their own selection."""
+    from tests.models.qwen4_exp.test_qsa_reference import (
+        _qsa_sparse_paged_attention_reference,
+    )
+    from vllm.models.qwen4_exp.nvidia.ops import qsa as qsa_ops
+    from vllm.models.qwen4_exp.nvidia.ops import qsa_indexer as qi
+
+    monkeypatch.setenv("B70_QSA_TOPK", "torch")
+    dev = torch.device(_GPU)
+    torch.manual_seed(context + decode_query_len)
+    heads, kv_heads, hd, idx_heads, idx_hd = 6, 1, 256, 4, 128
+    page = 64
+    pages = math.ceil((context + 1) / page) + 1
+    rows = decode_query_len
+    positions = torch.arange(context - rows, context, device=dev)
+    kv = torch.randn(pages, page, kv_heads, 2 * hd, dtype=torch.bfloat16, device=dev)
+    k_cache, v_cache = kv.split(hd, dim=-1)
+    block_table = torch.randperm(pages, device=dev)[None].to(torch.int32)
+    comp_page = page // CR
+    comp = torch.randn(pages, comp_page, 1, idx_hd, dtype=torch.bfloat16, device=dev)
+    q_idx = torch.randn(rows, idx_heads, idx_hd, dtype=torch.bfloat16, device=dev)
+    visible = torch.minimum(
+        (positions + 1) // CR, torch.tensor(context, device=dev) // CR
+    ).to(torch.int32)
+    blocks = torch.empty(rows, BUDGET // CR, dtype=torch.int32, device=dev)
+    qi.qsa_select_paged_decode(
+        q_idx, comp, block_table, visible, BUDGET, CR, rows, blocks
+    )
+    logical = torch.empty(rows, BUDGET + CR - 1 + 1, dtype=torch.int32, device=dev)
+    qi.expand_qsa_block_indices(blocks, positions, visible, CR, BUDGET, logical)
+    q = torch.randn(rows, heads, hd, dtype=torch.bfloat16, device=dev)
+    gate = torch.zeros_like(q)  # sigmoid(0) = 1/2 on both sides
+    t2r = torch.zeros(rows, dtype=torch.int32, device=dev)
+    actual = qsa_ops.qsa_sparse_paged_attention(
+        q,
+        k_cache,
+        v_cache,
+        logical,
+        block_table,
+        t2r,
+        use_prefill_config=False,
+        output_gate=gate,
+    )
+    for row, pos in enumerate(positions.tolist()):
+        sel = logical[row, : BUDGET + CR - 1]
+        sel_set = set(x for x in sel.tolist() if x >= 0)
+        if pos + 1 <= BUDGET + CR - 1:
+            assert sel_set == set(range(pos + 1))
+            dense = torch.arange(pos + 1, device=dev, dtype=torch.int32)
+            idx = torch.full((1, BUDGET + CR - 1), -1, dtype=torch.int32, device=dev)
+            idx[0, : pos + 1] = dense
+        else:
+            assert len(sel_set) == BUDGET + (pos + 1) % CR
+            idx = sel[None]
+        expected = (
+            _qsa_sparse_paged_attention_reference(
+                q[row : row + 1],
+                k_cache,
+                v_cache,
+                idx,
+                block_table,
+                t2r[:1],
+                hd**-0.5,
+            )
+            * 0.5
+        )
+        torch.testing.assert_close(
+            actual[row : row + 1], expected, rtol=2e-2, atol=2e-2
+        )
