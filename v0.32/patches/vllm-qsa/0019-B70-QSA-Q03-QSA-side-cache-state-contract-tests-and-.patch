+def test_repeating_a_long_prefill_chunk_is_not_idempotent():
+    """Characterization, and the reason C1 target graphs must stay verify-only:
+    a chunk longer than capacity - (ratio - 1) rows overwrites, on its first
+    execution, ring slots its second execution reads to close the first group."""
+
+    def build():
+        sim = _Sim(
+            _RefOps,
+            torch.device("cpu"),
+            num_reqs=1,
+            cap=16,
+            comp_page=8,
+            max_groups=64,
+            seed=5,
+        )
+        _prefill(sim, 0, 13, chunks=[13])  # residue 1
+        return sim
+
+    once, twice = build(), build()
+    state = once.gen.get_state()
+    once.step([(0, 40, None)])
+    twice.gen.set_state(state)
+    twice.step([(0, 40, None)], repeat=2)
+    once.check()
+    assert not torch.equal(once.comp, twice.comp)
+    # The graph path only takes uniform 8-row verify batches; 8 rows plus the
+    # 3 open-group keys fit in the serving ring.
+    assert _ring_capacity(832) >= 8 + CR - 1
+
