+# --------------------------------------------------------------------------
+# Test 4: short-context and the 2,048 + 3 boundary.
+# --------------------------------------------------------------------------
+
+BUDGET = 2048
+
+
+def _selected_tokens_reference(logits, visible, positions):
+    """Production torch top-k + reference expansion -> attended token sets."""
+    from tests.models.qwen4_exp.test_qsa_reference import (
+        _expand_qsa_indices_reference,
+    )
+    from vllm.models.qwen4_exp.nvidia.ops import qsa_indexer as qi
+
+    out = torch.empty(logits.shape[0], BUDGET // CR, dtype=torch.int32)
+    qi._qsa_topk_torch(logits, visible, BUDGET // CR, out)
+    seq = positions + 1
+    expanded = _expand_qsa_indices_reference(out, positions, seq, CR, BUDGET)
+    return [set(x for x in row.tolist() if x >= 0) for row in expanded]
+
+
+@pytest.mark.parametrize("context", [2047, 2048, 2049, 2050, 2051, 2052, 2053, 2056])
+def test_boundary_selection_covers_all_tokens_up_to_2051(context):
+    """Row at position ``context - 1``: through 2,051 visible tokens (512
+    groups + a 3-token tail) the selection is the whole causal prefix, so
+    sparse attention must equal dense; from 2,052 one group drops out."""
+    gen = torch.Generator().manual_seed(context)
+    positions = torch.tensor([context - 1])
+    visible = torch.minimum((positions + 1) // CR, torch.tensor([context]) // CR)
+    logits = torch.rand(1, max(int(visible[0]), 1), generator=gen)
+    (tokens,) = _selected_tokens_reference(logits, visible.to(torch.int32), positions)
+    if context <= BUDGET + CR - 1:
+        assert tokens == set(range(context))
+    else:
+        assert len(tokens) == BUDGET + context % CR
+        assert tokens < set(range(context))
+
+
+@pytest.mark.parametrize("first", [2044, 2045, 2046, 2047])
+def test_boundary_speculative_rows_straddle_2051(first):
+    """Eight verify rows across the boundary: rows at or below 2,051 visible
+    tokens attend everything; later rows of the same step select."""
+    rows = torch.arange(first, first + K + 1)
+    seq = torch.full_like(rows, first + K + 1)
+    visible = torch.minimum((rows + 1) // CR, seq // CR).to(torch.int32)
+    logits = torch.rand(len(rows), int(visible.max()))
+    sets = _selected_tokens_reference(logits, visible, rows)
+    for pos, tokens in zip(rows.tolist(), sets):
+        if pos + 1 <= BUDGET + CR - 1:
+            assert tokens == set(range(pos + 1)), pos
+        else:
+            assert len(tokens) == BUDGET + (pos + 1) % CR, pos
+
