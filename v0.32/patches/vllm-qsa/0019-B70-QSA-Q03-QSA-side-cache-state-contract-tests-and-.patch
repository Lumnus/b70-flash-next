+@pytest.mark.parametrize("backend", BACKENDS)
+@pytest.mark.parametrize("num_reqs", [1, 2, 3, 4])
+@pytest.mark.parametrize("pad", [0, 8])
+def test_verify_step_is_idempotent_under_capture_repeats(backend, num_reqs, pad):
+    """TargetGraphs runs a new 8-row verify batch eagerly, again as warm-up,
+    and once more on replay, restoring only the GDN state routes. QSA side
+    caches are written three times from the same pre-state; with padding rows
+    (cudagraph padding) and nontrivial prior ring contents, the result must be
+    identical to one eager pass, null and unowned blocks included."""
+    ops, device = _ops_for(backend)
+
+    def build():
+        sim = _Sim(
+            ops,
+            device,
+            num_reqs=num_reqs,
+            cap=_ring_capacity(832),
+            comp_page=8,
+            max_groups=64,
+            seed=num_reqs * 10 + pad,
+        )
+        for r in range(num_reqs):
+            _prefill(sim, r, 50 + r, chunks=[23, 17])  # residues 2,3,0,1
+            sim.step([(r, K + 1, (2 * r + 1) % (K + 1))])
+        return sim
+
+    once, thrice = build(), build()  # same seed: same keys, same pre-state
+    plan = [(r, K + 1, 4) for r in range(num_reqs)]
+    once.step(plan, pad_tokens=pad)
+    thrice.step(plan, pad_tokens=pad, repeat=3)
+    assert torch.equal(once.ring.cpu(), thrice.ring.cpu())
+    assert torch.equal(once.comp.cpu(), thrice.comp.cpu())
+    once.check("once")
+
