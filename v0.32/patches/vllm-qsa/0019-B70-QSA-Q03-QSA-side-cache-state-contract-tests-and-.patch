+def test_missing_compressed_reload_is_detected():
+    """A CPU reload that restored the main KV but not the compressed-key group
+    leaves stale rows the next selection would score. The ground truth sees it
+    (in the engine, the dump comparison of qsa_engine_lifecycle.py does)."""
+    sim = _Sim(
+        _RefOps,
+        torch.device("cpu"),
+        num_reqs=2,
+        cap=16,
+        comp_page=16,
+        max_groups=128,
+        seed=12,
+    )
+    _prefill(sim, 0, 256, chunks=[256])
+    _new_request_from_cache(sim, 0, 1, 192, reload_compressed=False)
+    _step_with_keys(sim, 1, sim.committed[0][192:256])
