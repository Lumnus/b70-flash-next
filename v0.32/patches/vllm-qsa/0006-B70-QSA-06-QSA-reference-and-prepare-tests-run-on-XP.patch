+@pytest.mark.parametrize("width", [64, 1400])
+def test_qsa_topk_torch_contract_and_ties(width: int) -> None:
+    """B70-QSA: the portable top-k keeps the persistent_topk contract.
+
+    Columns past a row's visible count are ignored, short rows return
+    0..visible-1 then -1, and exact ties break toward the lower column so the
+    selection is deterministic (ReLU-summed QSA scores tie at 0.0).
+    """
+    torch.manual_seed(0)
+    block_topk = 512
+    rows = 6
+    logits = torch.randn(rows, width)
+    logits[logits < 0.3] = 0.0  # many exact ties at zero
+    logits[:, width // 2 :] = torch.nan  # garbage beyond visible is never read
+    visible = torch.tensor(
+        [0, 1, 5, width // 4, width // 2, width // 2], dtype=torch.int32
+    )
+    out = torch.empty(rows, block_topk, dtype=torch.int32)
+    qsa_indexer_ops._qsa_topk_torch(logits, visible, block_topk, out)
+    for row in range(rows):
+        n = int(visible[row])
+        k = min(n, block_topk)
+        assert (out[row, k:] == -1).all()
+        chosen = out[row, :k].long()
+        assert chosen.unique().numel() == k
+        assert (chosen < n).all()
+        # Exact reference: sort by (-score, column).
+        cols = torch.arange(n)
+        order = sorted(cols.tolist(), key=lambda c: (-float(logits[row, c]), c))
+        assert chosen.tolist() == order[:k]
+
