+# W1 §4 sparse-minus-dense, for --budget: extra ms per decode step (c=1, short and 32K depth),
+# extra ms per 4096-token prefill chunk.
+W1_GAP = {
+    "decode_c1_ms_per_step": 32.4 - 22.5,
+    "prefill_chunk_ms": {
+        8192: 4096 / 1807.3 * 1e3 - 4096 / 6304.6 * 1e3,
+        32768: 4096 / 1592.9 * 1e3 - 4096 / 6113.6 * 1e3,
+        131072: 4096 / 1076.1 * 1e3 - 4096 / 4640.9 * 1e3,
+    },
+}
