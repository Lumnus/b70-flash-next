+
+# --------------------------------------------------------------------------------------------
+# compile introspection
+# --------------------------------------------------------------------------------------------
+_LAUNCHED: list[Any] = []
+
+
+def _hook_jit(jit_fn) -> None:
+    """Record every CompiledKernel a JITFunction launch returns."""
+    if getattr(jit_fn, "_b70_hooked", False):
+        return
+    orig = jit_fn.run
+
+    def run(*a, **k):
+        kernel = orig(*a, **k)
+        if kernel is not None:
+            _LAUNCHED.append(kernel)
+        return kernel
+
+    jit_fn.run = run
+    jit_fn._b70_hooked = True
+
+
+for _fn in (
+    idx_ops._qsa_mqa_paged_uniform_kernel,
+    idx_ops._qsa_mqa_paged_prefill_kernel,
+    idx_ops._expand_qsa_indices_kernel,
+    qsa_ops._qsa_sparse_paged_gqa_splitk_kernel,
+    qsa_ops._qsa_merge_splitk_kernel,
+):
+    _hook_jit(_fn)
+
+
+def _kernel_info(kernel) -> dict[str, Any]:
+    md = getattr(kernel, "metadata", None)
+    name = getattr(md, "name", None) or getattr(kernel, "name", "?")
+    info: dict[str, Any] = {"name": str(name)}
+    for attr in ("n_regs", "n_spills", "n_max_threads"):
+        try:
+            info[attr] = getattr(kernel, attr)
+        except Exception:  # handles not initialised on some backends
+            info[attr] = None
+    for attr in ("threads_per_warp", "num_warps", "num_stages", "grf_mode", "shared"):
+        info[attr] = getattr(md, attr, None)
+    try:
+        ttgir = kernel.asm.get("ttgir", "") or ""
+    except Exception:
+        ttgir = ""
+    info["dpas"] = "dpas" in ttgir
+    info["block_io"] = ("block_io" in ttgir) or ("2d_block" in ttgir)
+    info["fma_dot"] = ("tt.dot" in ttgir) and not info["dpas"]
+    return info
+
+
+def _drain_kernel_info() -> list[dict[str, Any]]:
+    seen, out = set(), []
+    for kernel in _LAUNCHED:
+        if id(kernel) in seen:
+            continue
+        seen.add(id(kernel))
+        out.append(_kernel_info(kernel))
+    _LAUNCHED.clear()
+    return out
+
+
+# --------------------------------------------------------------------------------------------
+# timing
+# --------------------------------------------------------------------------------------------
+def time_us(
+    fn: Callable[[], Any], target_ms: float = 200.0, reps: int = 5, graph: bool = False
+) -> dict:
+    """Median µs per call over `reps` event-timed batches of back-to-back calls.
+
+    graph=True captures one call into an XPU graph and times replays (no host launch cost),
+    which is what the engine's decode path sees under FULL graphs.
+    """
+    fn()  # compile + warm
+    torch.xpu.synchronize()
+    call = fn
+    if graph:
+        g = torch.xpu.XPUGraph()
+        with torch.xpu.graph(g):
+            fn()
+        torch.xpu.synchronize()
+        call = g.replay
+    start, end = (
+        torch.xpu.Event(enable_timing=True),
+        torch.xpu.Event(enable_timing=True),
+    )
+    start.record()
+    call()
+    end.record()
+    torch.xpu.synchronize()
+    one_ms = max(start.elapsed_time(end), 1e-3)
+    n = int(min(max(1, target_ms / one_ms), 200))
+    samples = []
+    for _ in range(reps):
+        start.record()
+        for _ in range(n):
+            call()
+        end.record()
+        torch.xpu.synchronize()
+        samples.append(start.elapsed_time(end) * 1e3 / n)
+    t0 = time.perf_counter()
+    call()
+    host_us = (time.perf_counter() - t0) * 1e6
+    torch.xpu.synchronize()
+    return {
+        "us": statistics.median(samples),
+        "us_min": min(samples),
+        "us_spread": (max(samples) - min(samples))
+        / max(statistics.median(samples), 1e-9),
+        "n_per_rep": n,
+        "host_launch_us": host_us,
+        "graph": graph,
+    }
+
+
+# --------------------------------------------------------------------------------------------
+# problem construction (TP4 shapes)
+# --------------------------------------------------------------------------------------------
+class Problem:
+    """One QSA layer's inputs for `rows` query rows at context `ctx` (tokens)."""
+
+    def __init__(
+        self,
+        *,
+        mode: str,
+        rows: int,
+        ctx: int,
+        block: int,
+        max_model_len: int,
+        seed: int = 0,
+    ):
+        assert mode in ("decode", "prefill")
+        g = torch.Generator(device=DEV)
+        g.manual_seed(seed)
+        self.mode, self.ctx, self.block = mode, ctx, block
+        comp_page = block // RATIO
+        if mode == "decode":
+            self.num_requests = rows // DQL
+            assert self.num_requests * DQL == rows, (
+                "decode rows must be a multiple of 8"
+            )
+            positions = [
+                ctx - DQL + i for _ in range(self.num_requests) for i in range(DQL)
+            ]
+        else:
+            self.num_requests = 1
+            assert ctx >= rows, "prefill chunk must fit its context"
+            positions = list(range(ctx - rows, ctx))
+        self.rows = rows
+        pages_needed = math.ceil(ctx / block)
+        width = math.ceil(max_model_len / block)
+        assert width >= pages_needed
+        nblocks = self.num_requests * pages_needed + 1
+        perm = torch.randperm(nblocks - 1, generator=g, device=DEV).to(torch.int32) + 1
+        table = torch.zeros((self.num_requests, width), dtype=torch.int32, device=DEV)
+        table[:, :pages_needed] = perm.view(self.num_requests, pages_needed)
+        self.page_table = table
+        self.positions = torch.tensor(positions, dtype=torch.int64, device=DEV)
+        self.token_to_req = (
+            torch.arange(rows, device=DEV) // (rows // self.num_requests)
+        ).to(torch.int32)
+        self.seq_lens = torch.full(
+            (self.num_requests,), ctx, dtype=torch.int32, device=DEV
+        )
+        self.visible_blocks = torch.minimum(
+            (self.positions + 1) // RATIO,
+            self.seq_lens.index_select(0, self.token_to_req.long()) // RATIO,
+        ).to(torch.int32)
+        self.query_start_loc = torch.tensor([0, rows], dtype=torch.int32, device=DEV)
+        # indexer: normalised Q and compressed keys (unit-ish scale like the RMSNormed reality)
+        self.idx_q = torch.randn(
+            (rows, IDX_HEADS, IDX_DIM), generator=g, device=DEV, dtype=torch.bfloat16
+        )
+        self.comp_cache = torch.randn(
+            (nblocks, comp_page, 1, IDX_DIM),
+            generator=g,
+            device=DEV,
+            dtype=torch.bfloat16,
+        )
+        # main attention
+        self.q = torch.randn(
+            (rows, NUM_Q_HEADS, HEAD_DIM), generator=g, device=DEV, dtype=torch.bfloat16
+        )
+        self.gate = torch.randn_like(self.q)
+        self.kv = torch.randn(
+            (nblocks, block, NUM_KV_HEADS, 2 * HEAD_DIM),
+            generator=g,
+            device=DEV,
+            dtype=torch.bfloat16,
+        )
+        self.k_cache, self.v_cache = self.kv.split(HEAD_DIM, dim=-1)
+        self.block_indices = torch.empty(
+            (rows, BLOCK_TOPK), dtype=torch.int32, device=DEV
+        )
+        self.logical = torch.empty((rows, SEL_WIDTH + 1), dtype=torch.int32, device=DEV)
+        self.out = torch.empty_like(self.q)
+        self.columns = width * comp_page  # decode logits width = page-table width
+        self.logits_width = min(
+            max(64, math.ceil(math.ceil(ctx / RATIO) / 64) * 64), self.columns
+        )
+
+    def select(self) -> None:
+        if self.mode == "decode":
+            idx_ops.qsa_select_paged_decode(
+                self.idx_q,
+                self.comp_cache,
+                self.page_table,
+                self.visible_blocks,
+                TOKEN_TOPK,
+                RATIO,
+                DQL,
+                self.block_indices,
+            )
+        else:
+            idx_ops.qsa_select_paged_prefill(
+                self.idx_q,
+                self.comp_cache,
+                self.page_table,
+                self.query_start_loc,
+                self.visible_blocks,
+                TOKEN_TOPK,
+                RATIO,
+                self.rows,
+                self.block_indices,
+                self.ctx,
+            )
+
+    def expand(self) -> None:
+        idx_ops.expand_qsa_block_indices(
+            self.block_indices,
+            self.positions,
+            self.visible_blocks,
+            RATIO,
+            TOKEN_TOPK,
+            self.logical,
+        )
+
+    def attn(self) -> None:
+        qsa_ops.qsa_sparse_paged_attention(
+            self.q,
+            self.k_cache,
+            self.v_cache,
+            self.logical,
+            self.page_table,
+            self.token_to_req,
+            self.mode == "prefill",
+            self.out,
+            output_gate=self.gate,
+        )
+
+
+# --------------------------------------------------------------------------------------------
+# references
+# --------------------------------------------------------------------------------------------
+def ref_logits(p: Problem, rows: list[int]) -> torch.Tensor:
+    """fp32 ReLU-sum indexer scores for the given rows, -inf past visible (kernel omits 1/sqrt(d))."""
+    out = []
+    comp_page = p.comp_cache.shape[1]
+    for r in rows:
+        req = int(p.token_to_req[r])
+        vis = int(p.visible_blocks[r])
+        pages = p.page_table[req, : math.ceil(max(vis, 1) / comp_page)].long()
+        keys = p.comp_cache[pages, :, 0, :].reshape(-1, IDX_DIM)[:vis].float()
+        s = torch.relu(keys @ p.idx_q[r].float().T).sum(-1)
+        out.append(s)
+    return out
+
+
+def check_selection(p: Problem, sample: int = 6) -> dict:
+    """Selected-set check that tolerates exact score ties (compares score multisets)."""
+    rows = sorted(
+        {0, p.rows - 1, p.rows // 2}
+        | {int(x) for x in torch.linspace(0, p.rows - 1, sample).tolist()}
+    )
+    worst = 0.0
+    bad = 0
+    for r, s in zip(rows, ref_logits(p, rows)):
+        vis = s.numel()
+        k = min(BLOCK_TOPK, vis)
+        got = p.block_indices[r, :k].long()
+        if (got < 0).any() or (got >= vis).any() or got.unique().numel() != k:
+            bad += 1
+            continue
+        want = torch.topk(s, k).values.sort().values
+        have = s[got].sort().values
+        err = (want - have).abs().max().item() / max(want.abs().max().item(), 1e-6)
+        worst = max(worst, err)
+        if err > 1e-2:
+            bad += 1
+    return {"sel_rows_checked": len(rows), "sel_bad_rows": bad, "sel_worst_rel": worst}
+
+
+def check_attention(p: Problem, sample: int = 4) -> dict:
+    rows = sorted(
+        {0, p.rows - 1}
+        | {int(x) for x in torch.linspace(0, p.rows - 1, sample).tolist()}
+    )
+    worst = 0.0
+    for r in rows:
+        lg = p.logical[r, :SEL_WIDTH]
+        lg = lg[lg >= 0].long()
+        req = int(p.token_to_req[r])
+        pages = p.page_table[req, lg // p.block].long()
+        off = lg % p.block
+        k = (
+            p.k_cache[pages, off]
+            .float()
+            .repeat_interleave(NUM_Q_HEADS // NUM_KV_HEADS, 1)
+        )
+        v = (
+            p.v_cache[pages, off]
+            .float()
+            .repeat_interleave(NUM_Q_HEADS // NUM_KV_HEADS, 1)
+        )
+        sc = torch.einsum("hd,khd->hk", p.q[r].float(), k) * HEAD_DIM**-0.5
+        o = (
+            torch.einsum("hk,khd->hd", torch.softmax(sc, -1), v)
+            .to(torch.bfloat16)
+            .float()
+        )
+        o = o * torch.sigmoid(p.gate[r].float())
+        worst = max(worst, (o - p.out[r].float()).abs().max().item())
+    return {
+        "attn_rows_checked": len(rows),
+        "attn_max_abs": worst,
+        "attn_ok": worst <= 2e-2,
+    }
+
+
+# --------------------------------------------------------------------------------------------
+# ops
+# --------------------------------------------------------------------------------------------
+def _topk_native(p: Problem, logits: torch.Tensor) -> None:
+    seq_lens = p.visible_blocks.to(torch.int32).contiguous()
+    torch.ops._C.top_k_per_row_decode(
+        logits,
+        1,
+        seq_lens,
+        p.block_indices,
+        logits.shape[0],
+        logits.stride(0),
+        logits.stride(1),
+        BLOCK_TOPK,
+    )
+
+
+def decode_logits_buffer(p: Problem) -> torch.Tensor:
+    return torch.empty((p.rows, p.columns), dtype=torch.float32, device=DEV)
+
+
+def op_decode_score(p: Problem, logits: torch.Tensor) -> Callable[[], None]:
+    def run():
+        tpp = idx_ops._decode_tiles_per_program(p.num_requests, p.columns)
+        stages, warps = idx_ops._decode_launch_config(p.comp_cache.dtype)
+        bn = idx_ops._decode_block_n()
+        idx_ops._qsa_mqa_paged_uniform_kernel[
+            (p.num_requests, math.ceil(p.columns / (bn * tpp)))
+        ](
+            p.idx_q,
+            p.comp_cache,
+            p.page_table,
+            p.visible_blocks,
+            logits,
+            *p.idx_q.stride()[:-1],
+            *p.comp_cache.stride()[:2],
+            *p.page_table.stride()[:-1],
+            *logits.stride()[:-1],
+            PAGE_SIZE=p.comp_cache.shape[1],
+            PAGE_TABLE_WIDTH=p.page_table.shape[1],
+            NUM_HEADS=IDX_HEADS,
+            HEAD_DIM=IDX_DIM,
+            DECODE_QUERY_LEN=DQL,
+            BLOCK_N=bn,
+            TILES_PER_PROG=tpp,
+            STAGES=stages,
+            MIN_DOT_N=idx_ops._min_dot_n(),
+            num_warps=warps,
+            **xpu_tune.launch_extra("decode_score"),
+        )
+
+    return run
+
+
+def prefill_rows_per_chunk(p: Problem) -> int:
+    """Rows per scoring chunk, as qsa_select_paged_prefill computes it."""
+    import vllm.envs as envs
+
+    return max(
+        1, envs.VLLM_SPARSE_INDEXER_MAX_LOGITS_MB * 1024 * 1024 // (p.logits_width * 4)
+    )
+
+
+def op_prefill_score(p: Problem, workspace: torch.Tensor) -> Callable[[], None]:
+    """All scoring chunks of the prefill rows (no top-k), as the engine launches them."""
+    step = prefill_rows_per_chunk(p)
+
+    def run():
+        for start in range(0, p.rows, step):
+            n = min(step, p.rows - start)
+            idx_ops._prefill_logits(
+                p.idx_q,
+                p.comp_cache,
+                p.page_table,
+                p.query_start_loc,
+                p.visible_blocks,
+                workspace,
+                p.rows,
+                p.logits_width,
+                start,
+                n,
+            )
+
+    return run
+
+
+def build_ops(p: Problem) -> dict[str, Callable[[], None]]:
+    ops: dict[str, Callable[[], None]] = {}
+    if p.mode == "decode":
+        logits = decode_logits_buffer(p)
+        ops["decode_score"] = op_decode_score(p, logits)
+        ops["decode_score"]()
+        torch.xpu.synchronize()
+        if hasattr(torch.ops._C, "top_k_per_row_decode"):
+            ops["topk_native"] = lambda: _topk_native(p, logits)
+        ops["topk_torch"] = lambda: idx_ops._qsa_topk_torch(
+            logits, p.visible_blocks, BLOCK_TOPK, p.block_indices
+        )
+        ops["select_decode"] = p.select
+    else:
+        ws = torch.empty(
+            (max(512 << 20, p.page_table.shape[1] * p.comp_cache.shape[1] * 4) // 4,),
+            dtype=torch.float32,
+            device=DEV,
+        )
+        ops["prefill_score"] = op_prefill_score(p, ws)
+        # Stand-alone top-k timings run on the LAST scoring chunk (what the workspace holds after
+        # the scorer ran); x chunks = the whole prefill's top-k. Rows are emitted as topk_rows.
+        step = prefill_rows_per_chunk(p)
+        last = (p.rows - 1) // step * step
+        n_last = p.rows - last
+        logits = ws[: n_last * p.logits_width].view(n_last, p.logits_width)
+        vis = p.visible_blocks[last:]
+        bi = p.block_indices[last:]
+        ops["prefill_score"]()
+        torch.xpu.synchronize()
+        if hasattr(torch.ops._C, "top_k_per_row_decode"):
+
+            def _nat():
+                torch.ops._C.top_k_per_row_decode(
+                    logits,
+                    1,
+                    vis.contiguous(),
+                    bi,
+                    n_last,
+                    logits.stride(0),
+                    logits.stride(1),
+                    BLOCK_TOPK,
+                )
+
+            ops["topk_native"] = _nat
+        ops["topk_torch"] = lambda: idx_ops._qsa_topk_torch(logits, vis, BLOCK_TOPK, bi)
+        p.topk_rows = n_last
+        p.topk_chunks = math.ceil(p.rows / step)
+        ops["select_prefill"] = p.select
+    ops["expand"] = p.expand
+    ops["attn"] = p.attn
+    return ops
+
+
+def sycl_bar(op: str, rows: int, ctx: int) -> dict:
+    key = (op, rows)
+    if key in SYCL_BAR and ctx in SYCL_BAR[key]:
+        azk, strata = SYCL_BAR[key][ctx]
+        return {"bar_azk_us": azk, "bar_strata_us": strata}
+    return {}
+
+
+# --------------------------------------------------------------------------------------------
+# sweep grids (coarse; refine around the winner with --grid-json)
+# --------------------------------------------------------------------------------------------
+GRF = ["default", "256", "auto"]
+GRIDS: dict[str, dict[str, list]] = {
+    "decode_score": {
+        "num_warps": [1, 2, 4, 8],
+        "stages": [1, 2, 3],
+        "block_n": [32, 64, 128],
+        "tiles_per_prog": [0, 1, 4],
+        "grf_mode": GRF,
+    },
+    "prefill_score": {
+        "tile_r": [16, 32, 64],
+        "block_n": [32, 64, 128],
+        "k_tiles": [4, 16, 64],
+        "num_warps": [2, 4, 8, 16],
+        "stages": [1, 2],
+        "grf_mode": ["default", "256"],
+    },
+    "sparse_gqa_decode": {
+        "block_n": [16, 32, 64, 128],
+        "splits": [1, 4, 16, 64],
+        "num_warps": [1, 2, 4, 8],
+        "num_stages": [1, 2, 3],
+        "grf_mode": ["default", "256"],
+    },
+    "sparse_gqa_prefill": {
+        "block_n": [16, 32, 64, 128],
+        "splits": [1, 2],
+        "num_warps": [1, 2, 4, 8, 16],
+        "num_stages": [1, 2, 3],
+        "grf_mode": ["default", "256"],
+    },
+    "merge": {"num_warps": [1, 2, 4, 8]},
+    "expand": {"column_block": [128, 256, 512, 1024], "num_warps": [1, 2, 4, 8]},
+}
+# env knobs swept alongside (read by the dispatch at every call)
+ENV_GRIDS: dict[str, dict[str, list[str]]] = {
+    "decode_score": {"B70_QSA_MIN_DOT_N": ["16", "32"]},
+    "sparse_gqa_decode": {"B70_QSA_MIN_BLOCK_M": ["1", "16"]},
+    "sparse_gqa_prefill": {"B70_QSA_MIN_BLOCK_M": ["1", "16"]},
+}
+SWEEP_OP = {
+    "decode_score": ("decode", "decode_score"),
+    "prefill_score": ("prefill", "prefill_score"),
+    "sparse_gqa_decode": ("decode", "attn"),
+    "sparse_gqa_prefill": ("prefill", "attn"),
+    "merge": ("decode", "attn"),
+    "expand": ("decode", "expand"),
+}
+
+
+def grid_rows(
+    kernel: str, grid_json: str | None, limit: int
+) -> list[tuple[dict, dict]]:
+    grid = dict(GRIDS[kernel])
+    env = dict(ENV_GRIDS.get(kernel, {}))
+    if grid_json:
+        extra = json.loads(
+            open(grid_json[1:]).read() if grid_json.startswith("@") else grid_json
+        )
+        grid.update({k: v for k, v in extra.items() if not k.startswith("B70_")})
+        env.update({k: v for k, v in extra.items() if k.startswith("B70_")})
+    keys, ekeys = list(grid), list(env)
+    rows = []
+    for vals in itertools.product(*grid.values()):
+        for evals in itertools.product(*env.values()) if env else [()]:
+            rows.append((dict(zip(keys, vals)), dict(zip(ekeys, evals))))
+    return rows[:limit] if limit else rows
+
+
+# --------------------------------------------------------------------------------------------
+def main() -> None:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
+    )
+    ap.add_argument(
+        "--card", default=None, help="ZE_AFFINITY_MASK value (set before torch init)"
+    )
+    ap.add_argument("--ops", default="all", help="comma list or all")
+    ap.add_argument("--ctx", default="4096,16384,32768,65536,131072,262144")
+    ap.add_argument("--rows", default="8,32,64", help="decode rows (multiples of 8)")
+    ap.add_argument("--prefill-rows", type=int, default=4096)
+    ap.add_argument("--no-prefill", action="store_true")
+    ap.add_argument("--no-decode", action="store_true")
+    ap.add_argument(
+        "--block",
+        type=int,
+        default=832,
+        help="main KV block tokens (engine journal: 832)",
+    )
+    ap.add_argument(
+        "--max-model-len", type=int, default=262144, help="sets the page-table width"
+    )
+    ap.add_argument(
+        "--graph", action="store_true", help="time decode ops as XPU-graph replays"
+    )
+    ap.add_argument(
+        "--sweep", default="", help="kernel key from qsa_xpu_tuning (decode_score, ...)"
+    )
+    ap.add_argument(
+        "--grid-json",
+        default=None,
+        help="override/extend the sweep grid (JSON or @file)",
+    )
+    ap.add_argument(
+        "--limit", type=int, default=0, help="cap the number of sweep configs"
+    )
+    ap.add_argument(
+        "--budget", action="store_true", help="per-step totals vs the W1 dense gap"
+    )
+    ap.add_argument("--no-check", action="store_true")
+    ap.add_argument("--reps", type=int, default=5)
+    ap.add_argument("--out", default="")
+    a = ap.parse_args()
+
+    assert current_platform.is_xpu(), "XPU only"
+    torch.manual_seed(0)
+    ctxs = [int(x) for x in a.ctx.split(",") if x]
+    drows = [int(x) for x in a.rows.split(",") if x]
+    out = open(a.out, "a") if a.out else None
+    meta = {
+        "torch": torch.__version__,
+        "triton": __import__("triton").__version__,
+        "device": torch.xpu.get_device_name(0),
+        "card": os.environ.get("ZE_AFFINITY_MASK"),
+        "tune_env": os.environ.get("B70_QSA_TUNE", ""),
+        "topk_mode_env": os.environ.get("B70_QSA_TOPK", "auto"),
+        "native_topk": hasattr(torch.ops._C, "top_k_per_row_decode"),
+        "block": a.block,
+        "max_model_len": a.max_model_len,
+        "graph": a.graph,
+    }
+    print(json.dumps({"meta": meta}), flush=True)
+
+    def emit(row: dict) -> None:
+        row = {**row, "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
+        line = json.dumps(row)
+        print(line, flush=True)
+        if out:
+            out.write(line + "\n")
+            out.flush()
+
+    shapes: list[tuple[str, int, int]] = []
+    if not a.no_decode:
+        shapes += [("decode", r, c) for c in ctxs for r in drows]
+    if not a.no_prefill:
+        shapes += [("prefill", a.prefill_rows, c) for c in ctxs if c >= a.prefill_rows]
+
+    if a.sweep:
+        mode, op = SWEEP_OP[a.sweep]
+        configs = grid_rows(a.sweep, a.grid_json, a.limit)
+        for m, rows, ctx in shapes:
+            if m != mode:
+                continue
+            p = Problem(
+                mode=m, rows=rows, ctx=ctx, block=a.block, max_model_len=a.max_model_len
+            )
+            xpu_tune.set_overrides({})
+            base_ops = build_ops(p)
+            p.select()
+            p.expand()
+            ref = None
+            if op == "attn":
+                p.attn()
+                ref = p.out.clone()
+            for cfg, env in configs:
+                saved = {k: os.environ.get(k) for k in env}
+                for k, v in env.items():
+                    os.environ[k] = v
+                try:
+                    xpu_tune.set_overrides({a.sweep: cfg})
+                    ops = (
+                        build_ops(p)
+                        if op in ("decode_score", "prefill_score")
+                        else base_ops
+                    )
+                    _drain_kernel_info()
+                    t = time_us(ops[op], reps=a.reps, graph=a.graph and m == "decode")
+                    row = {
+                        "sweep": a.sweep,
+                        "mode": m,
+                        "rows": rows,
+                        "ctx": ctx,
+                        "cfg": cfg,
+                        "env": env,
+                        **t,
+                        "kernels": _drain_kernel_info(),
+                        **sycl_bar(op, rows, ctx),
+                    }
+                    if ref is not None:
+                        row["max_abs_vs_default"] = (
+                            (p.out.float() - ref.float()).abs().max().item()
+                        )
+                    if op in ("decode_score", "prefill_score") and not a.no_check:
+                        p.select()
+                        row.update(check_selection(p))
+                    emit(row)
+                except (
+                    Exception
+                ) as e:  # a config that does not compile is a result, not a crash
+                    emit(
+                        {
+                            "sweep": a.sweep,
+                            "mode": m,
+                            "rows": rows,
+                            "ctx": ctx,
+                            "cfg": cfg,
+                            "env": env,
+                            "error": f"{type(e).__name__}: {str(e)[:400]}",
+                        }
+                    )
+                finally:
+                    for k, v in saved.items():
+                        if v is None:
+                            os.environ.pop(k, None)
+                        else:
+                            os.environ[k] = v
+            del p
+            torch.xpu.empty_cache()
+        xpu_tune.set_overrides(None)
+        return
+
+    want = None if a.ops == "all" else set(a.ops.split(","))
+    totals: dict[tuple[str, int, int], dict[str, float]] = {}
+    for m, rows, ctx in shapes:
+        try:
+            p = Problem(
+                mode=m, rows=rows, ctx=ctx, block=a.block, max_model_len=a.max_model_len
+            )
+        except torch.OutOfMemoryError as e:
+            emit(
+                {
+                    "mode": m,
+                    "rows": rows,
+                    "ctx": ctx,
+                    "error": f"OOM building inputs: {e}"[:300],
+                }
+            )
+            continue
+        ops = build_ops(p)
+        checks: dict[str, Any] = {}
+        if not a.no_check:
+            p.select()
+            checks.update(check_selection(p))
+            p.expand()
+            p.attn()
+            checks.update(check_attention(p))
+        else:
+            p.select()
+            p.expand()
+        per = totals.setdefault((m, rows, ctx), {})
+        for name, fn in ops.items():
+            if want and name not in want:
+                continue
+            _drain_kernel_info()
+            try:
+                t = time_us(fn, reps=a.reps, graph=a.graph and m == "decode")
+            except Exception as e:
+                emit(
+                    {
+                        "mode": m,
+                        "rows": rows,
+                        "ctx": ctx,
+                        "op": name,
+                        "error": f"{type(e).__name__}: {e}"[:400],
+                    }
+                )
+                continue
+            per[name] = t["us"]
+            emit(
+                {
+                    "mode": m,
+                    "rows": rows,
+                    "ctx": ctx,
+                    "op": name,
+                    **t,
+                    "kernels": _drain_kernel_info(),
+                    **sycl_bar(name, rows, ctx),
+                    **(
+                        checks
+                        if name in ("select_decode", "select_prefill", "attn")
+                        else {}
+                    ),
+                    "decode_logits_width": p.columns
+                    if m == "decode"
+                    else p.logits_width,
+                    **(
+                        {"topk_rows": p.topk_rows, "topk_chunks": p.topk_chunks}
+                        if name.startswith("topk") and m == "prefill"
+                        else {}
+                    ),
+                }
+            )
+        del p, ops
+        torch.xpu.empty_cache()
+
+    if a.budget:
+        for (m, rows, ctx), per in totals.items():
+            sel = per.get("select_decode" if m == "decode" else "select_prefill", 0.0)
+            layer_us = sel + per.get("expand", 0.0) + per.get("attn", 0.0)
+            row = {
+                "budget": True,
+                "mode": m,
+                "rows": rows,
+                "ctx": ctx,
+                "qsa_layer_us": layer_us,
+                "qsa_12_layers_ms": layer_us * QSA_LAYERS / 1e3,
+            }
+            if m == "decode" and rows == 8:
+                row["w1_gap_decode_c1_ms"] = W1_GAP["decode_c1_ms_per_step"]
+            if m == "prefill" and ctx in W1_GAP["prefill_chunk_ms"]:
+                row["w1_gap_prefill_chunk_ms"] = W1_GAP["prefill_chunk_ms"][ctx]
+            row["note"] = (
+                "excludes qsa_prepare, metadata, output.zero_, o_proj and the dense attention it "
+                "replaces; compare against the gap, not the step"
+            )
+            emit(row)
+    if out:
+        out.close()
+
+
+if __name__ == "__main__":
+    main()
