+NUM_Q_HEADS = 6  # per TP4 rank
+NUM_KV_HEADS = 1
+HEAD_DIM = 256
+IDX_HEADS = 4
+IDX_DIM = 128
+RATIO = 4
+TOKEN_TOPK = 2048
+BLOCK_TOPK = TOKEN_TOPK // RATIO
+SEL_WIDTH = TOKEN_TOPK + RATIO - 1  # 2051
