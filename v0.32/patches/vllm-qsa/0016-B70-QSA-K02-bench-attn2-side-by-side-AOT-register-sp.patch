+        print(
+            f"attn2 {cfg} vs ref {e:.3e} vs splitk {e2:.3e} {'OK' if good else 'FAIL'}"
+        )
+    print("RESULT", "PASS" if ok else "FAIL")
+    sys.exit(0 if ok else 1)
