From 21f1848f43997d5a960b941a226b6e03ee5014a3 Mon Sep 17 00:00:00 2001
From: Lumnus <lumnus.org@gmail.com>
Date: Sun, 25 Oct 2026 21:40:55 +0000
Subject: [PATCH 14/36] B70-QSA-T06: bench selection check skips empty-history
 rows (first prefill rows select nothing)

The check took max() over an empty tensor at prefill row 0 and aborted the run. A row with no visible
blocks now only checks that the selector wrote no index.
---
 benchmarks/kernels/bench_qwen4_qsa_xpu.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/benchmarks/kernels/bench_qwen4_qsa_xpu.py b/benchmarks/kernels/bench_qwen4_qsa_xpu.py
index e6a834828e..cc7a8fd6ff 100644
--- a/benchmarks/kernels/bench_qwen4_qsa_xpu.py
+++ b/benchmarks/kernels/bench_qwen4_qsa_xpu.py
@@ -428,6 +428,10 @@ def check_selection(p: Problem, sample: int = 6) -> dict:
     for r, s in zip(rows, ref_logits(p, rows)):
         vis = s.numel()
         k = min(BLOCK_TOPK, vis)
+        if k == 0:  # empty history (first prefill rows): nothing to select, no index may be written
+            if (p.block_indices[r, :BLOCK_TOPK] >= 0).any():
+                bad += 1
+            continue
         got = p.block_indices[r, :k].long()
         if (got < 0).any() or (got >= vis).any() or got.unique().numel() != k:
             bad += 1
