+def _warmup_attn2(
+    q_ptr,
+    k_cache_ptr,
+    v_cache_ptr,
+    indices_ptr,
+    block_table_ptr,
+    token_to_req_ptr,
+    output_ptr,
+    output_gate_ptr,
+    key_cache,
+    value_cache,
+    block_table,
+    *,
+    num_rows,
+    num_requests,
+    num_cache_blocks,
+    num_query_heads,
+    num_kv_heads,
+    group_size,
+    block_m,
+    head_dim,
+    selection_width,
+) -> tuple[tuple[int, int, int], ...]:
+    """B70-QSA-K: compile every attn2 tile/merge specialization dispatch can pick."""
+    head_stride = head_dim
+    row_stride = num_query_heads * head_dim
+    partial_output_ptr = TritonWarmupTensor(torch.float32)
+    partial_lse_ptr = TritonWarmupTensor(torch.float32)
+    warmed = []
+    profiles = attn2.attn2_profiles(num_kv_heads, selection_width)
+    for block_n, num_dchunk, tpp, warps, stages, extra in sorted(profiles):
+        attn2._qsa_attn2_tile_kernel.warmup(
+            q_ptr,
+            k_cache_ptr,
+            v_cache_ptr,
+            indices_ptr,
+            block_table_ptr,
+            token_to_req_ptr,
+            partial_output_ptr,
+            partial_lse_ptr,
+            1.0,
+            1.0,
+            row_stride,
+            head_stride,
+            key_cache.stride(0),
+            key_cache.stride(1),
+            key_cache.stride(2),
+            value_cache.stride(0),
+            value_cache.stride(1),
+            value_cache.stride(2),
+            selection_width + 1,
+            block_table.stride(0),
+            num_rows,
+            num_cache_blocks,
+            num_requests,
+            TOPK=selection_width,
+            PAGE_SIZE=key_cache.shape[1],
+            PAGE_TABLE_WIDTH=block_table.shape[1],
+            GROUP_SIZE=group_size,
+            HEAD_DIM=head_dim,
+            NUM_QUERY_HEADS=num_query_heads,
+            BLOCK_M=block_m,
+            BLOCK_N=block_n,
+            NUM_DCHUNK=num_dchunk,
+            TILES_PER_PROG=tpp,
+            num_warps=warps,
+            num_stages=stages,
+            **dict(extra),
+            grid=(num_rows, num_kv_heads, 1),
+        )
+        attn2._qsa_attn2_merge_kernel.warmup(
+            partial_output_ptr,
+            partial_lse_ptr,
+            indices_ptr,
+            output_ptr,
+            output_gate_ptr,
+            selection_width + 1,
+            row_stride,
+            head_stride,
+            row_stride,
+            head_stride,
+            num_rows,
+            TOPK=selection_width,
+            BLOCK_N=block_n,
+            HEAD_DIM=head_dim,
+            NUM_QUERY_HEADS=num_query_heads,
+            **attn2.merge_kwargs(),
+            grid=(num_rows, num_query_heads),
+        )
+        warmed.append((block_n, tpp, warps))
+    return tuple(warmed)
