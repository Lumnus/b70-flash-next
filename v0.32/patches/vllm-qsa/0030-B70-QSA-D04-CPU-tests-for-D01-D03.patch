+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""B70-QSA-D: top-k levers, checked on CPU.
+
+D01: ``_qsa_topk_select`` (native-anchored and radix thresholds) returns
+     ``_qsa_topk_torch``'s output element for element, ties included.
+D02: per-verify-step selection (anchor row) and skip-when-everything-fits.
+D03: the C2 scorer launch defaults and their overrides.
+"""
+
+import itertools
+import zlib
+
+import pytest
+import torch
+
+from vllm.models.qwen4_exp.nvidia.ops import qsa_indexer as qi
+
+CR = 4
+
+
+# --------------------------------------------------------------------------
+# D01: deterministic select == torch selector
+# --------------------------------------------------------------------------
+
+
+def _torch_ref(logits, visible, k):
+    out = torch.empty(logits.shape[0], k, dtype=torch.int32)
+    qi._qsa_topk_torch(logits, visible, k, out)
+    return out
+
+
+def _select(logits, visible, k, native=None):
+    out = torch.empty(logits.shape[0], k, dtype=torch.int32)
+    qi._qsa_topk_select(logits, visible, k, out, native_indices=native)
+    return out
+
+
+def _adversarial_native(logits, visible, k, gen, high_col=True):
+    """A correct top-k SET with an arbitrary tie choice, in random order."""
+    rows, width = logits.shape
+    out = torch.full((rows, k), -1, dtype=torch.int32)
+    for r in range(rows):
+        v = min(int(visible[r]), width)
+        n = min(k, v)
+        if n == 0:
+            continue
+        vals = logits[r, :v].double()
+        # order ties by column (high or random), values first
+        if high_col:
+            tieb = torch.arange(v, dtype=torch.float64)
+        else:
+            tieb = torch.randperm(v, generator=gen).double()
+        order = sorted(range(v), key=lambda c: (float(vals[c]), float(tieb[c])))
+        pick = torch.tensor(order[::-1][:n])
+        pick = pick[torch.randperm(n, generator=gen)]
+        out[r, :n] = pick.to(torch.int32)
+    return out
+
+
+def _tie_heavy(rows, width, gen, kind):
+    if kind == "zeros":
+        return torch.zeros(rows, width)
+    if kind == "few_values":
+        vals = torch.tensor([0.0, -0.0, 0.5, 1.0, 1.0, 2.0, -1.0])
+        return vals[torch.randint(0, len(vals), (rows, width), generator=gen)]
+    if kind == "relu":
+        x = torch.randn(rows, width, generator=gen)
+        x = torch.where(torch.rand(rows, width, generator=gen) < 0.7, 0.0, x.abs())
+        return x
+    if kind == "signed_zero":
+        x = torch.zeros(rows, width)
+        x[:, ::2] = -0.0
+        x[:, ::7] = 3.0
+        return x
+    if kind == "quantized":
+        return torch.round(torch.randn(rows, width, generator=gen) * 4) / 4
+    if kind == "inf":
+        x = torch.randn(rows, width, generator=gen)
+        x[:, ::5] = float("inf")
+        x[:, 1::5] = float("-inf")
+        return x
+    return torch.randn(rows, width, generator=gen)
+
+
+KINDS = ["zeros", "few_values", "relu", "signed_zero", "quantized", "inf", "randn"]
+
+
+def _visible_set(rows, width, k, gen):
+    base = [0, 1, k - 1, k, k + 1, width, width - 1]
+    out = [min(max(b, 0), width) for b in base]
+    while len(out) < rows:
+        out.append(int(torch.randint(0, width + 1, (1,), generator=gen)))
+    return torch.tensor(out[:rows], dtype=torch.int32)
+
+
+@pytest.mark.parametrize("kind", KINDS)
+@pytest.mark.parametrize(
+    "width,k", [(1, 4), (7, 4), (64, 16), (700, 512), (1024, 512), (4100, 512)]
+)
+def test_select_matches_torch(kind, width, k):
+    gen = torch.Generator().manual_seed(zlib.crc32(f"{kind}{width}{k}".encode()))
+    rows = 9
+    logits = _tie_heavy(rows, width, gen, kind)
+    visible = _visible_set(rows, width, k, gen)
+    want = _torch_ref(logits, visible, k)
+    assert torch.equal(_select(logits, visible, k), want)
+    for high in (True, False):
+        native = _adversarial_native(logits, visible, k, gen, high_col=high)
+        assert torch.equal(_select(logits, visible, k, native), want)
+
+
+def test_select_full_page_table_width():
+    """Decode width of the engine log (65,728 columns), zeros-heavy."""
+    gen = torch.Generator().manual_seed(65728)
+    width, k = 65728, 512
+    logits = _tie_heavy(4, width, gen, "relu")
+    logits[1].zero_()
+    visible = torch.tensor([65728, 40000, 513, 300], dtype=torch.int32)
+    want = _torch_ref(logits, visible, k)
+    assert torch.equal(_select(logits, visible, k), want)
+    native = _adversarial_native(logits, visible, k, gen, high_col=True)
+    assert torch.equal(_select(logits, visible, k, native), want)
+
