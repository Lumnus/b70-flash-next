+def test_select_check_flags_a_wrong_native_set(monkeypatch):
+    monkeypatch.setenv("B70_QSA_TOPK_SELECT_CHECK", "1")
+    logits = torch.arange(40, dtype=torch.float32).view(1, 40)
+    visible = torch.tensor([40], dtype=torch.int32)
+    wrong = torch.arange(8, dtype=torch.int32).view(1, 8)  # the 8 smallest
+    with pytest.raises(RuntimeError):
+        _select(logits, visible, 8, wrong)
+    right = torch.arange(32, 40, dtype=torch.int32).flip(0).view(1, 8)
+    assert torch.equal(
