+@pytest.mark.parametrize("kind", ["few_values", "relu", "randn"])
+def test_select_eight_bit_passes_match(monkeypatch, kind):
+    """Force the 4 x 8-bit radix schedule (used for large row counts)."""
+    monkeypatch.setattr(
+        qi, "_radix_passes", lambda rows: ((24, 8), (16, 8), (8, 8), (0, 8))
+    )
+    gen = torch.Generator().manual_seed(8)
+    logits = _tie_heavy(12, 2000, gen, kind)
+    visible = _visible_set(12, 2000, 512, gen)
+    assert torch.equal(_select(logits, visible, 512), _torch_ref(logits, visible, 512))
+
+
+def test_select_row_chunks_match(monkeypatch):
+    monkeypatch.setenv("B70_QSA_TOPK_SELECT_CHUNK_MB", "0")  # one row per chunk
+    gen = torch.Generator().manual_seed(3)
+    logits = _tie_heavy(6, 1500, gen, "relu")
+    visible = _visible_set(6, 1500, 512, gen)
+    native = _adversarial_native(logits, visible, 512, gen)
+    want = _torch_ref(logits, visible, 512)
+    assert torch.equal(_select(logits, visible, 512), want)
+    assert torch.equal(_select(logits, visible, 512, native), want)
+
