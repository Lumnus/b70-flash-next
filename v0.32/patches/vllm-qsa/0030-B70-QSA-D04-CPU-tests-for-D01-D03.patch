+# --------------------------------------------------------------------------
+# D02: per-verify-step selection and skip-when-fits
+# --------------------------------------------------------------------------
+
+K1 = 8  # DFlash K=7 -> 8 verify rows
+PAGE = 16  # compressed rows per page
+
+
+def _decode_case(num_requests, seq_lens, gen, heads=4, dim=32, pages=None):
+    """Request-major verify batch: K1 rows per request ending at seq_len."""
+    max_blocks = max(seq_lens) // CR + 1
+    width_pages = (max_blocks + PAGE - 1) // PAGE
+    pages = pages or num_requests * width_pages + 1
+    k_cache = torch.randn(pages, PAGE, 1, dim, generator=gen)
+    perm = torch.randperm(pages, generator=gen)[: num_requests * width_pages]
+    page_table = perm.view(num_requests, width_pages).to(torch.int32)
+    positions = torch.cat([torch.arange(s - K1, s) for s in seq_lens])
+    seq = torch.tensor(seq_lens).repeat_interleave(K1)
+    visible = torch.minimum((positions + 1) // CR, seq // CR).to(torch.int32)
+    q = torch.randn(num_requests * K1, heads, dim, generator=gen)
+    return q, k_cache, page_table, visible, positions
+
+
+def _ref_select_rows(
+    q,
+    k_cache,
+    page_table,
+    visible,
+    token_topk,
+    compress_ratio,
+    decode_query_len,
+    block_indices,
+):
+    """Torch stand-in for the Triton scorer + the production _topk."""
+    rows = q.shape[0]
+    page = k_cache.shape[1]
+    columns = page_table.shape[1] * page
+    col = torch.arange(columns)
+    logits = torch.zeros(rows, columns)
+    for r in range(rows):
+        req = r // decode_query_len
+        phys = page_table[req, col // page].long()
+        keys = k_cache[phys, col % page, 0]  # [columns, dim]
+        s = torch.relu(keys @ q[r].T).sum(-1)
+        logits[r] = torch.where(col < visible[r], s, 0.0)
+    qi._topk(
+        logits,
+        visible,
+        token_topk,
+        compress_ratio,
+        block_indices,
+        torch.empty(0, dtype=torch.uint8),
+    )
+
+
+@pytest.fixture
+def ref_scorer(monkeypatch):
+    monkeypatch.setenv("B70_QSA_TOPK", "torch")
+    monkeypatch.setattr(qi, "_select_decode_rows", _ref_select_rows)
+
+
+def _run(q, k_cache, page_table, visible, token_topk, dql, max_seq_len=None):
+    out = torch.empty(q.shape[0], token_topk // CR, dtype=torch.int32)
+    qi.qsa_select_paged_decode(
+        q,
+        k_cache,
+        page_table,
+        visible,
+        token_topk,
+        CR,
+        dql,
+        out,
+        max_seq_len=max_seq_len,
+    )
+    return out
+
+
+def _sets(t):
+    return [set(x for x in row.tolist() if x >= 0) for row in t]
+
+
+@pytest.mark.parametrize("seq_lens", [[60, 33, 100], [70, 70]])
+def test_per_step_is_set_exact_when_the_anchor_fits(monkeypatch, ref_scorer, seq_lens):
+    token_topk = 128  # 32 blocks; every anchor here sees <= 25 blocks
+    gen = torch.Generator().manual_seed(sum(seq_lens))
+    q, kc, pt, vis, _ = _decode_case(len(seq_lens), seq_lens, gen)
+    per_row = _run(q, kc, pt, vis, token_topk, K1)
+    monkeypatch.setenv("B70_QSA_TOPK_PER_STEP", "1")
+    step = _run(q, kc, pt, vis, token_topk, K1)
+    assert _sets(step) == _sets(per_row)
+
+
+@pytest.mark.parametrize("seq_lens", [[300, 151], [257, 400, 260]])
+def test_per_step_beyond_budget_is_causal_and_anchor_derived(
+    monkeypatch, ref_scorer, seq_lens
+):
+    token_topk = 64  # 16 blocks, far fewer than visible
+    k = token_topk // CR
+    gen = torch.Generator().manual_seed(sum(seq_lens) + 1)
+    q, kc, pt, vis, _ = _decode_case(len(seq_lens), seq_lens, gen)
+    per_row = _run(q, kc, pt, vis, token_topk, K1)
+    monkeypatch.setenv("B70_QSA_TOPK_PER_STEP", "1")
+    step = _run(q, kc, pt, vis, token_topk, K1)
+    for req in range(len(seq_lens)):
+        anchor_row = req * K1 + K1 - 1
+        anchor = [x for x in step[anchor_row].tolist() if x >= 0]
+        # the anchor row is exactly the per-row selection, same order
+        assert step[anchor_row].tolist() == per_row[anchor_row].tolist()
+        for r in range(req * K1, (req + 1) * K1):
+            got = [x for x in step[r].tolist() if x >= 0]
+            v = int(vis[r])
+            assert all(x < v for x in got), "non-causal block"
+            assert got == [x for x in anchor if x < v], "not the clipped anchor"
+            assert step[r].tolist()[len(got) :] == [-1] * (k - len(got))
+            dropped = sum(1 for x in anchor if x >= v)
+            assert len(got) == k - dropped and dropped <= (K1 + CR - 1) // CR + 1
+
+
+def test_per_step_ignored_for_plain_decode(monkeypatch, ref_scorer):
+    gen = torch.Generator().manual_seed(9)
+    q, kc, pt, vis, _ = _decode_case(2, [300, 200], gen)
+    q, vis = q[K1 - 1 :: K1].contiguous(), vis[K1 - 1 :: K1].contiguous()
+    base = _run(q, kc, pt, vis, 64, 1)
+    monkeypatch.setenv("B70_QSA_TOPK_PER_STEP", "1")
+    assert torch.equal(_run(q, kc, pt, vis, 64, 1), base)
+
+
+def test_per_step_with_expand_attends_only_the_causal_prefix(monkeypatch, ref_scorer):
+    from tests.models.qwen4_exp.test_qsa_reference import (
+        _expand_qsa_indices_reference,
+    )
+
+    token_topk = 64
+    gen = torch.Generator().manual_seed(21)
+    seq_lens = [301, 158]
+    q, kc, pt, vis, pos = _decode_case(2, seq_lens, gen)
+    monkeypatch.setenv("B70_QSA_TOPK_PER_STEP", "1")
+    blocks = _run(q, kc, pt, vis, token_topk, K1)
+    seq = torch.tensor(seq_lens).repeat_interleave(K1)
+    tokens = _expand_qsa_indices_reference(blocks, pos, pos + 1, CR, token_topk)
+    for r, row in enumerate(tokens.tolist()):
+        p = int(pos[r])
+        sel = [t for t in row if t >= 0]
+        assert all(t <= p for t in sel)
+        assert len(sel) == len(set(sel))
+        tail = list(range(((p + 1) // CR) * CR, p + 1))
+        assert set(tail) <= set(sel)
+        assert int(seq[r]) >= p + 1
+
