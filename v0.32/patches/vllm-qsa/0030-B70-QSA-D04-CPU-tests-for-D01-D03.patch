+@pytest.mark.parametrize("seq_lens,fits", [([60, 128], True), ([129, 20], False)])
+def test_skip_fit_returns_every_visible_block(monkeypatch, ref_scorer, seq_lens, fits):
+    token_topk = 128  # 32 blocks: seq 128 -> 32 blocks fits, 129 -> still 32 (floor)
+    gen = torch.Generator().manual_seed(len(seq_lens) + int(fits))
+    q, kc, pt, vis, _ = _decode_case(len(seq_lens), seq_lens, gen)
+    per_row = _run(q, kc, pt, vis, token_topk, K1)
+    monkeypatch.setenv("B70_QSA_TOPK_SKIP_FIT", "1")
+    called = []
+    monkeypatch.setattr(
+        qi, "_select_decode_rows", lambda *a: called.append(1) or _ref_select_rows(*a)
+    )
+    max_seq = max(seq_lens) if fits else max(seq_lens) + 4  # 133 // 4 = 33 > 32
+    got = _run(q, kc, pt, vis, token_topk, K1, max_seq_len=max_seq)
+    assert _sets(got) == _sets(per_row)
+    if fits:
+        assert not called
+        for r, row in enumerate(got.tolist()):
+            v = int(vis[r])
+            assert row == list(range(v)) + [-1] * (len(row) - v)
+    else:
+        assert called
+
+
+def test_skip_fit_needs_the_host_bound(monkeypatch, ref_scorer):
+    gen = torch.Generator().manual_seed(2)
+    q, kc, pt, vis, _ = _decode_case(1, [40], gen)
+    monkeypatch.setenv("B70_QSA_TOPK_SKIP_FIT", "1")
+    called = []
+    monkeypatch.setattr(
+        qi, "_select_decode_rows", lambda *a: called.append(1) or _ref_select_rows(*a)
+    )
+    _run(q, kc, pt, vis, 128, K1, max_seq_len=None)
+    assert called
