+def test_select_in_place_over_native_buffer():
+    """native_det passes the native output as both input and output."""
+    gen = torch.Generator().manual_seed(11)
+    logits = _tie_heavy(5, 1024, gen, "zeros")
+    visible = torch.tensor([700, 512, 300, 1000, 513], dtype=torch.int32)
+    buf = _adversarial_native(logits, visible, 512, gen)
+    qi._qsa_topk_select(logits, visible, 512, buf, native_indices=buf)
+    assert torch.equal(buf, _torch_ref(logits, visible, 512))
+
