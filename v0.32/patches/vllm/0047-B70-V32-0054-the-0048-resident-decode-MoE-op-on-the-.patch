From a5a2e894f27e0eeb9bb09561ebcc9640473bd369 Mon Sep 17 00:00:00 2001
From: Lumnus <lumnus.org@gmail.com>
Date: Sat, 24 Oct 2026 04:50:25 +0000
Subject: [PATCH 47/49] B70-V32-0054: the 0048 resident decode MoE op on the EP
 layout (B70_MOE_DECODE_OP_RESIDENT=1), port of B70-0054

Loader in fused_moe/b70_decode_op.py (no hot/cold machinery: all experts resident). Refuses under wu1ff
group ownership (B70_ASTRA_OWNERSHIP=0 required): the weights are re-laid out there. Library (libb70_moe_decode.so) built for
torch 2.14 / icpx 2026.1.
---
 .../layers/fused_moe/b70_decode_op.py         | 28 ++++++
 .../layers/fused_moe/experts/xpu_moe.py       | 93 +++++++++++++++++++
 2 files changed, 121 insertions(+)
 create mode 100644 vllm/model_executor/layers/fused_moe/b70_decode_op.py

diff --git a/vllm/model_executor/layers/fused_moe/b70_decode_op.py b/vllm/model_executor/layers/fused_moe/b70_decode_op.py
new file mode 100644
index 0000000000..a46b03cab6
--- /dev/null
+++ b/vllm/model_executor/layers/fused_moe/b70_decode_op.py
@@ -0,0 +1,28 @@
+# SPDX-License-Identifier: Apache-2.0
+"""B70-V32-0054: loader for the 0048 fused decode MoE op (libb70_moe_decode.so, b70moe.moe_decode).
+
+B70_MOE_DECODE_OP=<path> loads the library once; B70_MOE_DECODE_OP_MAX_ROWS (default 16, at most 16) bounds the
+batches it takes. 0 = off."""
+import os
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+_ROWS: list = [None]
+
+
+def decode_op_max_rows() -> int:
+    rows = _ROWS[0]
+    if rows is None:
+        rows, lib = 0, os.environ.get("B70_MOE_DECODE_OP", "0")
+        if lib not in ("", "0"):
+            try:
+                torch.ops.load_library(lib)
+                rows = min(16, int(os.environ.get("B70_MOE_DECODE_OP_MAX_ROWS", "16")))
+                logger.info("B70 decode op: %s, batches of <= %d tokens", lib, rows)
+            except (OSError, RuntimeError) as e:
+                logger.warning("B70 decode op: cannot load %s (%s); stock path", lib, e)
+        _ROWS[0] = rows
+    return rows
