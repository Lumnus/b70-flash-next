From 7caf830b765a69f31497054c4594e5539c02f877 Mon Sep 17 00:00:00 2001
From: Lumnus <lumnus.org@gmail.com>
Date: Mon, 26 Oct 2026 14:31:41 +0000
Subject: [PATCH 50/50] Backport vllm-project/vllm#54163: DFlash/DSpark no
 longer drop the trailing prefix-cache block

Merged upstream 2026-10-23 (0bfeb8d0e3). needs_eagle_block_drop() excludes DFlash/DSpark,
so disable_eagle_block_drop is no longer needed for them. Hunks applied by hand where the
0.32 line lacks is_xpress. scheduler tests: same 3 pre-existing failures before/after.
---
 tests/test_config.py            | 12 ++++++++++--
 tests/v1/core/test_scheduler.py |  1 +
 vllm/config/speculative.py      | 14 ++++++++++++--
 vllm/v1/core/sched/scheduler.py |  5 ++++-
 4 files changed, 27 insertions(+), 5 deletions(-)

diff --git a/tests/test_config.py b/tests/test_config.py
index a7e36ada62..0589623363 100644
--- a/tests/test_config.py
+++ b/tests/test_config.py
@@ -3542,8 +3542,14 @@ def test_draft_sample_method_probabilistic_is_accepted():
     assert speculative_config.draft_sample_method == "probabilistic"
 
 
+@pytest.mark.parametrize(
+    ("method", "drops_block"),
+    [("eagle3", True), ("mtp", True), ("dflash", False), ("dspark", False)],
+)
 @pytest.mark.parametrize("disable_eagle_block_drop", [False, True])
 def test_eagle_block_drop_can_be_disabled_without_disabling_eagle(
+    method: str,
+    drops_block: bool,
     disable_eagle_block_drop: bool,
 ):
     # Start from an ngram config to avoid loading model metadata: these predicates
@@ -3553,10 +3559,12 @@ def test_eagle_block_drop_can_be_disabled_without_disabling_eagle(
         num_speculative_tokens=3,
         disable_eagle_block_drop=disable_eagle_block_drop,
     )
-    speculative_config.method = "eagle3"
+    speculative_config.method = method
 
     assert speculative_config.use_eagle()
-    assert speculative_config.use_eagle_block_drop() is not disable_eagle_block_drop
+    assert speculative_config.use_eagle_block_drop() is (
+        drops_block and not disable_eagle_block_drop
+    )
 
 
 def test_draft_sample_method_gumbel_is_rejected():
diff --git a/tests/v1/core/test_scheduler.py b/tests/v1/core/test_scheduler.py
index 107a37dc91..e1026d227e 100644
--- a/tests/v1/core/test_scheduler.py
+++ b/tests/v1/core/test_scheduler.py
@@ -4637,6 +4637,7 @@ def test_mamba_align_eagle_schedules_encoder_at_boundary():
     )
     scheduler.need_mamba_block_aligned_split = True
     scheduler.use_eagle = True
+    scheduler.use_eagle_block_drop = True
     scheduler.num_prefill_lookahead = 1
     scheduler.max_num_encoder_input_tokens = 2048
     scheduler.encoder_cache_manager = EncoderCacheManager(cache_size=2048)
diff --git a/vllm/config/speculative.py b/vllm/config/speculative.py
index b916d7da2b..3985cf9f15 100644
--- a/vllm/config/speculative.py
+++ b/vllm/config/speculative.py
@@ -1947,9 +1947,19 @@ class SpeculativeConfig:
         # TODO(ben): Refactor this so the naming is clearer
         return self.method in ("eagle", "eagle3", "mtp", "dflash", "dspark")
 
+    def needs_eagle_block_drop(self) -> bool:
+        """Whether draft KV at a position depends on the next token.
+
+        EAGLE-style drafters build a position's draft KV from its hidden state
+        and the next token. DFlash/DSpark build it from the target hidden state
+        alone, so only EAGLE/EAGLE3/MTP require the trailing-block drop.
+        (vllm-project/vllm#54163)
+        """
+        return self.use_eagle() and not (self.use_dflash() or self.use_dspark())
+
     def use_eagle_block_drop(self) -> bool:
-        """Whether volatile trailing cache blocks should be discarded."""
-        return self.use_eagle() and not self.disable_eagle_block_drop
+        """Whether the volatile trailing prefix-cache block should be dropped."""
+        return self.needs_eagle_block_drop() and not self.disable_eagle_block_drop
 
     def use_dflash(self) -> bool:
         return self.method == "dflash"
diff --git a/vllm/v1/core/sched/scheduler.py b/vllm/v1/core/sched/scheduler.py
index cf577f411b..bc160469bc 100644
--- a/vllm/v1/core/sched/scheduler.py
+++ b/vllm/v1/core/sched/scheduler.py
@@ -317,7 +317,10 @@ class Scheduler(SchedulerInterface):
                 )
             self.use_eagle = speculative_config.use_eagle()
             self.use_eagle_block_drop = speculative_config.use_eagle_block_drop()
-            if self.use_eagle and not self.use_eagle_block_drop:
+            if (
+                speculative_config.needs_eagle_block_drop()
+                and speculative_config.disable_eagle_block_drop
+            ):
                 logger.warning(
                     "EAGLE trailing prefix-cache block dropping is disabled. "
                     "This is experimental and may affect speculative-token "
