+                (cols[None, :] < VALID) & (kk[:, None] < K), other=0)
+    y = tl.dot(a, b)
+    tl.store(out + tl.program_id(0) * M * N + rows[:, None] * N + cols[None, :],
+             y, (rows[:, None] < M) & (cols[None, :] < N))
