diff --git a/vllm/models/qwen4_exp/intel_checkpoint.py b/vllm/models/qwen4_exp/intel_checkpoint.py
new file mode 100644
index 0000000000..7e5f966145
--- /dev/null
+++ b/vllm/models/qwen4_exp/intel_checkpoint.py
@@ -0,0 +1,52 @@
+# Copyright Wulf. Qwen model data remains under the Qwen Community License 1.0.
+"""Pinned Intel PLE layout and bounded private mapping; no model conversion."""
+import json
+import mmap
+import os
+import struct
+
+PLE_FILE = 'model-00016-of-00017.safetensors'
+PLE_PREFIX = 'model.language_model.layers.1.ple.ple_embedding.ngram_embedding.shard_'
+PLE_ROWS = 2500012
+PLE_WIDTH = 160
+PLE_SHARDS = 128
+PLE_BYTES = PLE_ROWS * PLE_WIDTH * 2
+PLE_OFFSET = 20736
+PLE_FILE_BYTES = 102400512256
+
+
+def ple_layout(path):
+    """Reject changed dtype, numeric shard order, gaps, overlaps and truncation."""
+    with open(path, 'rb') as stream:
+        if os.fstat(stream.fileno()).st_size != PLE_FILE_BYTES:
+            raise ValueError('Intel PLE file size differs from the pinned layout')
+        size = struct.unpack('<Q', stream.read(8))[0]
+        if size != PLE_OFFSET - 8:
+            raise ValueError('Intel PLE header size differs from the pinned layout')
+        header = json.loads(stream.read(size))
+    names = {PLE_PREFIX + str(i) + '.weight' for i in range(PLE_SHARDS)}
+    if set(header) - {'__metadata__'} != names:
+        raise ValueError('Intel PLE tensor inventory differs from the pinned layout')
+    for i in range(PLE_SHARDS):
+        entry = header[PLE_PREFIX + str(i) + '.weight']
+        if (entry['dtype'] != 'BF16' or entry['shape'] != [PLE_ROWS, PLE_WIDTH]
+                or entry['data_offsets'] != [i * PLE_BYTES, (i + 1) * PLE_BYTES]):
+            raise ValueError('Invalid Intel PLE numeric shard layout: ' + str(i))
+    if PLE_OFFSET + PLE_SHARDS * PLE_BYTES > PLE_FILE_BYTES:
+        raise ValueError('Intel PLE payload is truncated')
+    return PLE_OFFSET, PLE_SHARDS * PLE_ROWS, PLE_WIDTH
+
+
+def map_ple_table(path):
+    """Return tensor plus mapping owner; caller protects the mapping before use."""
+    import torch
+    offset, rows, width = ple_layout(path)
+    aligned = offset // mmap.ALLOCATIONGRANULARITY * mmap.ALLOCATIONGRANULARITY
+    delta = offset - aligned
+    with open(path, 'rb') as stream:
+        owner = mmap.mmap(stream.fileno(), delta + rows * width * 2,
+                          flags=mmap.MAP_PRIVATE, prot=mmap.PROT_READ | mmap.PROT_WRITE,
+                          offset=aligned)
+    table = torch.frombuffer(owner, dtype=torch.bfloat16, count=rows * width,
+                             offset=delta).view(rows, width)
+    return {'mapping': owner, 'table': table}
diff --git a/vllm/models/qwen4_exp/nvidia/b70_disk.py b/vllm/models/qwen4_exp/nvidia/b70_disk.py
new file mode 100644
index 0000000000..4bcf7d6d4e
--- /dev/null
+++ b/vllm/models/qwen4_exp/nvidia/b70_disk.py
@@ -0,0 +1,380 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Bounded BF16 Disk PLE ported from the corrected 1.0.4 release.
+
+The mapping, selected-row gather, TP ownership and DMA/graph lifetime fences
+retain the qualified semantics. v0.32 uses the split start/finalize API.
+"""
+
+import ctypes
+import os
+import threading
+from typing import ClassVar
+
+import torch
+
+from vllm.compilation.breakable_cudagraph import eager_break_during_capture
+from vllm.config import get_current_vllm_config
+from vllm.logger import init_logger
+from vllm.platforms import current_platform
+
+from ..common.ngram_embedding import (
+    Qwen4ExpPLEEmbedding,
+    Qwen4ExpPLEEmbeddingMethod,
+    Qwen4ExpPLEPinnedHostEmbedding,
+    Qwen4ExpPLEUnquantizedEmbeddingMethod,
+)
+
+logger = init_logger(__name__)
+_disk_bf16_quarantine: list[object] = []
+
+
+def _validate_disk_bf16_config(embedding_method, params_dtype, max_total_tokens):
+    config = get_current_vllm_config()
+    p, s = config.parallel_config, config.scheduler_config
+    if (
+        not current_platform.is_xpu()
+        or params_dtype != torch.bfloat16
+        or not isinstance(embedding_method, Qwen4ExpPLEUnquantizedEmbeddingMethod)
+        or not os.environ.get("PLE_TABLE_PATH")
+        or p.tensor_parallel_size != 4
+        or not p.enable_expert_parallel
+        or p.pipeline_parallel_size != 1
+        or p.data_parallel_size != 1
+        or p.use_ubatching
+        or p.use_sequence_parallel_moe
+        or p.enable_hc_sp
+        or p.decode_context_parallel_size != 1
+        or p.prefill_context_parallel_size != 1
+        or s.max_num_seqs != 4
+        or config.speculative_config is not None
+    ):
+        raise ValueError(
+            "Phase 1 Disk PLE requires target-only BF16 TP4+EP/PP1/DP1, four slots"
+        )
+    if any(
+        os.environ.get(n) == "1"
+        for n in (
+            "B70_PLE_DIRECT_PINNED",
+            "B70_PLE_FP8",
+            "B70_PLE_INT8",
+            "B70_PLE_INT8_NVME",
+            "B70_PLE_INT8_NVME_LOOKAHEAD",
+            "VLLM_PLE_CPU_OFFLOAD",
+        )
+    ):
+        raise ValueError("Conflicting PLE storage mode")
+    captures = config.compilation_config.cudagraph_capture_sizes or []
+    if (
+        max_total_tokens != s.max_num_batched_tokens
+        or max_total_tokens != 256
+        or any(n <= 0 or n > max_total_tokens for n in captures)
+    ):
+        raise ValueError(
+            "Phase 1 Disk PLE requires bounded 256-token dispatch/capture capacity"
+        )
+    return max_total_tokens
+
+
+def _protect_disk_bf16_mapping(table: torch.Tensor, path: str) -> None:
+    """Make the torch-owned file mapping read-only, without touching its pages."""
+    page_size = os.sysconf("SC_PAGE_SIZE")
+    start = table.data_ptr() // page_size * page_size
+    end = (
+        (table.data_ptr() + table.numel() * table.element_size() + page_size - 1)
+        // page_size
+        * page_size
+    )
+    stat = os.stat(path)
+    cursor = start
+    with open("/proc/self/maps") as maps:
+        for line in maps:
+            fields = line.split(maxsplit=5)
+            left, right = (int(value, 16) for value in fields[0].split("-"))
+            if right <= cursor or left >= end:
+                continue
+            major, minor = (int(value, 16) for value in fields[3].split(":"))
+            if (
+                left > cursor
+                or "p" not in fields[1]
+                or int(fields[4]) != stat.st_ino
+                or os.makedev(major, minor) != stat.st_dev
+            ):
+                raise ValueError(
+                    "PLE tensor is not a private mmap of the selected BF16 file"
+                )
+            cursor = min(right, end)
+    if cursor != end:
+        raise ValueError("PLE tensor mapping does not cover the selected BF16 table")
+    libc = ctypes.CDLL(None, use_errno=True)
+    libc.mprotect.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int]
+    libc.mprotect.restype = ctypes.c_int
+    if libc.mprotect(start, end - start, 1) != 0:  # PROT_READ
+        raise OSError(ctypes.get_errno(), "Cannot protect BF16 PLE mmap")
+
+
+class Qwen4ExpPLEDiskBF16Embedding(Qwen4ExpPLEPinnedHostEmbedding):
+    """Immutable torch mmap plus one serialized, bounded XPU DMA stage.
+
+    Only the producer changes. The inherited forward still reduces owned
+    contributions and copies into graph-owned output before GPU PLE math.
+    """
+
+    disk_bf16: ClassVar[bool] = True
+
+    def __init__(
+        self,
+        num_embeddings: int,
+        embedding_dim: int,
+        *,
+        params_dtype: torch.dtype,
+        padding_size: int,
+        prefix: str,
+        embedding_method: Qwen4ExpPLEEmbeddingMethod,
+        num_ngram_heads: int = 1,
+        max_total_tokens: int = 0,
+        data_parallel_rank: int = 0,
+        reduce_results: bool = True,
+    ) -> None:
+        capacity = _validate_disk_bf16_config(
+            embedding_method,
+            params_dtype,
+            max_total_tokens,
+        )
+        if (num_embeddings, embedding_dim, num_ngram_heads) != (320001536, 160, 16):
+            raise ValueError(
+                "Disk BF16 PLE supports only the original B70 table layout"
+            )
+        Qwen4ExpPLEEmbedding.__init__(
+            self,
+            num_embeddings,
+            embedding_dim,
+            params_dtype=params_dtype,
+            padding_size=padding_size,
+            prefix=prefix,
+            embedding_method=embedding_method,
+            num_ngram_heads=num_ngram_heads,
+            max_total_tokens=max_total_tokens,
+            data_parallel_rank=data_parallel_rank,
+            reduce_results=reduce_results,
+        )
+        if self.etp_data_parallel_size != 1 or self.tp_size != 4:
+            raise ValueError("Disk BF16 PLE requires ETP=TP=4")
+        self._stream_mod = torch.xpu
+        self._capacity = capacity
+        self._heads = num_ngram_heads
+        self._output_dim = num_ngram_heads * embedding_dim
+        self._prefetch_buffer = torch.empty(
+            capacity,
+            num_ngram_heads,
+            embedding_dim,
+            dtype=params_dtype,
+            device="xpu",
+        )
+        self._stage = torch.empty(
+            capacity,
+            num_ngram_heads,
+            embedding_dim,
+            dtype=params_dtype,
+            device="cpu",
+            pin_memory=True,
+        )
+        if not self._stage.is_pinned():
+            raise RuntimeError("Disk BF16 PLE stage failed to pin on XPU")
+        self._mmap_owner = None
+        self._table = None
+        self._pending = False
+        self._copy_event = torch.xpu.Event()
+        self._owner_stream = None
+        self._owner_thread = None
+        self._lock = threading.Lock()
+        self._failed = False
+        self._closed = False
+        self._generation = 0
+        self._prepared_tokens = 0
+
+    def allocate_embedding_weight(self, num_embeddings, embedding_dim, dtype):
+        # Metadata/loaded-name compatibility only: never reserve a TP shard.
+        return torch.empty(0, embedding_dim, dtype=dtype, device="cpu")
+
+    def weight_loader(self, *args, **kwargs) -> None:
+        raise RuntimeError("Disk BF16 PLE rejects checkpoint row-shards and reloads")
+
+    def load_mmap(self, path: str) -> None:
+        if self._mmap_owner is not None or self._closed or self._failed:
+            raise RuntimeError("Disk BF16 PLE rejects mmap reload")
+        from ..intel_checkpoint import map_ple_table
+
+        owner = map_ple_table(path)
+        table = owner["table"] if isinstance(owner, dict) else owner
+        if (
+            not isinstance(table, torch.Tensor)
+            or table.device.type != "cpu"
+            or table.dtype != torch.bfloat16
+            or tuple(table.shape) != (self.org_vocab_size, self.embedding_dim)
+            or not table.is_contiguous()
+            or table.requires_grad
+            or table.is_pinned()
+        ):
+            raise ValueError(
+                "Disk BF16 PLE requires an exact contiguous CPU BF16 table"
+            )
+        _protect_disk_bf16_mapping(table, path)
+        self._mmap_owner = owner
+        self._table = table
+        logger.info(
+            "Disk BF16 PLE mmap ready: shape=%s, capacity=%d, pinned_stage_bytes=%d, "
+            "weight_elements=%d, tp_range=[%d,%d)",
+            tuple(table.shape),
+            self._capacity,
+            self._stage.numel() * self._stage.element_size(),
+            self.weight.numel(),
+            self.shard_indices.org_vocab_start_index,
+            self.shard_indices.org_vocab_end_index,
+        )
+
+    def _check_capacity(self, num_tokens: int) -> None:
+        if not 0 <= num_tokens <= self._capacity:
+            raise ValueError(
+                f"Disk BF16 PLE stage overflow: {num_tokens} > {self._capacity}"
+            )
+        if self._closed or self._failed:
+            raise RuntimeError("Disk BF16 PLE stage is closed or quarantined")
+        if self._stream_mod.is_current_stream_capturing():
+            raise RuntimeError(
+                "Disk BF16 PLE host preparation cannot run inside capture"
+            )
+
+    def _wait_for_stage(self) -> None:
+        if self._pending:
+            try:
+                self._copy_event.synchronize()
+            except BaseException:
+                self._failed = True
+                _disk_bf16_quarantine.append(self)
+                raise
+            self._pending = False
+
+    def _fill_stage(self, ids_cpu: torch.Tensor, num_tokens: int) -> None:
+        """CPU-only selected-row gather; pads/non-owned contributions are zero."""
+        self._stage.zero_()
+        ids = ids_cpu[:num_tokens].reshape(-1)
+        if ids.numel() and (ids.min() < 0 or ids.max() >= self.org_vocab_size):
+            raise ValueError("Disk BF16 PLE received an out-of-table row ID")
+        owned = (ids >= self.shard_indices.org_vocab_start_index) & (
+            ids < self.shard_indices.org_vocab_end_index
+        )
+        # Advanced indexing allocates at most dispatch capacity, never a shard.
+        self._stage[:num_tokens].view(-1, self.embedding_dim)[owned] = self._table[
+            ids[owned]
+        ]
+
+    def prepare(
+        self, ngram_ids: torch.Tensor | None, num_tokens: int, num_tokens_padded: int
+    ) -> None:
+        """Refresh the fixed GPU producer outside forward, including FULL replay."""
+        self._check_capacity(num_tokens_padded)
+        if not 0 <= num_tokens <= num_tokens_padded:
+            raise ValueError("Disk BF16 PLE invalid actual/padded token counts")
+        if not self._lock.acquire(blocking=False):
+            raise RuntimeError("Concurrent Disk BF16 PLE stage preparation")
+        try:
+            stream = self._stream_mod.current_stream()
+            thread = threading.get_ident()
+            # The worker RPC loop serializes prepare -> forward/replay. Host
+            # ownership may change only between these submitted dispatches.
+            # Recheck after acquiring the lock: close/failure may have raced us.
+            self._check_capacity(num_tokens_padded)
+            self._wait_for_stage()  # CPU DMA source must be safe before refill.
+            if self._owner_stream is not None and (
+                stream != self._owner_stream or thread != self._owner_thread
+            ):
+                # The copy event precedes the model's GPU reads. Drain the OLD
+                # stream as well, including FULL replay which bypasses Python.
+                # This occurs only on ownership changes, outside capture; the
+                # ordinary same-owner path retains current-stream ordering.
+                try:
+                    self._owner_stream.synchronize()
+                except BaseException:
+                    self._failed = True
+                    _disk_bf16_quarantine.append(self)
+                    raise
+            # Publish the new owner only after both fences have succeeded.
+            self._owner_stream, self._owner_thread = stream, thread
+            if ngram_ids is None:
+                # Deterministic dummy contents before warmup/capture; no table IO.
+                self._stage.zero_()
+            else:
+                if (
+                    self._table is None
+                    or ngram_ids.dtype != torch.int64
+                    or tuple(ngram_ids.shape) != (num_tokens_padded, self._heads)
+                    or ngram_ids.device != self._prefetch_buffer.device
+                ):
+                    raise ValueError(
+                        "Disk BF16 PLE missing mmap or invalid dispatch IDs"
+                    )
+                ids_cpu = ngram_ids.to(device="cpu", non_blocking=False)
+                self._fill_stage(ids_cpu, num_tokens)
+            if num_tokens_padded:
+                # Same-stream ordering prevents overwrite while a previous graph
+                # reads the GPU buffer. The event protects the CPU source.
+                self._pending = True
+                try:
+                    self._prefetch_buffer[:num_tokens_padded].copy_(
+                        self._stage[:num_tokens_padded],
+                        non_blocking=True,
+                    )
+                    self._copy_event.record(stream)
+                except BaseException:
+                    self._failed = True
+                    _disk_bf16_quarantine.append(self)
+                    raise
+            self._generation += 1
+            self._prepared_tokens = num_tokens_padded
+        finally:
+            self._lock.release()
+
+    def start_prefetch(self, ngram_ids) -> None:
+        return None
+
+    @eager_break_during_capture
+    def _finalize_prefetch(self, prefetch_output, output) -> None:
+        if self._closed or self._failed or self._prepared_tokens != output.shape[0]:
+            raise RuntimeError(
+                "Disk BF16 PLE consumer has no matching prepared dispatch"
+            )
+        embeddings = self._reduce_etp_embeddings(prefetch_output[: output.shape[0]])
+        output.copy_(embeddings.flatten(-2))
+
+    def finalize_prefetch(self, total_tokens: int) -> torch.Tensor:
+        output = self._prefetch_buffer.new_empty((total_tokens, self._output_dim))
+        self._finalize_prefetch(self._prefetch_buffer, output)
+        return output
+
+    def close(self) -> None:
+        # Worker lifetime owns all buffers. Explicit teardown fences before free.
+        if getattr(self, "_closed", True):
+            return
+        if not self._lock.acquire(blocking=False):
+            raise RuntimeError("Cannot close a busy Disk BF16 PLE stage")
+        try:
+            if self._failed:
+                raise RuntimeError("Cannot release a quarantined Disk BF16 PLE stage")
+            self._wait_for_stage()
+            # Also drain graph readers of the GPU destination.
+            if self._owner_stream is not None:
+                try:
+                    self._owner_stream.synchronize()
+                except BaseException:
+                    self._failed = True
+                    _disk_bf16_quarantine.append(self)
+                    raise
+            self._closed = True
+        finally:
+            self._lock.release()
+
+    def __del__(self):
+        try:
+            self.close()
+        except BaseException:
+            _disk_bf16_quarantine.append(self)
diff --git a/vllm/models/qwen4_exp/nvidia/b70_hyperconnection.py b/vllm/models/qwen4_exp/nvidia/b70_hyperconnection.py
new file mode 100644
index 0000000000..0f426693b6
--- /dev/null
+++ b/vllm/models/qwen4_exp/nvidia/b70_hyperconnection.py
@@ -0,0 +1,315 @@
+# Modified by Wulf for B70 Flash-Next Disk; upstream terms are retained.
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""HyperConnection (Gated Residual) utilities — NVIDIA model variant.
+
+Implements the HyperConnection residual scheme proposed in
+"HyperConnections" (https://arxiv.org/abs/2409.19606). This NVIDIA variant
+delays each HC combine to the following HC mix boundary. HC glue kernels,
+including fused combine+RMSNorm, live in ``ops/hc.py``; projections remain
+standard vLLM Linear modules.
+
+Hidden states between layers have shape ``[..., HC*HS]`` with HS inner
+(HC outer, HS inner — checkpoint-native layout).
+
+Typical usage inside a transformer decoder layer::
+
+    self.attn_hc = GatedResidual(hc_config)
+
+    hidden_states, block_input, injection = self.attn_hc.mix(hidden_states)
+    attention_output = attention(block_input)
+    hidden_states, block_input, injection = self.mlp_hc.combine_and_mix(
+        hidden_states, attention_output, injection
+    )
+"""
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+from vllm.logger import init_logger
+from vllm.model_executor.layers.linear import (
+    MergedColumnParallelLinear,
+    ReplicatedLinear,
+)
+from vllm.model_executor.models.utils import maybe_prefix
+
+from ..common.hyperconnection import (
+    GroupedGemmaRMSNorm,
+    HyperConnectionConfig,
+)
+from .ops.hc import (
+    grouped_gemma_rmsnorm,
+    hc_combine,
+    hc_combine_norm,
+    hc_gate_mix,
+    hc_silu,
+)
+
+logger = init_logger(__name__)
+
+
+def _is_xpu() -> bool:
+    from vllm.platforms import current_platform
+
+    return current_platform.is_xpu()
+
+
+# ---------------------------------------------------------------------------
+# XPU HC down-GEMM determinism (K-split)
+#
+# The skinny BF16 HC down projection (K = hyper_hidden_size = 10240 -> N in
+# {336 merged, 320 final mixer}) is run-to-run racy on XPU for row widths
+# > 64: the oneDNN accumulation re-samples its split-K draw every execution,
+# which is what made PIECEWISE-256 prefill replay diverge from eager
+# (bitwise-equal inputs, few-ULP output flips). Replacing the single GEMM
+# with two K=5120 GEMMs over contiguous weight halves is bitwise-deterministic
+# in eager, fresh-clone and graph capture+replay at every width tested
+# (M in {64, 128, 256}; 0/512 flips at M=256). See
+# docs/HC_DOWN_GEMM_FIX_RECON.md for the offline campaign.
+#
+# Widths <= 64 keep the stock single GEMM (bitwise-clean there, and decode
+# graphs never exceed 8 rows, so M1 FULL decode keeps stock numerics).
+# CUDA is untouched: the halves are prepared only on XPU
+# (UnquantizedLinearMethod.process_weights_after_loading calls the
+# ``hc_ksplit_prepare`` marker set below), so the split branch is never
+# armed on non-XPU platforms.
+# ---------------------------------------------------------------------------
+_HC_KSPLIT_MAX_STOCK_WIDTH = 64
+_HC_KSPLIT_WIDTHS_LOGGED: set[int] = set()
+
+
+# ---------------------------------------------------------------------------
+# Gated-residual variant
+# ---------------------------------------------------------------------------
+class GatedResidual(nn.Module):
+    """Gated HyperConnection with learnable low-rank mixing and injection.
+
+    ``combine_and_mix()`` runs the pre pipeline (grouped GemmaRMSNorm -> merged
+    low-rank down+inject GEMM -> silu -> up GEMM -> sigmoid -> gated mean
+    over the HC streams). When passed a pending block output, it fuses its
+    residual combine with the RMSNorm. A missing injection selects unit-weight
+    combine. Final mixers use ``use_combine=False`` and do not produce a new
+    injection.
+
+    Weights: the norm owns the grouped GemmaRMSNorm affine; the projections
+    are vLLM Linear modules (merged replicated linear for down+inject), so
+    GEMM dispatch (e.g. the low-latency skinny GEMM) applies through the
+    standard quant_method mechanism.
+    """
+
+    def __init__(
+        self,
+        config: HyperConnectionConfig,
+        use_combine: bool = True,
+        prefix: str = "",
+    ) -> None:
+        super().__init__()
+        self.config = config
+        self.lora_rank = config.hc_lowrank
+        self.hc_count = config.hc_count
+        self.hidden_size = config.hidden_size
+        self.use_combine = use_combine
+
+        norm_size = (
+            self.hyper_hidden_size if config.hc_per_branch_norm else config.hidden_size
+        )
+        group_size = config.hidden_size if config.hc_per_branch_norm else None
+        # Normalize each H-sized HC stream independently while retaining a
+        # separate affine weight for every element of the HC*H layout.
+        self.hc_norm = GroupedGemmaRMSNorm(
+            norm_size,
+            eps=config.rms_norm_eps,
+            group_size=group_size,
+            dtype=config.params_dtype,
+        )
+
+        # -- vLLM Linear weights --------------------------------------------
+        # The merged skinny-GEMM shape is physically padded to 16 rows to ensure
+        # good alignment and performant implementation chosen by CuBLAS heuristics.
+        self.pad_size = (-(self.lora_rank + self.hc_count)) % 16 if use_combine else 0
+        if use_combine:
+            self.input_mix_weight_down_block_inject = MergedColumnParallelLinear(
+                self.hyper_hidden_size,
+                [self.lora_rank, self.hc_count]
+                + ([self.pad_size] if self.pad_size else []),
+                bias=False,
+                params_dtype=config.params_dtype,
+                quant_config=None,
+                prefix=maybe_prefix(prefix, "input_mix_weight_down_block_inject"),
+                return_bias=False,
+                disable_tp=True,
+            )
+        else:
+            self.input_mix_weight_down = ReplicatedLinear(
+                self.hyper_hidden_size,
+                self.lora_rank,
+                bias=False,
+                params_dtype=config.params_dtype,
+                quant_config=None,
+                prefix=maybe_prefix(prefix, "input_mix_weight_down"),
+                return_bias=False,
+            )
+        self.input_mix_weight_up = ReplicatedLinear(
+            self.lora_rank,
+            self.hyper_hidden_size,
+            bias=False,
+            params_dtype=config.params_dtype,
+            quant_config=None,
+            prefix=maybe_prefix(prefix, "input_mix_weight_up"),
+            return_bias=False,
+        )
+
+        # -- XPU deterministic K-split state --------------------------------
+        # Contiguous K=5120 halves of the down weight, prepared once at load
+        # time on XPU only (see _prepare_kdown_ksplit). ``None`` everywhere
+        # else, which keeps the stock single GEMM armed.
+        self._kdown_lo: torch.Tensor | None = None
+        self._kdown_hi: torch.Tensor | None = None
+        self._kdown_k = 0
+        down_linear = (
+            self.input_mix_weight_down_block_inject
+            if use_combine
+            else self.input_mix_weight_down
+        )
+        # Marker consumed by
+        # UnquantizedLinearMethod.process_weights_after_loading (XPU only).
+        down_linear.hc_ksplit_prepare = self._prepare_kdown_ksplit
+
+    def _prepare_kdown_ksplit(self) -> None:
+        """One-time contiguous K-half prep for the deterministic XPU split."""
+        if self._kdown_lo is not None:
+            return
+        down_linear = (
+            self.input_mix_weight_down_block_inject
+            if self.use_combine
+            else self.input_mix_weight_down
+        )
+        weight = down_linear.weight
+        if weight is None or weight.ndim != 2 or weight.shape[1] % 2 != 0:
+            logger.debug(
+                "HC down GEMM %s: unexpected weight geometry %s; K-split left disarmed",
+                type(down_linear).__name__,
+                None if weight is None else tuple(weight.shape),
+            )
+            return
+        self._kdown_k = weight.shape[1] // 2
+        self._kdown_lo = weight.data[:, : self._kdown_k].contiguous()
+        self._kdown_hi = weight.data[:, self._kdown_k :].contiguous()
+        logger.debug(
+            "HC down GEMM: K-split halves prepared (K=%d -> 2x%d, N=%d)",
+            weight.shape[1],
+            self._kdown_k,
+            weight.shape[0],
+        )
+
+    def _down_gemm(self, xn: torch.Tensor) -> torch.Tensor:
+        """Down projection; width-gated deterministic K-split on XPU.
+
+        Row widths <= 64 (all decode graphs) keep the stock single GEMM,
+        which is bitwise-clean there. Wider rows (prefill chunks) take the
+        two-GEMM split over the contiguous K-halves. The branch conditions
+        are shape/attribute reads only, so stream capture bakes the correct
+        arm per graph and replays deterministically.
+        """
+        if (
+            self._kdown_lo is not None
+            and _is_xpu()
+            and xn.shape[0] > _HC_KSPLIT_MAX_STOCK_WIDTH
+        ):
+            width = xn.shape[0]
+            if width not in _HC_KSPLIT_WIDTHS_LOGGED:
+                _HC_KSPLIT_WIDTHS_LOGGED.add(width)
+                logger.info(
+                    "HC down GEMM: deterministic K-split engaged at row width "
+                    "%d (stock single GEMM kept for widths <= %d)",
+                    width,
+                    _HC_KSPLIT_MAX_STOCK_WIDTH,
+                )
+            return F.linear(xn[..., : self._kdown_k], self._kdown_lo) + F.linear(
+                xn[..., self._kdown_k :], self._kdown_hi
+            )
+        if self.use_combine:
+            return self.input_mix_weight_down_block_inject(xn)
+        return self.input_mix_weight_down(xn)
+
+    def mix(
+        self, hidden_states: torch.Tensor
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor | None]:
+        xn = grouped_gemma_rmsnorm(
+            hidden_states,
+            self.hc_norm.weight,
+            self.config.rms_norm_eps,
+            self.hc_count,
+        )
+
+        if self.use_combine:
+            # produce injection logits for combine
+            split_sizes = [self.lora_rank, self.hc_count, self.pad_size]
+            down_and_injection = self._down_gemm(xn)
+            lora, injection, _ = down_and_injection.split(split_sizes, dim=-1)
+        else:
+            lora = self._down_gemm(xn)
+            injection = None
+
+        lora = hc_silu(lora, self.hc_count)
+        gate = self.input_mix_weight_up(lora)  # [M, D]
+        block_input = hc_gate_mix(xn, gate, self.hc_count)
+
+        return hidden_states, block_input, injection
+
+    def combine_and_mix(
+        self,
+        hidden_states: torch.Tensor,
+        prev_block_output: torch.Tensor,
+        prev_injection: torch.Tensor | None,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor | None]:
+        """Consume a pending combine, then prepare the next block input.
+
+        ``hidden_states`` is the multi-stream state from before the pending
+        block's mix. Its combine with ``block_output`` is fused with this
+        module's input RMSNorm. A missing injection applies the block output
+        to every stream with unit weight.
+        """
+        hidden_states, xn = hc_combine_norm(
+            hidden_states,
+            prev_block_output,
+            prev_injection,
+            self.hc_norm.weight,
+            self.config.rms_norm_eps,
+            self.hc_count,
+        )
+
+        if self.use_combine:
+            # produce injection logits for combine
+            split_sizes = [self.lora_rank, self.hc_count, self.pad_size]
+            down_and_injection = self._down_gemm(xn)
+            lora, injection, _ = down_and_injection.split(split_sizes, dim=-1)
+        else:
+            lora = self._down_gemm(xn)
+            injection = None
+
+        lora = hc_silu(lora, self.hc_count)
+        gate = self.input_mix_weight_up(lora)  # [M, D]
+        block_input = hc_gate_mix(xn, gate, self.hc_count)
+
+        return hidden_states, block_input, injection
+
+    def combine(
+        self,
+        hidden_states: torch.Tensor,
+        block_output: torch.Tensor,
+        injection: torch.Tensor | None,
+    ) -> torch.Tensor:
+        return hc_combine(hidden_states, block_output, injection, self.hc_count)
+
+    @property
+    def hyper_hidden_size(self) -> int:
+        return self.hc_count * self.hidden_size
+
+
+__all__ = [
+    "GatedResidual",
+    "GroupedGemmaRMSNorm",
+    "HyperConnectionConfig",
+]
