The C++ part of vllm-project/vllm-xpu-kernels#660 ("[GDN] Skip rows whose state index is NULL_BLOCK_ID", fixes #659),
for wu1ff's libgdn_index64.so. vLLM 0.32 runs the GDN attention op from that library, not from the wheel, so the
fix has to go into its copy of the kernel headers: apply this patch inside
model-packs/Qwen3.8-Flash-Next/patches/production/dependencies/gdn-headers of wu1ff/B70-LLM-Controller @ 5e5cf43
(patch -p1), then build libgdn_index64.so with wu1ff's native build recipe. Apache-2.0 (vllm-xpu-kernels).

diff --git a/csrc/xpu/gdn_attn/causal_conv1d.hpp b/csrc/xpu/gdn_attn/causal_conv1d.hpp
index b533cf9..cac230e 100644
--- a/csrc/xpu/gdn_attn/causal_conv1d.hpp
+++ b/csrc/xpu/gdn_attn/causal_conv1d.hpp
@@ -164,7 +164,7 @@ struct causal_conv1d_kernel {
     // get states cache location
     int states_id = cache_indices[batch_id];
 
-    if (states_id == pad_slot_id) {
+    if (states_id <= pad_slot_id) {
       return;
     }
 
@@ -685,7 +685,7 @@ struct causal_conv1d_spec_kernel {
     // cannot be used to recover this dimension.
     const int state_len = Width - 1 + (num_spec_tokens - 1);
     const int state_id = cache_indices[batch_id * cache_indices_stride_0 + 0];
-    const bool has_conv_state = (state_id != pad_slot_id);
+    const bool has_conv_state = (state_id > pad_slot_id);
     T* state_line_ptr = has_conv_state
                             ? conv_states + state_id * conv_states_stride_0
                             : nullptr;
diff --git a/csrc/xpu/gdn_attn/gated_delta_rule.hpp b/csrc/xpu/gdn_attn/gated_delta_rule.hpp
