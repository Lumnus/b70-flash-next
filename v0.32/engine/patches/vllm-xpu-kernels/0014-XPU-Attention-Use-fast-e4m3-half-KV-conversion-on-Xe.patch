From 4dc8b71b1671092b2f156c5bea13b383cf6fda9a Mon Sep 17 00:00:00 2001
From: riceharvest <myappleiddarimaan@gmail.com>
Date: Mon, 12 Oct 2026 13:02:19 +0200
Subject: [PATCH 14/15] [XPU][Attention] Use fast e4m3->half KV conversion on
 Xe2

Enable SYCL-TLA's opt-in CUTE_XE_E4M3_HALF_UNSCALED reorder for
attn_kernels_xe_2 and fold its 2^-8 output scale into the softmax scale
(K) and the post-loop output scale (V) in the chunk-prefill and decode
mainloops (fp16 Q, e4m3 K/V only). No-op until CUTLASS_REVISION
includes the SYCL-TLA option.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: riceharvest <myappleiddarimaan@gmail.com>

diff --git a/csrc/xpu/attn/xe_2/CMakeLists.txt b/csrc/xpu/attn/xe_2/CMakeLists.txt
index 83f1719..38a82f3 100644
--- a/csrc/xpu/attn/xe_2/CMakeLists.txt
+++ b/csrc/xpu/attn/xe_2/CMakeLists.txt
@@ -8,3 +8,7 @@ include("paged_decode_configure.cmake")
 paged_decode_configure(paged_decode_kernel_template)
 
 add_xe2_kernel_library(attn_kernels_xe_2 INCLUDE_CMAKE_SOURCE_DIR)
+# Fast e4m3 -> half reorder in SYCL-TLA (no NaN propagation, output scaled by
+# 2^-8); the FMHA mainloops fold the 256 into the softmax and V scales. KV
+# caches never hold NaN. No-op with SYCL-TLA versions that lack the option.
+target_compile_definitions(attn_kernels_xe_2 PRIVATE CUTE_XE_E4M3_HALF_UNSCALED)
diff --git a/csrc/xpu/attn/xe_2/collective/chunk_prefill_mainloop.hpp b/csrc/xpu/attn/xe_2/collective/chunk_prefill_mainloop.hpp
index fd8a1eb..1416257 100644
--- a/csrc/xpu/attn/xe_2/collective/chunk_prefill_mainloop.hpp
+++ b/csrc/xpu/attn/xe_2/collective/chunk_prefill_mainloop.hpp
@@ -511,6 +511,22 @@ struct FMHAFwdMainloop<
       const float scale_k = *static_cast<const float*>(params.scale_k);
       scale_v = *static_cast<const float*>(params.scale_v);
       effective_scale = params.scale * ElementS(scale_k);
+#ifdef CUTE_XE_E4M3_HALF_UNSCALED_ACTIVE
+      // The fast e4m3 -> half reorder yields value * 2^-8; fold the 256 back
+      // into the same two scales.
+      if constexpr (
+          std::is_same_v<ElementQ, half_t> &&
+          std::is_same_v<ElementK, float_e4m3_t>) {
+        effective_scale *= ElementS(256.f);
+      }
+      if constexpr (
+          std::is_same_v<ElementQ, half_t> &&
+          std::is_same_v<
+              typename TensorV::engine_type::value_type,
+              float_e4m3_t>) {
+        scale_v *= 256.f;
+      }
+#endif
     }
 
     [[maybe_unused]] auto route_current = [&](int cur) -> int {
@@ -1252,6 +1268,22 @@ struct DecodeFwdMainloop<
       const float scale_k = *static_cast<const float*>(params.scale_k);
       scale_v = *static_cast<const float*>(params.scale_v);
       effective_scale = params.scale * ElementS(scale_k);
+#ifdef CUTE_XE_E4M3_HALF_UNSCALED_ACTIVE
+      // The fast e4m3 -> half reorder yields value * 2^-8; fold the 256 back
+      // into the same two scales.
+      if constexpr (
+          std::is_same_v<ElementQ, half_t> &&
+          std::is_same_v<ElementK, float_e4m3_t>) {
+        effective_scale *= ElementS(256.f);
+      }
+      if constexpr (
+          std::is_same_v<ElementQ, half_t> &&
+          std::is_same_v<
+              typename TensorV::engine_type::value_type,
+              float_e4m3_t>) {
+        scale_v *= 256.f;
+      }
+#endif
     }
 
     // INT8 KV helpers (only instantiated for int8 K/V; see Arguments).
