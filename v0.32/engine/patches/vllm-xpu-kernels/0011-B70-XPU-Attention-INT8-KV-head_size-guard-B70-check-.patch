diff --git a/tests/flash_attn/int8_kv_b70_check.py b/tests/flash_attn/int8_kv_b70_check.py
new file mode 100644
index 0000000..03f420b
--- /dev/null
+++ b/tests/flash_attn/int8_kv_b70_check.py
@@ -0,0 +1,269 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""INT8 per-token-head KV on the Xe2 FA kernels: B70 check for Qwen hybrid shapes.
+
+Standalone (no pytest). Runs on one XPU device and prints, per case, the
+relative error and cosine of the kernel output against an fp32 reference
+computed on the same quantized cache, plus decode timings INT8 vs bf16 KV.
+
+Cases (head_size 256, bf16 Q/out):
+  1. decode       q_len 1 per sequence, native INT8 paged decode
+  2. spec decode  uniform q_len 8 (DFlash K=7 verify), kernels' split-K route
+  3. prefill      dequantize the referenced blocks to a bf16 paged scratch,
+                  stock chunk-prefill kernel (what the vLLM glue does)
+over num_kv_heads {2, 4}, GQA {8, 6}, block_size {64, 832, 4352}, several
+sequences of random lengths (some crossing block boundaries), random block
+placement, and garbage in unused slots/scales.
+
+Usage: python int8_kv_b70_check.py [--device xpu:0] [--quick] [--bench]
+Exit code 0 iff every case passes (rel err <= 0.03 and cos >= 0.999).
+"""
+
+import argparse
+import math
+import sys
+import time
+
+import torch
+
+from vllm_xpu_kernels.flash_attn_interface import flash_attn_varlen_func
+
+REL_TOL = 0.03
+COS_TOL = 0.999
+
+
+def quantize_per_token_head(x: torch.Tensor):
+    """vLLM int8_per_token_head writer semantics (fp32): scale = absmax/127
+    (>= 1e-6), round half away from zero, clamp [-128, 127]."""
+    xf = x.float()
+    scale = torch.clamp(xf.abs().amax(-1) / 127.0, min=1e-6)
+    y = xf * (1.0 / scale)[..., None]
+    y = torch.where(y >= 0, y + 0.5, y - 0.5).clamp(-128.0, 127.0).trunc()
+    return y.to(torch.int8), scale
+
+
+def split_layout_views(raw, block_size, nkv, hs):
+    """Block-local split layout over raw [nb, page] uint8 (page may be padded):
+    [int8 K|V (slot, head) | K scales fp32 | V scales fp32]."""
+    nb, page = raw.shape
+    data = block_size * nkv * 2 * hs
+    sb = block_size * nkv * 4
+    assert page >= data + 2 * sb and page % 64 == 0
+    d = torch.as_strided(raw.view(torch.int8), (nb, block_size, nkv, 2 * hs),
+                         (page, nkv * 2 * hs, 2 * hs, 1))
+    f = raw.view(torch.float32)
+
+    def scales(off):
+        return torch.as_strided(f, (nb, block_size, nkv), (page // 4, nkv, 1),
+                                f.storage_offset() + off // 4)
+
+    return d[..., :hs], d[..., hs:], scales(data), scales(data + sb)
+
+
+def ref_attn(q, k, v, scale, q_pos):
+    """q [Lq, Hq, D] fp32, k/v [L, Hkv, D] fp32 (dequantized), causal at q_pos."""
+    g = q.shape[1] // k.shape[1]
+    k, v = k.repeat_interleave(g, 1), v.repeat_interleave(g, 1)
+    kpos = torch.arange(k.shape[0], device=q.device)
+    outs = []
+    for i in range(0, q.shape[0], 128):  # bound the fp32 score memory
+        s = torch.einsum("qhd,khd->hqk", q[i:i + 128], k) * scale
+        mask = kpos[None, :] <= q_pos[i:i + 128, None]
+        s = s.masked_fill(~mask[None], float("-inf"))
+        outs.append(torch.einsum("hqk,khd->qhd", torch.softmax(s, -1), v))
+    return torch.cat(outs)
+
+
+def metrics(out, ref):
+    o, r = out.float().flatten(), ref.float().flatten()
+    rel = ((o - r).norm() / r.norm().clamp_min(1e-12)).item()
+    cos = torch.nn.functional.cosine_similarity(o, r, dim=0).item()
+    finite = bool(torch.isfinite(o).all())
+    return rel, cos, finite
+
+
+def build_cache(dev, seq_lens, block_size, nkv, hs, pad_page=0, seed=0):
+    g = torch.Generator(device="cpu").manual_seed(seed)
+    nblk = [math.ceil(L / block_size) for L in seq_lens]
+    num_blocks = sum(nblk) + 3
+    page = 2 * (hs + 4) * nkv * block_size + pad_page
+    # Garbage everywhere (NaN-ish bytes in unused scale slots included).
+    raw = torch.randint(0, 256, (num_blocks, page), dtype=torch.uint8,
+                        generator=g).to(dev)
+    kc, vc, ks, vs = split_layout_views(raw, block_size, nkv, hs)
+    perm = (torch.randperm(num_blocks - 1, generator=g) + 1).to(torch.int32)
+    bt = torch.zeros(len(seq_lens), max(nblk), dtype=torch.int32)
+    keys, vals, c = [], [], 0
+    for i, (L, n) in enumerate(zip(seq_lens, nblk)):
+        bt[i, :n] = perm[c:c + n]
+        c += n
+        key = torch.randn(L, nkv, hs, generator=g) * 2
+        key[:, :, 7] *= 20  # outlier channel, like real K
+        val = torch.randn(L, nkv, hs, generator=g)
+        key, val = key.to(dev, torch.bfloat16), val.to(dev, torch.bfloat16)
+        pos = torch.arange(L, device=dev)
+        b = bt[i].to(dev)[pos // block_size].long()
+        o = pos % block_size
+        kq, kscale = quantize_per_token_head(key)
+        vq, vscale = quantize_per_token_head(val)
+        kc[b, o], vc[b, o], ks[b, o], vs[b, o] = kq, vq, kscale, vscale
+        keys.append(kq.float() * kscale[..., None])
+        vals.append(vq.float() * vscale[..., None])
+    return (raw, kc, vc, ks, vs, bt.to(dev), keys, vals, nblk)
+
+
+def dequant_scratch(kc, vc, ks, vs, bt, seq_lens, nblk, block_size, dtype):
+    """Compact bf16 paged scratch [sum nblk, bs, H, 2D] + remapped block table;
+    slots past each sequence end zeroed (the vLLM glue's semantics)."""
+    nkv, hs = kc.shape[2], kc.shape[3]
+    total = sum(nblk)
+    sc = torch.zeros(total, block_size, nkv, 2 * hs, dtype=dtype,
+                     device=kc.device)
+    new_bt = torch.zeros(len(seq_lens), max(nblk), dtype=torch.int32,
+                         device=kc.device)
+    off = 0
+    for i, (L, n) in enumerate(zip(seq_lens, nblk)):
+        for j in range(n):
+            src = int(bt[i, j])
+            live = min(block_size, L - j * block_size)
+            sc[off + j, :live, :, :hs] = (kc[src, :live].float() *
+                                          ks[src, :live, :, None]).to(dtype)
+            sc[off + j, :live, :, hs:] = (vc[src, :live].float() *
+                                          vs[src, :live, :, None]).to(dtype)
+        new_bt[i, :n] = torch.arange(off, off + n, dtype=torch.int32)
+        off += n
+    return sc, new_bt
+
+
+def run_case(dev, mode, nkv, gqa, block_size, seq_lens, hs=256, seed=0):
+    hq = nkv * gqa
+    raw, kc, vc, ks, vs, bt, keys, vals, nblk = build_cache(
+        dev, seq_lens, block_size, nkv, hs, pad_page=128 if block_size > 64
+        else 0, seed=seed)
+    q_len = {"decode": 1, "spec": 8, "prefill": None}[mode]
+    if q_len is None:  # prefill: the last chunk of each sequence
+        chunks = [512, 300, 2048, 77, 129]
+        q_lens = [min(L, chunks[i % 5]) for i, L in enumerate(seq_lens)]
+    else:
+        q_lens = [q_len] * len(seq_lens)
+    g = torch.Generator(device="cpu").manual_seed(seed + 1)
+    q = torch.randn(sum(q_lens), hq, hs, generator=g).to(dev, torch.bfloat16)
+    cu_q = torch.tensor([0] + torch.tensor(q_lens).cumsum(0).tolist(),
+                        dtype=torch.int32, device=dev)
+    seqused = torch.tensor(seq_lens, dtype=torch.int32, device=dev)
+    scale = hs**-0.5
+    out = torch.empty_like(q)
+    if mode == "prefill":
+        sc, sbt = dequant_scratch(kc, vc, ks, vs, bt, seq_lens, nblk,
+                                  block_size, torch.bfloat16)
+        flash_attn_varlen_func(q, sc[..., :hs], sc[..., hs:], max(q_lens),
+                               cu_q, max(seq_lens), seqused_k=seqused,
+                               softmax_scale=scale, causal=True,
+                               block_table=sbt, out=out)
+    else:
+        flash_attn_varlen_func(q, kc, vc, max(q_lens), cu_q, max(seq_lens),
+                               seqused_k=seqused, softmax_scale=scale,
+                               causal=True, block_table=bt, out=out,
+                               k_descale=ks, v_descale=vs)
+    torch.xpu.synchronize(dev)
+    ref = []
+    for i, (L, ql) in enumerate(zip(seq_lens, q_lens)):
+        q0 = int(cu_q[i])
+        ref.append(ref_attn(q[q0:q0 + ql].float(), keys[i], vals[i], scale,
+                            torch.arange(L - ql, L, device=dev)))
+    return metrics(out, torch.cat(ref))
+
+
+def bench_decode(dev, nkv, gqa, block_size, ctx, batch, iters=50, hs=256):
+    """Decode kernel time, INT8 KV vs bf16 KV, same shapes."""
+    hq = nkv * gqa
+    nb_per = math.ceil(ctx / block_size)
+    nb = nb_per * batch + 1
+    bt = (torch.arange(nb_per * batch, dtype=torch.int32, device=dev) +
+          1).view(batch, nb_per)
+    q = torch.randn(batch, hq, hs, device=dev, dtype=torch.bfloat16)
+    cu = torch.arange(batch + 1, dtype=torch.int32, device=dev)
+    su = torch.full((batch, ), ctx, dtype=torch.int32, device=dev)
+    out = torch.empty_like(q)
+    page = 2 * (hs + 4) * nkv * block_size
+    raw = torch.randint(-20, 20, (nb, page), dtype=torch.int8,
+                        device=dev).view(torch.uint8)
+    kc, vc, ks, vs = split_layout_views(raw, block_size, nkv, hs)
+    ks.fill_(0.01)
+    vs.fill_(0.01)
+    fp = torch.randn(nb, block_size, nkv, 2 * hs, device=dev,
+                     dtype=torch.bfloat16)
+    res = {}
+    for name, (k, v, kd, vd) in {
+            "int8": (kc, vc, ks, vs),
+            "bf16": (fp[..., :hs], fp[..., hs:], None, None)
+    }.items():
+        for _ in range(5):
+            flash_attn_varlen_func(q, k, v, 1, cu, ctx, seqused_k=su,
+                                   causal=True, block_table=bt, out=out,
+                                   k_descale=kd, v_descale=vd)
+        torch.xpu.synchronize(dev)
+        t0 = time.perf_counter()
+        for _ in range(iters):
+            flash_attn_varlen_func(q, k, v, 1, cu, ctx, seqused_k=su,
+                                   causal=True, block_table=bt, out=out,
+                                   k_descale=kd, v_descale=vd)
+        torch.xpu.synchronize(dev)
+        res[name] = (time.perf_counter() - t0) / iters * 1e6
+    return res
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--device", default="xpu:0")
+    ap.add_argument("--quick", action="store_true")
+    ap.add_argument("--bench", action="store_true")
+    a = ap.parse_args()
+    dev = torch.device(a.device)
+    torch.xpu.set_device(dev)
+
+    heads = [(2, 8), (4, 6)] if not a.quick else [(2, 8)]
+    blocks = [64, 832, 4352] if not a.quick else [64, 4352]
+    seq_sets = {
+        64: [17, 1000, 4097, 129],
+        832: [833, 5000, 70, 12000],
+        4352: [4353, 9000, 300, 20000],
+    }
+    fails = 0
+    print(f"{'mode':8} {'nkv':>3} {'gqa':>3} {'block':>5} {'rel_err':>9} "
+          f"{'cos':>9}  result")
+    for mode in ("decode", "spec", "prefill"):
+        for nkv, gqa in heads:
+            for bs in blocks:
+                for seed in (0, 1):
+                    lens = seq_sets[bs]
+                    if seed:  # random lengths, at least 8 tokens
+                        gg = torch.Generator().manual_seed(bs + nkv)
+                        lens = (torch.randint(8, 3 * bs + 40, (5, ),
+                                              generator=gg)).tolist()
+                    try:
+                        rel, cos, fin = run_case(dev, mode, nkv, gqa, bs,
+                                                 lens, seed=seed)
+                        ok = fin and rel <= REL_TOL and cos >= COS_TOL
+                    except Exception as e:  # noqa: BLE001
+                        rel, cos, ok = float("nan"), float("nan"), False
+                        print(f"  EXC {type(e).__name__}: {e}")
+                    fails += not ok
+                    print(f"{mode:8} {nkv:>3} {gqa:>3} {bs:>5} {rel:9.5f} "
+                          f"{cos:9.6f}  {'OK' if ok else 'FAIL'}  lens={lens}")
+    if a.bench:
+        print("\ndecode kernel time per call (us), batch x ctx, INT8 vs bf16")
+        for nkv, gqa in heads:
+            for bs in (64, 4352):
+                for batch, ctx in ((1, 8192), (1, 32768), (1, 131072),
+                                   (8, 32768)):
+                    r = bench_decode(dev, nkv, gqa, bs, ctx, batch)
+                    print(f"nkv={nkv} gqa={gqa} bs={bs:5} b={batch} "
+                          f"ctx={ctx:6}: int8 {r['int8']:8.1f}  bf16 "
+                          f"{r['bf16']:8.1f}  ratio {r['int8']/r['bf16']:.2f}")
+    print(f"\n{'PASS' if fails == 0 else f'FAIL ({fails} cases)'}")
+    sys.exit(1 if fails else 0)
+
+
+if __name__ == "__main__":
+    main()
