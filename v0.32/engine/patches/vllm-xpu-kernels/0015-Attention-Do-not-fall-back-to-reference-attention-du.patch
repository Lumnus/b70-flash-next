From 41318478587498e4f158910c59aa1e3a6f03f676 Mon Sep 17 00:00:00 2001
From: Lumnus <lumnus.org@gmail.com>
Date: Mon, 26 Oct 2026 11:41:47 +0000
Subject: [PATCH 15/15] [Attention] Do not fall back to reference attention
 during graph capture

When the attention kernel for a config is not compiled,
flash_attn_varlen_func warns once and runs the PyTorch reference
implementation. That implementation reads cu_seqlens / seqused_k on the
host and loops over sequences in Python, so it cannot be captured into an
XPU graph: the capture either stalls on the host read or records the
capture-time lengths. Raise the original "not compiled" error when the
current stream is capturing, and add VLLM_XPU_DISABLE_ATTN_FALLBACK=1 to
raise in every case, so a deployment can fail at startup instead of
running degraded.

diff --git a/KERNEL_CONFIGURATION.md b/KERNEL_CONFIGURATION.md
index fab805c..92bec41 100644
--- a/KERNEL_CONFIGURATION.md
+++ b/KERNEL_CONFIGURATION.md
@@ -370,6 +370,14 @@ VLLM_PAGED_DECODE_CONFIG=paged_decode_full.conf pip install .
 VLLM_PAGED_DECODE_CONFIG=paged_decode_default.conf pip install .
 ```
 
+### Missing kernel at runtime: reference fallback
+
+When `flash_attn_varlen_func` hits a config that was not compiled, it warns once
+and runs a PyTorch reference implementation instead (much slower). The fallback
+is not used during XPU graph capture, where it cannot run; the error above is
+raised instead. Set `VLLM_XPU_DISABLE_ATTN_FALLBACK=1` to raise in every case,
+e.g. to make a deployment fail at startup rather than run degraded.
+
 ### How to check which configs were compiled
 
 CMake prints a summary during build:
diff --git a/tests/flash_attn/test_attn_fallback.py b/tests/flash_attn/test_attn_fallback.py
new file mode 100644
index 0000000..d75024c
--- /dev/null
+++ b/tests/flash_attn/test_attn_fallback.py
@@ -0,0 +1,73 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""When the attention kernel for a config is not compiled,
+flash_attn_varlen_func falls back to a PyTorch reference implementation.
+These tests stub the compiled op, so they need no XPU kernel for the shape."""
+
+import pytest
+import torch
+import torch.nn.functional as F
+
+from vllm_xpu_kernels import flash_attn_interface
+
+NOT_COMPILED = ("Paged decode kernel not compiled for this configuration.\n"
+                "Add this line to your paged_decode config file: "
+                "16,256,64,false,false,false")
+
+
+def _not_compiled(*args, **kwargs):
+    raise RuntimeError(NOT_COMPILED)
+
+
+def _inputs(device):
+    torch.manual_seed(0)
+    seq_len, num_heads, head_size = 8, 2, 64
+    q, k, v = (torch.randn(seq_len, num_heads, head_size, device=device)
+               for _ in range(3))
+    cu_seqlens = torch.tensor([0, seq_len], dtype=torch.int32, device=device)
+    return q, k, v, cu_seqlens, seq_len
+
+
+def _call(q, k, v, cu_seqlens, seq_len):
+    return flash_attn_interface.flash_attn_varlen_func(
+        q,
+        k,
+        v,
+        max_seqlen_q=seq_len,
+        cu_seqlens_q=cu_seqlens,
+        max_seqlen_k=seq_len,
+        cu_seqlens_k=cu_seqlens,
+    )
+
+
+@pytest.fixture
+def missing_kernel(monkeypatch):
+    monkeypatch.setattr(torch.ops._vllm_fa2_C,
+                        "varlen_fwd",
+                        _not_compiled,
+                        raising=False)
+    monkeypatch.setattr(torch.xpu, "is_current_stream_capturing",
+                        lambda: False)
+    monkeypatch.delenv("VLLM_XPU_DISABLE_ATTN_FALLBACK", raising=False)
+    return monkeypatch
+
+
+def test_missing_kernel_falls_back(missing_kernel):
+    q, k, v, cu_seqlens, seq_len = _inputs("cpu")
+    out = _call(q, k, v, cu_seqlens, seq_len)
+    ref = F.scaled_dot_product_attention(q.transpose(0, 1), k.transpose(0, 1),
+                                         v.transpose(0, 1)).transpose(0, 1)
+    torch.testing.assert_close(out, ref, atol=1e-4, rtol=1e-4)
+
+
+def test_missing_kernel_raises_during_graph_capture(missing_kernel):
+    missing_kernel.setattr(torch.xpu, "is_current_stream_capturing",
+                           lambda: True)
+    with pytest.raises(RuntimeError, match="not compiled"):
+        _call(*_inputs("cpu"))
+
+
+def test_missing_kernel_raises_when_fallback_disabled(missing_kernel):
+    missing_kernel.setenv("VLLM_XPU_DISABLE_ATTN_FALLBACK", "1")
+    with pytest.raises(RuntimeError, match="16,256,64,false,false,false"):
+        _call(*_inputs("cpu"))
diff --git a/vllm_xpu_kernels/flash_attn_interface.py b/vllm_xpu_kernels/flash_attn_interface.py
index 77de5bb..68538dd 100644
--- a/vllm_xpu_kernels/flash_attn_interface.py
+++ b/vllm_xpu_kernels/flash_attn_interface.py
@@ -614,6 +614,19 @@ def flash_attn_varlen_func(
         except RuntimeError as e:
             if "not compiled" not in str(e):
                 raise
+            # The reference implementation reads sequence lengths on the
+            # host, so it cannot run inside XPU graph capture. Raise there,
+            # and wherever the user asked for no fallback, instead of
+            # degrading silently.
+            if (torch.xpu.is_current_stream_capturing()
+                    or os.environ.get("VLLM_XPU_DISABLE_ATTN_FALLBACK",
+                                      "0") == "1"):
+                raise RuntimeError(
+                    "XPU attention kernel not compiled for this config and "
+                    "the PyTorch reference fallback is not allowed here "
+                    "(XPU graph capture, or "
+                    "VLLM_XPU_DISABLE_ATTN_FALLBACK=1). Rebuild with the "
+                    f"config line below.\n{e}") from e
             # Fallback to PyTorch reference implementation.
             # Emit the notice once per unique missing config and write
             # it straight to stderr.
