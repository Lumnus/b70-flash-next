+@needs_interp
+@pytest.mark.parametrize("hs,nkv", [(256, 1), (256, 2), (128, 2)])
+def test_k4f_dequant_kernel_bit_equal(monkeypatch, hs, nkv):
+    import functools
+
+    monkeypatch.setattr(d2, "HS", hs)
+    monkeypatch.setattr(
+        d2, "make_layer_cache", functools.partial(d2.make_layer_cache, hs=hs)
+    )
+    bs, nb = 64, 9
+    seqs = [70, 130, 5]
+    kv_in, kv_sp, bt, _, _ = d2._fill_both(nkv, bs, nb, seqs)
+    for views in (
+        d2.inline_views(kv_in),
+        b70_pth_fa.split_layout_views(kv_sp, nkv, hs),
+    ):
+        kc, vc, ksc, vsc = views
+        nblk = [-(-s // bs) for s in seqs]
+        stride = max(nblk)
+        ks = torch.full((len(seqs) * stride, bs, nkv, hs), 7.0, dtype=torch.bfloat16)
+        vs = ks.clone()
+        b70_pth_fa.dequant_group(
+            kc,
+            vc,
+            ksc,
+            vsc,
+            bt[: len(seqs)],
+            torch.tensor(seqs, dtype=torch.int32),
+            ks,
+            vs,
+            stride,
+            stride,
+            hs,
+        )
+        for r, n in enumerate(nblk):
+            ids = bt[r, :n].long()
+            a = torch.empty(n, bs, nkv, hs, dtype=torch.bfloat16)
+            b70_pth_fa._dequant_blocks(kc, ksc, ids, a, hs)
+            assert torch.equal(ks[r * stride : r * stride + n], a)
+            b70_pth_fa._dequant_blocks(vc, vsc, ids, a, hs)
+            assert torch.equal(vs[r * stride : r * stride + n], a)
+
