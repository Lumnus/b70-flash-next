+@needs_interp
+@pytest.mark.parametrize("split", [False, True])
+def test_k4f_prefill_equals_stock(monkeypatch, split):
+    monkeypatch.setattr(d2, "HS", 256)
+    monkeypatch.setattr(b70_pth_fa, "current_platform", d2._XPU())
+    ops = d2._FakeXpuOps()
+    mod = types.ModuleType("vllm._xpu_ops")
+    mod.xpu_ops = ops
+    monkeypatch.setitem(sys.modules, "vllm._xpu_ops", mod)
+    nkv, hq, bs, nb = 2, 8, 64, 16
+    seqs, q_lens = [200, 90, 130, 30], [100, 90, 70, 1]
+    kv_in, kv_sp, bt, _, _ = d2._fill_both(nkv, bs, nb, seqs, seed=1)
+    meta = d2._meta(q_lens, seqs, bt)
+    q = torch.randn(sum(q_lens), hq, 256).to(torch.bfloat16)
+    if split:
+        kc, vc, ksc, vsc = b70_pth_fa.split_layout_views(kv_sp, nkv, 256)
+    else:
+        kc, vc, ksc, vsc = d2.inline_views(kv_in)
+
+    def run(fast, max_len):
+        monkeypatch.setattr(b70_pth_fa, "_scratch", {})
+        if fast:
+            monkeypatch.setenv("B70_PTH_FA_PREFILL_FAST", "1")
+        else:
+            monkeypatch.delenv("B70_PTH_FA_PREFILL_FAST", raising=False)
+        b70_pth_fa.attach_host_lens(
+            meta,
+            SimpleNamespace(
+                query_start_loc_cpu=meta.query_start_loc.clone(),
+                seq_lens_cpu_upper_bound=meta.seq_lens.clone() + 3,
+            ),
+        )  # an upper bound
+        imp = d2._impl(nkv, hq, max_len=max_len)
+        out = torch.zeros_like(q)
+        ops.calls.clear()
+        assert b70_pth_fa.maybe_fa_prefill(
+            imp, q, kc, vc, out, meta, q.shape[0], pth_scales=(ksc, vsc), force=True
+        )
+        return out, len(ops.calls)
+
+    for max_len in (4096, 300):  # one group / several groups
+        a, na = run(False, max_len)
+        b, nb_ = run(True, max_len)
+        assert torch.equal(a, b), max_len
+        print(f"K4F max_len {max_len}: stock {na} FA calls, fast {nb_}")
+
