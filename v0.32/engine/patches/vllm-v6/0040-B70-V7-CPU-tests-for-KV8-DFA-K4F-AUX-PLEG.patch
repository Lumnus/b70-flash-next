+# --------------------------------------------------------------------------
+# 1. KV8
+# --------------------------------------------------------------------------
+class _RefInt8Kernel:
+    """Torch twin of the W8A8 int8 kernels' contract: weight [K, N] int8 view,
+    channelwise fp32 scale [N, 1], dynamic symmetric per-token activations."""
+
+    layer_param_names = (
+        "weight",
+        "weight_scale",
+        "input_scale",
+        "input_zero_point",
+        "azp_adj",
+    )
+
+    def apply_weights(self, layer, x, bias=None):
+        w = layer.weight  # [K, N]
+        ws = layer.weight_scale.reshape(-1).float()
+        x2 = x.reshape(-1, x.shape[-1]).float()
+        xs = (x2.abs().amax(-1, keepdim=True) / 127.0).clamp_min(1e-10)
+        xq = torch.round(x2 / xs).clamp(-128, 127).to(torch.int64)
+        acc = xq @ w.to(torch.int64)  # exact int dot products
+        out = (acc.double() * xs.double() * ws.double()[None, :]).float()
+        if bias is not None:
+            out = out + bias.float()
+        return out.to(x.dtype).view(*x.shape[:-1], w.shape[1])
+
+
+class _Proj(nn.Module):
+    def __init__(self, k, q_size, kv, kernel, seed, static=False, asym=False):
+        super().__init__()
+        g = torch.Generator().manual_seed(seed)
+        n = q_size + 2 * kv
+        w_nk = torch.randint(-127, 128, (n, k), generator=g, dtype=torch.int8)
+        self.weight = nn.Parameter(w_nk.t(), requires_grad=False)  # processed view
+        self.weight_scale = nn.Parameter(
+            torch.rand(n, 1, generator=g) * 1e-2 + 1e-4, requires_grad=False
+        )
+        self.input_scale = torch.ones(()) if static else None
+        self.input_zero_point = None
+        self.azp_adj = torch.ones(1, n) if asym else None
+        self.bias = None
+        self.input_size_per_partition = k
+        self.output_size_per_partition = n
+        self.scheme = SimpleNamespace(kernel=kernel)
+        self.kernel = kernel
+
+    def forward(self, x):
+        return self.kernel.apply_weights(self, x), None
+
+
+def _fake_dflash(L=5, k=256, q=128, kv=64, **kw):
+    from vllm.model_executor.models.qwen3_dflash import DFlashQwen3Model
+
+    kern = _RefInt8Kernel()
+    m = SimpleNamespace()
+    m._context_qkv_projs = [_Proj(k, q, kv, kern, 10 + i, **kw) for i in range(L)]
+    m._context_q_sizes = [q] * L
+    m._fused_kv_weight = None
+    m._fused_kv_bias = None
+    m._kv_int8 = None
+    m._hidden_norm_weight = torch.ones(k)
+    m._rms_norm_eps = 1e-6
+    m.build_int8_context_kv = types.MethodType(
+        DFlashQwen3Model.build_int8_context_kv, m
+    )
+    m._project_context_kv = types.MethodType(DFlashQwen3Model._project_context_kv, m)
+    return m
+
