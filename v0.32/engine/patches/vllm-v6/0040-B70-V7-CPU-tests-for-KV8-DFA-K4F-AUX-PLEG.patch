+@pytest.mark.parametrize(
+    "hs,W,seqs",
+    [
+        (128, 96, [150, 64, 300]),
+        (256, 96, [150, 64, 300]),
+        (128, 2048, [2040, 2100, 3000]),
+    ],
+)
+def test_dfa_swa_noncausal_rows(win_kernels, monkeypatch, hs, W, seqs):
+    import functools
+
+    monkeypatch.setattr(d2, "HS", hs)
+    monkeypatch.setattr(
+        d2, "make_layer_cache", functools.partial(d2.make_layer_cache, hs=hs)
+    )
+    monkeypatch.setenv("B70_DRAFT_FA_INT8", "1")
+    nkv, hq, bs = 2, 8, 64
+    nb = sum(-(-s // bs) for s in seqs) + 2
+    q_lens = [8, 8, 8]
+    _, kv_sp, bt, dk, dv = d2._fill_both(nkv, bs, nb, seqs, seed=3)
+    meta = d2._meta(q_lens, seqs, bt, causal=False)
+    q = torch.randn(sum(q_lens), hq, hs).to(torch.bfloat16)
+    out = torch.zeros_like(q)
+    impl = d2._impl(nkv, hq)
+    impl.head_size, impl.scale = hs, hs**-0.5
+    b70_pth_fa.fa_int8_forward(impl, q, kv_sp, meta, out, q.shape[0], (W - 1, W - 1))
+    assert win_kernels.windows == [[W - 1, 0]]
+    qsl = meta.query_start_loc.tolist()
+    worst = 0.0
+    for i, S in enumerate(seqs):
+        qi = q[qsl[i] : qsl[i + 1]].float()
+        lo_impl = [max(0, S - W)] * 8  # window from the block end
+        ref = _ref_window(qi, dk[i], dv[i], impl.scale, lo_impl)
+        got = out[qsl[i] : qsl[i + 1]].float()
+        assert ((got - ref).norm() / ref.norm()) < 1.5e-2
+        # TRITON_ATTN semantics: |p - k| <= W - 1 per row
+        lo_tri = [max(0, (S - 8 + j) - (W - 1)) for j in range(8)]
+        tri = _ref_window(qi, dk[i], dv[i], impl.scale, lo_tri)
+        dev = ((got - tri).norm() / tri.norm()).item()
+        if S <= W - 7:
+            assert dev < 1.5e-2
+        worst = max(worst, dev)
+    print(f"DFA hs={hs} W={W} seqs={seqs}: max rel dev vs per-row window {worst:.4f}")
+
