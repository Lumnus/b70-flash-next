+def test_aux_deferred_order(monkeypatch):
+    from vllm.models.qwen4_exp.nvidia import dflash2_features as f
+
+    monkeypatch.setattr(f, "_AUX_REUSE", True)
+    m = SimpleNamespace(
+        aux_hidden_state_layers=(6, 16),
+        end_layer=20,
+        layers=[SimpleNamespace(ple=None) for _ in range(20)],
+    )
+    m.layers[16].ple = object()  # a PLE layer after a boundary: not deferred
+    cap = types.MethodType(f.DFlash2FeatureCapture.capture_completed_layer, m)
+    col = types.MethodType(f.DFlash2FeatureCapture.collect_deferred_feature, m)
+    aux = []
+    combined = {}
+    for i in range(20):
+        layer = m.layers[i]
+        if getattr(m, "_b70_aux_defer", None) == i:
+            combined[i] = torch.randn(3, 4 * 2560)
+            layer.__dict__["_b70_combined"] = combined[i]
+            col(aux, i, layer)
+        mlp = SimpleNamespace(combine=lambda h, b, j: h + b.repeat(1, 4))
+        layer.mlp_hyper_connection = mlp
+        h, b = torch.randn(3, 4 * 2560), torch.randn(3, 2560)
+        if i == 15:
+            want16 = f.aux_feature(h + b.repeat(1, 4))
+        cap(aux, i, layer, h, b, None)
+    assert len(aux) == 2
+    assert torch.equal(aux[0], f.aux_feature(combined[6]))
+    assert torch.equal(aux[1], want16)
+
+
+# --------------------------------------------------------------------------
+# 5. PLEG
+# --------------------------------------------------------------------------
+def _ple_consts(heads=16, hpn=8):
+    rng = np.random.default_rng(0)
+    sizes = rng.integers(500, 900, size=heads).astype(np.int64)
+    offsets = np.concatenate([[0], np.cumsum(sizes)[:-1]]).astype(np.int64)
+    mult = [int(x) for x in rng.integers(1, 2**31, size=3)]
+    return sizes, offsets, mult, hpn
+
+
+def _batch(rng, q_lens, eos, vocab=50):
+    ids = rng.integers(0, vocab, size=sum(q_lens)).astype(np.int64)
+    ids[rng.random(ids.size) < 0.1] = eos
+    qsl = np.concatenate([[0], np.cumsum(q_lens)]).astype(np.int64)
+    ctx = rng.integers(0, vocab, size=(len(q_lens), 2)).astype(np.int64)
+    return ids, qsl, ctx
+
+
+@needs_interp
+@pytest.mark.parametrize("q_lens", [[8, 8, 8], [1, 5, 8, 3], [40]])
+def test_pleg_device_hash_equals_host(q_lens):
+    from vllm.models.qwen4_exp.common.ops.ple import ple_ngram_ids
+    from vllm.models.qwen4_exp.nvidia.ngram_embedding import b70_host_ngram_ids
+
+    sizes, offsets, mult, hpn = _ple_consts()
+    eos = 7
+    rng = np.random.default_rng(len(q_lens))
+    ids, qsl, ctx = _batch(rng, q_lens, eos)
+    host = b70_host_ngram_ids(ids, qsl, ctx, mult, sizes, offsets, eos, hpn, 3)
+    max_reqs = len(q_lens) + 3  # trailing zero-length requests, like the model state
+    qsl_pad = np.concatenate([qsl, [qsl[-1]] * 3]).astype(np.int32)
+    ctx_pad = np.concatenate([ctx, np.full((3, 2), eos)]).astype(np.int32)
+    T_pad = ids.size + 5
+    ids_pad = np.concatenate([ids, np.zeros(5, dtype=np.int64)]).astype(np.int32)
+    dev = ple_ngram_ids(
+        torch.from_numpy(ids_pad),
+        torch.from_numpy(qsl_pad),
+        torch.from_numpy(ctx_pad),
+        torch.tensor(mult, dtype=torch.int64),
+        torch.from_numpy(sizes),
+        torch.from_numpy(offsets),
+        eos,
+        hpn,
+    )
+    assert dev.shape == (T_pad, 16)
+    assert np.array_equal(dev[: ids.size].numpy(), host), max_reqs
+
+
+@needs_interp
+@pytest.mark.parametrize("max_slab", [1 << 30, 164 * 2048, 164 * 1500])
+def test_pleg_gather_equals_host_stage(max_slab):
+    from vllm.models.qwen4_exp.nvidia.b70_ple_devgather import DeviceGather
+    from vllm.models.qwen4_exp.nvidia.ple_nvme import owned_heads
+    from vllm.models.qwen4_exp.nvidia.ple_ram import PleRamTable
+
+    sizes, offsets, _, _ = _ple_consts()
+    total = int(offsets[-1] + sizes[-1])
+    ROW, H = 164, 16
+    tp_start, tp_end = (
+        int(offsets[3]) + 100,
+        int(offsets[8]) + 50,
+    )  # split heads 3 and 8
+    tensors = []
+
+    def alloc(rows, rb):
+        t = torch.zeros(rows, rb, dtype=torch.uint8)
+        tensors.append(t)
+        return t.numpy()
+
+    table = PleRamTable(
+        tp_start, tp_end, ROW, alloc=alloc, max_slab_bytes=max_slab, tail_bytes=164 * 64
+    )
+    rng = np.random.default_rng(1)
+    for s in table.slabs:
+        s[:] = rng.integers(0, 256, size=s.shape, dtype=np.uint8)
+    own = owned_heads(sizes, offsets, tp_start, tp_end)
+    T, n_act = 24, 19
+    ids = (offsets[None, :] + rng.integers(0, sizes[None, :], size=(T, H))).astype(
+        np.int64
+    )
+    stage = np.full((T, H, ROW), 0xAB, dtype=np.uint8)
+    stage[:T].fill(0)  # _fill_stage zero-fills max(dirty, padded) rows
+    table.gather_into(stage, ids[:n_act][:, own], own)
+    dg = DeviceGather(tensors, table.bounds, tp_start, tp_end, ROW, view_fn=lambda t: t)
+    qsl = torch.tensor([0, 8, 16, n_act, n_act, n_act], dtype=torch.int32)
+    out = torch.full((T, H, ROW), 0xCD, dtype=torch.uint8)
+    dg(torch.from_numpy(ids), qsl, out)
+    assert len(tensors) >= 1
+    assert np.array_equal(out.numpy(), stage), len(tensors)
+    assert total > tp_end
