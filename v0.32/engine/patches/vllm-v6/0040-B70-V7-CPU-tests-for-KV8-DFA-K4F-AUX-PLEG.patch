+class _WinFakeOps(d2._FakeXpuOps):
+    """Adds the decode kernel's window to the D2 stand-in: a causal q-1 row at
+    seqused L with window [wl, 0] reads keys [max(0, L-1-wl), L)."""
+
+    def flash_attn_varlen_func(
+        self, q, k, v, cu_seqlens_q, max_seqlen_q, max_seqlen_k, window_size=None, **kw
+    ):
+        self.windows = getattr(self, "windows", []) + [window_size]
+        if window_size is None or window_size[0] < 0 or k.dtype != torch.int8:
+            return super().flash_attn_varlen_func(
+                q, k, v, cu_seqlens_q, max_seqlen_q, max_seqlen_k, **kw
+            )
+        assert max_seqlen_q == 1 and kw.get("causal") and k.dtype == torch.int8
+        self.calls.append(SimpleNamespace(kdtype=k.dtype, max_q=1, causal=True))
+        wl, out, bt = window_size[0], kw["out"], kw["block_table"]
+        kf = k.float() * kw["k_descale"][..., None]
+        vf = v.float() * kw["v_descale"][..., None]
+        bs, nkv = k.shape[1], k.shape[2]
+        used = kw["seqused_k"].tolist()
+        for r in range(cu_seqlens_q.numel() - 1):
+            L = used[r]
+            lo = max(0, L - 1 - wl)
+            blocks = bt[r, : -(-L // bs)].long()
+            K = kf[blocks].reshape(-1, nkv, kf.shape[-1])[lo:L]
+            V = vf[blocks].reshape(-1, nkv, vf.shape[-1])[lo:L]
+            out[r : r + 1] = d2._ref_attn(
+                q[r : r + 1].float(), K, V, kw["softmax_scale"], False
+            ).to(out.dtype)
+        return out
+
+
+def _ref_window(q, K, V, scale, lo_per_row):
+    g = q.shape[1] // K.shape[1]
+    K, V = K.repeat_interleave(g, 1), V.repeat_interleave(g, 1)
+    s = torch.einsum("qhd,khd->hqk", q, K) * scale
+    kp = torch.arange(K.shape[0])
+    mask = kp[None, :] >= torch.tensor(lo_per_row)[:, None]
+    s = s.masked_fill(~mask[None], float("-inf"))
+    return torch.einsum("hqk,khd->qhd", torch.softmax(s, -1), V)
+
+
