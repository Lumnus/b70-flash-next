     global _LOGGED
     if not enabled() or hidden_states.shape[0] < min_tokens():
         return False
     if cutlass_mode():
-        return _maybe_apply_cutlass(impl, output, hidden_states, topk_weights, topk_ids)
+        return _maybe_apply_cutlass(impl, output, hidden_states, topk_weights, topk_ids,
