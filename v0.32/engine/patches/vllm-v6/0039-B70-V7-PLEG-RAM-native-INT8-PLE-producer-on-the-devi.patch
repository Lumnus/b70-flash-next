             "rows [%d, %d), %s", rank, table.num_rows, pinned / 2**30, loaded_s, alloc_s,
             info["gbps"], "" if info["direct"] else " buffered", info["slabs"], check_s,
             self._own_heads.tolist(), tp_start, tp_end, path)
+        from . import b70_ple_devgather
