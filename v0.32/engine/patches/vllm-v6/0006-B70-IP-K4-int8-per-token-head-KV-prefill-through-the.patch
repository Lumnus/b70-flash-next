From 9982d0735cee47df2f0e8bdf158ec9bd8759f889 Mon Sep 17 00:00:00 2001
From: Lumnus <lumnus.org@gmail.com>
Date: Sat, 31 Oct 2026 14:24:13 +0000
Subject: [PATCH 06/53] B70-IP-K4: int8 per-token-head KV prefill through the
 XPU FA kernel

Triton unified attention prefill on XPU is ~100x slower than the SYCL FA
kernel (4096 q over 32K ctx: ~2.7-3.0 s vs 28.9 ms). For batches with a real
prefill (max q > B70_PTH_FA_MIN_Q, default 64) gather the referenced int8
blocks, dequantize into a one-layer bf16 scratch (max_model_len tokens) and
call flash_attn_varlen_func over a remapped block table. B70 check: rel err
0.021 / cos 0.9998 vs fp32 (int8 floor), 30.4 ms for a 4096-over-32K batch.
Decode and spec-verify batches stay on Triton + graphs. B70_PTH_FA_PREFILL=0
turns it off.
---
 vllm/v1/attention/backends/b70_pth_fa.py  | 163 ++++++++++++++++++++++
 vllm/v1/attention/backends/triton_attn.py |  16 +++
 2 files changed, 179 insertions(+)
 create mode 100644 vllm/v1/attention/backends/b70_pth_fa.py

diff --git a/vllm/v1/attention/backends/b70_pth_fa.py b/vllm/v1/attention/backends/b70_pth_fa.py
new file mode 100644
index 0000000000..52b540b607
--- /dev/null
+++ b/vllm/v1/attention/backends/b70_pth_fa.py
@@ -0,0 +1,163 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""B70-IP-K4: prefill over an int8 per-token-head KV cache through the XPU FA kernel.
+
+On XPU the Triton unified attention kernel is ~100x slower than the SYCL
+flash-attention kernel for prefill chunks (B70, hs=256: 4096 queries over 32K
+context 2,705-3,034 ms vs 28.9 ms). Dequantizing the int8 context to bf16 costs
+<1 ms per layer at 128K, so for batches that carry a real prefill we gather the
+blocks each sequence references, dequantize them into a one-layer bf16 scratch,
+and call ``flash_attn_varlen_func`` over a remapped block table. Decode-only
+batches (and spec-decode verify batches, q <= B70_PTH_FA_MIN_Q) stay on the
+Triton kernel and its CUDA graphs.
+
+The scratch holds max_model_len tokens of one layer (K and V, bf16), shared by
+all layers (they run in sequence), allocated in the first eager forward (the
+memory-profile run) so the KV pool is sized around it. Sequences whose total
+context exceeds it are processed in groups.
+
+Env: B70_PTH_FA_PREFILL=0 turns it off; B70_PTH_FA_MIN_Q (default 64).
+"""
+
+import os
+
+import torch
+
+from vllm.logger import init_logger
+from vllm.platforms import current_platform
+
+logger = init_logger(__name__)
+
+_scratch: dict = {}
+_logged = False
+
+
+def _enabled() -> bool:
+    return current_platform.is_xpu() and os.environ.get("B70_PTH_FA_PREFILL", "1") != "0"
+
+
+def _get_scratch(block_size, nkv, hs, dtype, device):
+    from vllm.config import get_current_vllm_config_or_none
+
+    key = (block_size, nkv, hs, dtype, str(device))
+    s = _scratch.get(key)
+    if s is None:
+        cfg = get_current_vllm_config_or_none()
+        max_len = cfg.model_config.max_model_len if cfg is not None else 131072
+        nblk = -(-max_len // block_size) + 1
+        k = torch.empty((nblk, block_size, nkv, hs), dtype=dtype, device=device)
+        v = torch.empty_like(k)
+        s = (k, v)
+        _scratch[key] = s
+        logger.info(
+            "B70-IP-K4 int8 KV prefill via FA: bf16 scratch %d blocks x %d tokens "
+            "(%.2f GiB)",
+            nblk,
+            block_size,
+            2 * k.numel() * k.element_size() / 2**30,
+        )
+    return s
+
+
+def ensure_scratch(impl, kv_cache: torch.Tensor, dtype) -> None:
+    """Allocate at the first forward (profile run) so KV sizing sees it."""
+    if not _enabled():
+        return
+    num_blocks, nkv, block_size, content = kv_cache.shape
+    hs = impl.head_size
+    _get_scratch(block_size, nkv, hs, dtype, kv_cache.device)
+
+
+def _dequant_blocks(src_data, src_scale, ids, dst, hs, chunk=4):
+    # src_data: (nb, bs, nkv, hs+pad) int8 view; src_scale: (nb, bs, nkv) fp32
+    n = ids.numel()
+    for i in range(0, n, chunk):
+        sel = ids[i : i + chunk]
+        d = src_data[sel][..., :hs].to(dst.dtype)
+        s = src_scale[sel].to(dst.dtype).unsqueeze(-1)
+        dst[i : i + sel.numel()] = d * s
+
+
+def maybe_fa_prefill(
+    impl,
+    query: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    output: torch.Tensor,
+    attn_metadata,
+    num_actual_tokens: int,
+) -> bool:
+    global _logged
+    if not _enabled():
+        return False
+    if attn_metadata.max_query_len <= int(os.environ.get("B70_PTH_FA_MIN_Q", "64")):
+        return False
+    if (
+        impl.alibi_slopes is not None
+        or impl.sinks is not None
+        or (impl.logits_soft_cap or 0) != 0
+        or tuple(impl.sliding_window) != (-1, -1)
+        or attn_metadata.mm_prefix_range_tensor is not None
+        or attn_metadata.rswa_prefix_lens is not None
+        or not isinstance(attn_metadata.causal, bool)
+        or not attn_metadata.causal
+    ):
+        return False
+    from vllm._xpu_ops import xpu_ops
+
+    nb, bs, nkv, _ = key_cache.shape
+    hs = impl.head_size
+    ks, vs = _get_scratch(bs, nkv, hs, query.dtype, query.device)
+    cap = ks.shape[0]
+    seq_lens = attn_metadata.seq_lens.tolist()
+    qsl = attn_metadata.query_start_loc.tolist()
+    nseq = len(seq_lens)
+    bt = attn_metadata.block_table
+    nblks = [-(-s // bs) for s in seq_lens]
+    i = 0
+    while i < nseq:
+        j, used = i, 0
+        while j < nseq and used + nblks[j] <= cap:
+            used += nblks[j]
+            j += 1
+        if j == i:  # one sequence longer than the scratch: cannot happen (max_model_len)
+            return False
+        ids = torch.cat([bt[r, : nblks[r]] for r in range(i, j)]).to(torch.long)
+        _dequant_blocks(key_cache, impl._k_scale_cache, ids, ks, hs)
+        _dequant_blocks(value_cache, impl._v_scale_cache, ids, vs, hs)
+        width = max(nblks[i:j])
+        new_bt = torch.zeros((j - i, width), dtype=torch.int32, device=query.device)
+        off = 0
+        for r in range(i, j):
+            new_bt[r - i, : nblks[r]] = torch.arange(
+                off, off + nblks[r], dtype=torch.int32, device=query.device
+            )
+            off += nblks[r]
+        q0, q1 = qsl[i], qsl[j]
+        cu = torch.tensor(
+            [q - q0 for q in qsl[i : j + 1]], dtype=torch.int32, device=query.device
+        )
+        sk = torch.tensor(seq_lens[i:j], dtype=torch.int32, device=query.device)
+        xpu_ops.flash_attn_varlen_func(
+            query[q0:q1],
+            ks,
+            vs,
+            cu_seqlens_q=cu,
+            max_seqlen_q=max(qsl[r + 1] - qsl[r] for r in range(i, j)),
+            max_seqlen_k=max(seq_lens[i:j]),
+            softmax_scale=impl.scale,
+            causal=True,
+            out=output[q0:q1],
+            block_table=new_bt,
+            seqused_k=sk,
+        )
+        i = j
+    if not _logged:
+        _logged = True
+        logger.info(
+            "B70-IP-K4 int8 KV prefill via FA: first batch %d seqs, max q %d, max ctx %d",
+            nseq,
+            attn_metadata.max_query_len,
+            max(seq_lens),
+        )
+    return True
diff --git a/vllm/v1/attention/backends/triton_attn.py b/vllm/v1/attention/backends/triton_attn.py
index f5f97d7410..f5da34abd6 100644
--- a/vllm/v1/attention/backends/triton_attn.py
+++ b/vllm/v1/attention/backends/triton_attn.py
@@ -618,6 +618,22 @@ class TritonAttentionImpl(AttentionImpl):
             k_scale_cache = self._k_scale_cache
             v_scale_cache = self._v_scale_cache
             q_descale = k_descale = v_descale = None
+            # B70-IP-K4: prefill over int8 per-token-head KV through the XPU
+            # FA kernel (dequant-to-bf16 scratch); decode stays below.
+            if current_platform.is_xpu():
+                from vllm.v1.attention.backends import b70_pth_fa
+
+                b70_pth_fa.ensure_scratch(self, kv_cache, query.dtype)
+                if b70_pth_fa.maybe_fa_prefill(
+                    self,
+                    query[:num_actual_tokens],
+                    key_cache,
+                    value_cache,
+                    output[:num_actual_tokens],
+                    attn_metadata,
+                    num_actual_tokens,
+                ):
+                    return output
         # FP8 per-tensor / auto path (original flow).
         else:
             kv_cache = kv_cache.transpose(1, 2)
