+    ref = torch.stack(ref)
+    got = out.float()
+    rel = ((got - ref).norm() / ref.norm()).item()
+    cos = torch.nn.functional.cosine_similarity(
+        got.flatten(), ref.flatten(), dim=0
+    ).item()
