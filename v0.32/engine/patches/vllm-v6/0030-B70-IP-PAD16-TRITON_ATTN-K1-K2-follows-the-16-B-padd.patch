+def _quant_ref(x):
+    xf = x.float()
+    scale = torch.clamp(xf.abs().amax(-1) / 127.0, min=1e-6)
+    y = xf * (1.0 / scale)[..., None]
+    y = torch.where(y >= 0, y + 0.5, y - 0.5).clamp(-128.0, 127.0).trunc()
+    return y.to(torch.int8), scale
