+# ---------------------------------------------------------------- 2. HC
+hcg = _load("b70_hc_gemm_t", "vllm/models/qwen4_exp/nvidia/b70_hc_gemm.py")
+
+
+def _hc_silu_ref(x, hc):
+    from vllm.models.qwen4_exp.nvidia.ops import hc as hcops
+
+    return hcops._hc_silu(x, hc)
+
+
+@pytest.mark.parametrize("rows", [1, 2, 8, 9, 16, 32])
+@pytest.mark.parametrize("cols,valid,lora", [(336, 324, 320), (320, 320, 320)])
+def test_hc_finish_silu_bitwise(rows, cols, valid, lora):
+    g = torch.Generator().manual_seed(rows * 7 + cols)
+    x = torch.randn(rows, 10240, generator=g).to(torch.bfloat16)
+    w = (torch.randn(cols, 10240, generator=g) * 0.02).to(torch.bfloat16)
+    assert hcg.takes_parallel_route(x, w, valid)
+    out_ref = hcg.parallel_hc_gemm(x, w, valid)
+    lora_ref = _hc_silu_ref(out_ref[:, :lora], 4)
+    out, lo = hcg.parallel_hc_gemm_silu(x, w, valid, lora, 4)
+    assert torch.equal(out.view(torch.int16), out_ref.view(torch.int16))
+    assert torch.equal(lo.view(torch.int16), lora_ref.view(torch.int16))
+    assert lo.is_contiguous() and lo.shape == lora_ref.shape
+    inj, inj_ref = (
+        out[:, lora : lora + 4],
+        out_ref.split([lora, cols - lora], -1)[1][:, :4],
+    )
+    assert torch.equal(inj, inj_ref) and inj.stride() == inj_ref.stride()
+
+
+def test_hc_route_predicate():
+    w = torch.empty(336, 10240, dtype=torch.bfloat16)
+    assert hcg.takes_parallel_route(
+        torch.empty(32, 10240, dtype=torch.bfloat16), w, 324
+    )
+    assert not hcg.takes_parallel_route(
+        torch.empty(33, 10240, dtype=torch.bfloat16), w, 324
+    )
+    assert not hcg.takes_parallel_route(
+        torch.empty(64, 10240, dtype=torch.bfloat16), w, 324
+    )
