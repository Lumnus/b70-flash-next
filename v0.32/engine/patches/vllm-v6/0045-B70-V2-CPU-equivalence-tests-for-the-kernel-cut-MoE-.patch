+# SPDX-License-Identifier: Apache-2.0
+"""B70-V2 kernel cut: CPU equivalence tests (TRITON_INTERPRET=1).
+
+1. MoE: the sentinel+zero Triton kernel vs torch.where + torch.zeros; the replicas of
+   the wheel's XpuFusedMoe._apply_kernel and b70_moe_w4a8.apply vs the wheel bodies
+   themselves (exec'd from the wheel source in B70_V2_WHEEL_DIR, with CPU reference
+   ops), bitwise; the aten ops removed.
+2. HC: parallel_hc_gemm_silu vs parallel_hc_gemm + _hc_silu, bitwise.
+3. All-reduce: XpuCommunicator.all_reduce_inplace vs all_reduce over gloo (2 ranks),
+   bitwise; GroupCoordinator.all_reduce_owned dispatch.
+"""
+
+import ast
+import importlib.util
+import os
+import sys
+import textwrap
+import types
+
+import pytest
+import torch
+from torch.utils._python_dispatch import TorchDispatchMode
+
+os.environ.setdefault("TRITON_INTERPRET", "1")
+WHEEL = os.environ.get("B70_V2_WHEEL_DIR", "")
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+
+def _load(name, rel):
+    spec = importlib.util.spec_from_file_location(name, os.path.join(ROOT, rel))
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+kcut = _load("b70_moe_kcut_t", "vllm/model_executor/layers/fused_moe/b70_moe_kcut.py")
+
+
+class AtenLog(TorchDispatchMode):
+    def __init__(self):
+        super().__init__()
+        self.ops = []
+
+    def __torch_dispatch__(self, func, types_, args=(), kwargs=None):
+        self.ops.append(str(func.overloadpacket.__name__))
+        return func(*args, **(kwargs or {}))
+
+
+# ---------------------------------------------------------------- 1. MoE
+@pytest.mark.parametrize("rows", [1, 8, 13, 64, 4096])
+@pytest.mark.parametrize("dtype", [torch.int32, torch.int64])
+@pytest.mark.parametrize("sentinel", [0, 511])
+def test_sentinel_and_zero(rows, dtype, sentinel):
+    g = torch.Generator().manual_seed(rows)
+    ids = torch.randint(-3, 512, (rows, 10), generator=g, dtype=dtype)
+    ref = torch.where(ids < 0, sentinel, ids)
+    out, rpe = kcut.sentinel_and_zero(ids, sentinel, 128)
+    assert out.dtype == ids.dtype and out.shape == ids.shape
+    assert torch.equal(out, ref)
+    assert (
+        rpe.dtype == torch.int32 and rpe.shape == (128,) and int(rpe.abs().sum()) == 0
+    )
+
+
+def test_sentinel_zero_overwrites_garbage():
+    ids = torch.tensor([[-1, 5], [3, -7]], dtype=torch.int32)
+    torch.manual_seed(0)
+    for _ in range(
+        3
+    ):  # empty() may hand back old bytes; the kernel must zero all of them
+        out, rpe = kcut.sentinel_and_zero(ids, 0, 300)
+        assert torch.equal(rpe, torch.zeros(300, dtype=torch.int32))
+        assert out.tolist() == [[0, 5], [3, 0]]
+
+
+def test_stock_glue_aten_ops():
+    """The ops the flag removes per layer (CPU dispatch; one XPU kernel each)."""
+    ids = torch.randint(-1, 512, (8, 10), dtype=torch.int32)
+    hs = torch.randn(8, 2560, dtype=torch.bfloat16)
+    with AtenLog() as stock:
+        t = torch.where(ids < 0, 511, ids)
+        inv = (t < 0).all(dim=1)
+        hs.masked_fill(inv.unsqueeze(1), 0)
+        torch.zeros((128,), dtype=torch.int32)
+    with AtenLog() as new:
+        kcut.sentinel_and_zero(ids, 511, 128)
+    print("stock aten:", stock.ops)
+    print("kcut aten:", new.ops)
+    assert "masked_fill" in "".join(stock.ops) and "all" in stock.ops
+    assert not any(
+        o
+        in (
+            "where",
+            "lt",
+            "all",
+            "masked_fill",
+            "masked_fill_",
+            "zeros",
+            "zero_",
+            "fill_",
+        )
+        for o in new.ops
+    )
+
+
+# CPU reference ops with the SYCL kernels' semantics (order inside an expert is not
+# specified by the
+# atomics; the reference uses token order, which both stock and replica share).
+class RefOps:
+    def __init__(self):
+        self.calls = []
+
+    def remap_hidden_states(
+        self,
+        hidden_states,
+        hidden_states_scales,
+        remapped_hidden_states,
+        remapped_hidden_states_scales,
+        expert_map,
+        rows_per_expert,
+        unpermuted_row_to_permuted_row,
+        topk_ids,
+        total_experts_num,
+        local_experts_num,
+    ):
+        self.calls.append("remap")
+        T, K = topk_ids.shape
+        flat = topk_ids.reshape(-1).long()
+        local = expert_map.long()[flat] if expert_map is not None else flat
+        counts = torch.zeros(local_experts_num, dtype=torch.int64)
+        for e in local.tolist():
+            if e >= 0:
+                counts[e] += 1
+        rows_per_expert += counts.to(torch.int32)  # atomic add on the caller's buffer
+        start = torch.cumsum(rows_per_expert.long(), 0) - rows_per_expert.long()
+        fill = torch.zeros(local_experts_num, dtype=torch.int64)
+        unp = unpermuted_row_to_permuted_row.view(-1)
+        for i, e in enumerate(local.tolist()):
+            if e < 0:
+                unp[i] = -1
+                continue
+            p = int(start[e] + fill[e])
+            fill[e] += 1
+            unp[i] = p
+            remapped_hidden_states[p] = hidden_states[i // K]
+            if remapped_hidden_states_scales is not None:
+                remapped_hidden_states_scales[p] = hidden_states_scales[i // K]
+
+    def moe_gather(self, output, g2, topk_weights, unp, num_experts):
+        self.calls.append("gather")
+        T, K = unp.shape
+        acc = torch.zeros(output.shape, dtype=torch.float32)
+        for t in range(T):
+            for k in range(K):
+                p = int(unp[t, k])
+                if p >= 0:
+                    acc[t] += topk_weights[t, k].float() * g2[p].float()
+        output.copy_(acc.to(output.dtype))
+
+
+def grouped_ref(A, B, rows_per_expert, out_dtype, a_scale=None):
+    """[R, K] x per-expert [E, N, K] (B dense) over expert-contiguous rows."""
+    out = torch.zeros((A.shape[0], B.shape[1]), dtype=torch.float32)
+    r = 0
+    for e, n in enumerate(rows_per_expert.tolist()):
+        if n:
+            a = A[r : r + n].float()
+            if a_scale is not None:
+                a = a * a_scale[r : r + n].float()
+            out[r : r + n] = a @ B[e].float().t()
+        r += n
+    return out.to(out_dtype)
+
+
+def silu_and_mul(out, x):
+    d = x.shape[1] // 2
+    g = x[:, :d].float()
+    out.copy_((g * torch.sigmoid(g) * x[:, d:].float()).to(out.dtype))
+
+
+def _wheel_fn(path, qual, glb):
+    with open(path) as f:
+        src = f.read()
+    tree = ast.parse(src)
+    nodes = tree.body
+    node = None
+    for p in qual.split("."):
+        node = next(
+            n
+            for n in nodes
+            if isinstance(n, (ast.ClassDef, ast.FunctionDef)) and n.name == p
+        )
+        nodes = getattr(node, "body", [])
+    lines = src.splitlines()[node.lineno - 1 : node.end_lineno]
+    code = textwrap.dedent("\n".join(lines))
+    assert (
+        kcut.fingerprint_node(ast.parse(code).body[0])
+        == kcut._FP[
+            "XpuFusedMoe._apply_kernel"
+            if "XpuFusedMoe" in qual
+            else "b70_moe_w4a8.apply"
+        ]
+    )
+    ns = dict(glb)
+    exec(compile(code, path, "exec"), ns)
+    return ns[node.name]
+
+
+class FakeImpl:
+    """The attributes _apply_kernel / the W4A8 apply read (int4 g128 SiLU, EP4)."""
+
+    def __init__(self, E_total=32, ep=4, rank=1, H=256, inter=128, topk=4, seed=0):
+        g = torch.Generator().manual_seed(seed)
+        self.num_experts = self.local_experts_num = E_total // ep
+        self.total_experts_num = E_total
+        self.n_experts_per_token = topk
+        self.ep_size, self.ep_rank = ep, rank
+        em = torch.full((E_total,), -1, dtype=torch.int32)
+        em[rank * self.num_experts : (rank + 1) * self.num_experts] = torch.arange(
+            self.num_experts, dtype=torch.int32
+        )
+        self.expert_map = em
+        self.inter_size, self.inter_size_scale = inter, 1
+        self.w13 = torch.randn(self.num_experts, 2 * inter, H, generator=g).to(
+            torch.bfloat16
+        )
+        self.w2 = torch.randn(self.num_experts, H, inter, generator=g).to(
+            torch.bfloat16
+        )
+        self.gemm1_wei_scales = self.gemm2_wei_scales = None
+        self.w13_bias = self.w2_bias = None
+        self.gemm1_clamp_limit = None
+        self.activation = "silu"
+        self.act_func = silu_and_mul
+        self.is_mxfp8 = self.is_block_fp8 = False
+        self._use_ref = False
+
+    def _grouped_gemm(self, A, A_scale, B, B_scale, bias, D, rows_per_expert, N, K):
+        D.copy_(grouped_ref(A, B, rows_per_expert, D.dtype))
+
+
+def _install_ops(ref):
+    torch.ops._moe_C.remap_hidden_states = ref.remap_hidden_states
+    torch.ops._moe_C.moe_gather = ref.moe_gather
+    sys.modules.setdefault("vllm_xpu_kernels", types.ModuleType("vllm_xpu_kernels"))
+    fmi = types.ModuleType("vllm_xpu_kernels.fused_moe_interface")
+    sys.modules["vllm_xpu_kernels.fused_moe_interface"] = fmi
+    sys.modules["vllm_xpu_kernels"].fused_moe_interface = fmi
+
+
+def _routing(T, impl, seed, nan_rows=()):
+    g = torch.Generator().manual_seed(seed)
+    hs = torch.randn(T, impl.w13.shape[2], generator=g).to(torch.bfloat16)
+    for r in nan_rows:
+        hs[r] = float("nan")  # a padding row of a FULL replay with poisoned state
+    ids = torch.randint(
+        -1,
+        impl.total_experts_num,
+        (T, impl.n_experts_per_token),
+        generator=g,
+        dtype=torch.int32,
+    )
+    w = torch.rand(T, impl.n_experts_per_token, generator=g).to(torch.float32)
+    sentinel = impl.total_experts_num - 1 if impl.ep_rank == 0 else 0
+    return hs, ids, w, sentinel
+
+
+needs_wheel = pytest.mark.skipif(not WHEEL, reason="B70_V2_WHEEL_DIR not set")
+
+
+@needs_wheel
+@pytest.mark.parametrize("T", [1, 8, 24, 64])
+@pytest.mark.parametrize("rank", [0, 1])
+def test_apply_kernel_replica_bitwise(T, rank):
+    ref = RefOps()
+    _install_ops(ref)
+    stock = _wheel_fn(
+        os.path.join(WHEEL, "fused_moe_interface.py"),
+        "XpuFusedMoe._apply_kernel",
+        {"torch": torch},
+    )
+    impl = FakeImpl(rank=rank, seed=T)
+    hs, ids, w, sentinel = _routing(
+        T, impl, seed=T + rank, nan_rows=(T - 1,) if T > 1 else ()
+    )
+    # stock: xpu_moe's where, then the wheel body (mask + zeros inside)
+    ids_s = torch.where(ids < 0, sentinel, ids)
+    out_s = torch.empty(T, hs.shape[1], dtype=torch.bfloat16)
+    stock(impl, out_s, hs, w, ids_s)
+    # B70_MOE_KCUT=1
+    ids_k, rpe = kcut.sentinel_and_zero(ids, sentinel, impl.num_experts)
+    out_k = torch.empty_like(out_s)
+    kcut.apply_kernel(impl, out_k, hs, w, ids_k, rpe)
+    assert torch.equal(ids_k, ids_s)
+    assert torch.equal(
+        out_k.view(torch.int16), out_s.view(torch.int16)
+    )  # bitwise, NaN rows too
+
+
+def _quant_rows(x):
+    xf = x.float()
+    s = (xf.abs().amax(dim=1, keepdim=True) / 127.0).clamp_min(1e-10)
+    return torch.round(xf / s).clamp_(-128, 127).to(torch.int8), s
+
+
+@needs_wheel
+@pytest.mark.parametrize("T", [1, 8, 64])
+def test_w4a8_cutlass_replica_bitwise(T):
+    ref = RefOps()
+    _install_ops(ref)
+
+    def op(A, A_scale, B, B_scale, bias, D, rows_per_expert, N, K, E):
+        D.copy_(grouped_ref(A, B, rows_per_expert, D.dtype, a_scale=A_scale))
+
+    mod = types.SimpleNamespace(load_op=lambda: op, quant_rows=_quant_rows)
+    stock = _wheel_fn(
+        os.path.join(WHEEL, "b70_moe_w4a8.py"),
+        "apply",
+        {
+            "torch": torch,
+            "load_op": mod.load_op,
+            "quant_rows": _quant_rows,
+            "Optional": __import__("typing").Optional,
+        },
+    )
+    impl = FakeImpl(rank=2, seed=T)
+    hs, ids, w, sentinel = _routing(T, impl, seed=T, nan_rows=(0,) if T > 1 else ())
+    ids_s = torch.where(ids < 0, sentinel, ids)
+    out_s = torch.empty(T, hs.shape[1], dtype=torch.bfloat16)
+    stock(impl, out_s, hs, w, ids_s)
+    ids_k, rpe = kcut.sentinel_and_zero(ids, sentinel, impl.num_experts)
+    out_k = torch.empty_like(out_s)
+    kcut.apply_w4a8_cutlass(mod, impl, out_k, hs, w, ids_k, rpe)
+    assert torch.equal(out_k.view(torch.int16), out_s.view(torch.int16))
+
+
+def test_fingerprint_inspect_matches_ast():
+    """The runtime fingerprint (inspect) equals the offline one (ast over the file)."""
+    import inspect
+
+    src = textwrap.dedent(inspect.getsource(FakeImpl._grouped_gemm))
+    a = kcut.fingerprint_node(ast.parse(src).body[0])
+    assert a == kcut.fingerprint(FakeImpl._grouped_gemm)
+    with open(__file__) as f:
+        tree = ast.parse(f.read())
+    cls = next(
+        n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == "FakeImpl"
+    )
+    fn = next(
+        n
+        for n in cls.body
+        if isinstance(n, ast.FunctionDef) and n.name == "_grouped_gemm"
+    )
+    assert kcut.fingerprint_node(fn) == a
+
