+# ---------------------------------------------------------------- 3. all-reduce
+def _ar_worker(rank, world, port, q):
+    import torch.distributed as dist
+
+    os.environ["MASTER_ADDR"], os.environ["MASTER_PORT"] = "127.0.0.1", str(port)
+    dist.init_process_group("gloo", rank=rank, world_size=world)
+    try:
+        import vllm.distributed.device_communicators.xpu_communicator as xc
+
+        comm = object.__new__(xc.XpuCommunicator)
+        comm.device_group = dist.group.WORLD
+        res = []
+        for R in (8, 64, 4096):
+            g = torch.Generator().manual_seed(R * 10 + rank)
+            x = torch.randn(R, 2560, generator=g).to(torch.bfloat16)
+            keep = x.clone()
+            stock = comm.all_reduce(x)
+            assert torch.equal(x, keep)  # stock leaves its input alone
+            y = keep.clone()
+            got = comm.all_reduce_inplace(y)
+            res.append(
+                (
+                    got.data_ptr() == y.data_ptr(),
+                    torch.equal(got.view(torch.int16), stock.view(torch.int16)),
+                )
+            )
+        q.put((rank, res))
+    finally:
+        dist.destroy_process_group()
+
+
+def test_all_reduce_inplace_bitwise():
+    import torch.multiprocessing as mp
+
+    ctx = mp.get_context("spawn")
+    q = ctx.Queue()
+    port = 29500 + os.getpid() % 1000
+    ps = [ctx.Process(target=_ar_worker, args=(r, 2, port, q)) for r in range(2)]
+    for p in ps:
+        p.start()
+    out = [q.get(timeout=300) for _ in ps]
+    for p in ps:
+        p.join(60)
+    for rank, res in out:
+        assert all(a and b for a, b in res), (rank, res)
+
+
+def test_all_reduce_owned_dispatch(monkeypatch):
+    """Flag off, world 1, compile tracing, no in-place comm -> stock all_reduce."""
+    import types as _t
+
+    import vllm.distributed.parallel_state as ps
+
+    calls = []
+    comm = _t.SimpleNamespace(all_reduce_inplace=lambda x: calls.append("inplace") or x)
+    gc = _t.SimpleNamespace(
+        world_size=4,
+        device_communicator=comm,
+        all_reduce=lambda x: calls.append("stock") or x.clone(),
+    )
+    x = torch.ones(2)
+    for flag, world, dc, want in (
+        (False, 4, comm, "stock"),
+        (True, 1, comm, "stock"),
+        (True, 4, None, "stock"),
+        (True, 4, comm, "inplace"),
+    ):
+        monkeypatch.setattr(ps, "_B70_AR_INPLACE", flag)
+        gc.world_size, gc.device_communicator = world, dc
+        calls.clear()
+        ps.GroupCoordinator.all_reduce_owned(gc, x)
+        assert calls == [want], (flag, world, dc, calls)
+    monkeypatch.setattr(ps, "_B70_AR_INPLACE", True)
+    gc.world_size, gc.device_communicator = 4, comm
+    monkeypatch.setattr(torch.compiler, "is_compiling", lambda: True)
+    calls.clear()
+    ps.GroupCoordinator.all_reduce_owned(gc, x)
+    assert calls == ["stock"]
