+            and xn.shape[0] <= _B70_HC_ORDERED_MAX_ROWS
+        ):
+            from .b70_hc_gemm import parallel_hc_gemm_silu, takes_parallel_route
+
+            linear = (
+                self.input_mix_weight_down_block_inject
+                if self.use_combine
