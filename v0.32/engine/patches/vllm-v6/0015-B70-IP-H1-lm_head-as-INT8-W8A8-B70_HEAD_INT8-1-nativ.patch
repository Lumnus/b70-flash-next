 tests/v1/core/test_b70_ip_h1.py              | 30 ++++++++++
 vllm/models/qwen4_exp/nvidia/b70_fp8_head.py | 60 +++++++++++++++++++-
 2 files changed, 89 insertions(+), 1 deletion(-)
 create mode 100644 tests/v1/core/test_b70_ip_h1.py

diff --git a/tests/v1/core/test_b70_ip_h1.py b/tests/v1/core/test_b70_ip_h1.py
new file mode 100644
