From 4193f51142ffe4dc4b985bb7c2ec6bfeac854902 Mon Sep 17 00:00:00 2001
From: Lumnus <lumnus.org@gmail.com>
Date: Sun, 1 Nov 2026 10:35:20 +0000
Subject: [PATCH 36/51] B70-V7-DFA: DFlash drafter attention on the native INT8
 FA decode (B70_DRAFT_FA_INT8=1)

With B70_PTH_FA_DECODE=1 and an int8_per_token_head draft KV,
load_dflash_model builds the drafter on FLASH_ATTN instead of the configured
backend (TRITON_ATTN, in-kernel dequant). Page bytes are TRITON_ATTN's, so
KV sizing, unify and offload are unchanged; the FA impl writes and reads the
D2 split layout. Refuses head_dim not a multiple of 64 with a log line.
fa_int8_forward gains the non-causal sliding-window case (the drafter's
2048 window): each draft row runs as one q-1 INT8 decode row with window
[w, 0] from the block end. TRITON_ATTN measures the window per row, so a
row j places before the block end loses its j oldest keys (<= 7 of 2048);
exact while seq_len <= w + 1.
---
 vllm/v1/attention/backends/b70_pth_fa.py      | 63 ++++++++++++++++++-
 .../v1/worker/gpu/spec_decode/dflash/utils.py | 49 ++++++++++++++-
 2 files changed, 109 insertions(+), 3 deletions(-)

diff --git a/vllm/v1/attention/backends/b70_pth_fa.py b/vllm/v1/attention/backends/b70_pth_fa.py
index af2c34a545..eb64a1c34f 100644
--- a/vllm/v1/attention/backends/b70_pth_fa.py
+++ b/vllm/v1/attention/backends/b70_pth_fa.py
@@ -344,13 +344,40 @@ def _capturing() -> bool:
         return False
 
 
+_dfa_swa_logged = False
+
+
+def draft_swa_enabled() -> bool:
+    """B70-V7-DFA: a non-causal sliding-window block (the DFlash drafter,
+    window 2048) may take the INT8 decode route (B70_DRAFT_FA_INT8=1)."""
+    return os.environ.get("B70_DRAFT_FA_INT8", "0") == "1"
+
+
 def _noncausal_rows_decode(
-    query, key_cache, value_cache, k_scale, v_scale, output, attn_metadata, impl
+    query,
+    key_cache,
+    value_cache,
+    k_scale,
+    v_scale,
+    output,
+    attn_metadata,
+    impl,
+    window_left: int = -1,
 ) -> None:
     """Non-causal small-q rows (DFlash draft blocks): every query row attends
     to its request's whole context, i.e. one q_len-1 decode row each. Graph-safe
     (no host sync); padded rows past query_start_loc[-1] read one slot of block 0
-    and are zeroed."""
+    and are zeroed.
+
+    B70-V7-DFA: ``window_left >= 0`` (a symmetric non-causal window ``(w, w)``)
+    gives every row the keys ``[seq_len - 1 - w, seq_len - 1]``, i.e. the
+    window measured from the block's last row. TRITON_ATTN measures it from
+    each row (``|q_pos - k_pos| <= w``), so a row ``j`` places before the block
+    end also sees ``j`` older keys there. The two agree while
+    ``seq_len <= w + 1``; past that each row ``j`` loses its ``j`` oldest keys
+    (at most q_len - 1 = 7 of 2048 for the DFlash K=7 drafter). The decode
+    kernel takes one scalar window, so the exact per-row edge is not
+    expressible in one launch."""
     from vllm._xpu_ops import xpu_ops
 
     total = query.shape[0]
@@ -380,6 +407,7 @@ def _noncausal_rows_decode(
         out=output,
         block_table=bt,
         seqused_k=used,
+        window_size=[window_left, 0] if window_left >= 0 else None,
         k_descale=k_scale,
         v_descale=v_scale,
         s_aux=impl.sinks,
@@ -446,6 +474,37 @@ def fa_int8_forward(
             q, key_cache, value_cache, k_scale, v_scale, out, attn_metadata, impl
         )
         return output
+    if (
+        max_q <= spec_decode_max_qlen()
+        and window_size is not None
+        and window_size[0] == window_size[1]
+        and draft_swa_enabled()
+    ):
+        # B70-V7-DFA: the DFlash drafter's non-causal sliding window.
+        global _dfa_swa_logged
+        if not _dfa_swa_logged:
+            _dfa_swa_logged = True
+            logger.info(
+                "B70-V7-DFA non-causal sliding-window rows on the native INT8 "
+                "decode: window %d from the block end, max q %d, head_size %d, "
+                "kv heads %d",
+                window_size[0] + 1,
+                max_q,
+                impl.head_size,
+                impl.num_kv_heads,
+            )
+        _noncausal_rows_decode(
+            q,
+            key_cache,
+            value_cache,
+            k_scale,
+            v_scale,
+            out,
+            attn_metadata,
+            impl,
+            window_left=window_size[0],
+        )
+        return output
 
     # Prefill or mixed batch: dequantize the referenced blocks into the K4
     # scratch and run FA bf16 (the INT8 kernel has no prefill path).
