From 4c5210d424441edd9fcb8972a045335c9346ea44 Mon Sep 17 00:00:00 2001
From: Katsumi Takeuchi <contact@recutita.com>
Date: Wed, 28 Oct 2026 11:15:56 +0900
Subject: [PATCH 2/8] [Perf][XPU][Kernel] Use small-M tiles for the Triton W8A8
 INT8 GEMM

For M <= 64 the heuristic picks a 64-row tile with a 256-deep K step,
which at decode sizes is mostly padding. On XPU use
(next_power_of_2(M), 32, 128) with 8 warps; other platforms and M > 64
are unchanged.

On Arc Pro B70 (608 GB/s), the INT8 GEMMs of a Qwen3.8-27B forward
pass go from 408 to 555 GB/s (67% to 91%) at M=1, and from 408 to
492 GB/s (67% to 81%) at M=64.

Backport of vllm-project/vllm#64190.

Assisted-by: Claude Code with Opus 5.5 medium (Anthropic)
Signed-off-by: Katsumi Takeuchi <contact@recutita.com>
---
 .../quantization/compressed_tensors/triton_scaled_mm.py  | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/vllm/model_executor/layers/quantization/compressed_tensors/triton_scaled_mm.py b/vllm/model_executor/layers/quantization/compressed_tensors/triton_scaled_mm.py
index 8adb41151c..c4578abeed 100644
--- a/vllm/model_executor/layers/quantization/compressed_tensors/triton_scaled_mm.py
+++ b/vllm/model_executor/layers/quantization/compressed_tensors/triton_scaled_mm.py
@@ -4,6 +4,7 @@
 
 import torch
 
+from vllm.platforms import current_platform
 from vllm.triton_utils import tl, triton, use_tensor_descriptor
 from vllm.triton_utils.allocation import set_triton_allocator
 
@@ -213,10 +214,15 @@ def triton_scaled_mm(
 
     has_scalar = lambda x: x.shape[0] == 1 and x.shape[1] == 1
 
+    num_warps = 4
     if use_heuristic:
         is_small_N = N < 8192
         next_power_of_2_M = max(32, triton.next_power_of_2(M))
-        if next_power_of_2_M <= 32:
+        if current_platform.is_xpu() and M <= 64:
+            # BLOCK_M must cover M: every row block re-reads the whole weight.
+            tile_shape = (triton.next_power_of_2(M), 32, 128)
+            num_warps = 8
+        elif next_power_of_2_M <= 32:
             tile_shape = (64, 64, 256) if is_small_N else (64, 128, 256)
         elif next_power_of_2_M <= 64:
             tile_shape = (64, 64, 256)
@@ -279,6 +285,7 @@ def triton_scaled_mm(
         BLOCK_SIZE_SCALE_B=block_size_sb,
         USE_TD=use_td,
         B_T=b_t,
+        num_warps=num_warps,
     )
 
     return result.to(out_dtype)
