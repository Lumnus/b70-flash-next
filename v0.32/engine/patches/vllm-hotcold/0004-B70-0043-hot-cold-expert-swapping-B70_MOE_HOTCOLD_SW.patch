-            self.route_counts = torch.zeros(self.num_global + 1, dtype=torch.int64,
+            self.route_counts = torch.zeros(2, self.num_global + 1, dtype=torch.int64,
                                             device=device)
+            self.count_graphs = os.environ.get("B70_MOE_ROUTE_COUNT") == "1"
