# preset-4card.env — environment of the 4-card preset, 0.32.0-b70.5: sparse (QSA) attention, DFlash2 K=7, 12 slots, patched oneCCL legacy
# plugin + expandable segments (v0.32/README.md "Build and run" step 6). Its measured numbers:
# meta.md "Presets". Every other capability is a parameter (meta.md "Parameters"): the lines that change are
# marked "PARAMETER" below. The scorer launch defaults (patch 0029) and the split KV groups (patch 0036; B70_KV_SPLIT_GROUPS=0 turns
# them off) are in the code, not in this file. docker --env-file / systemd EnvironmentFile format: no quotes, no expansion. Paths are
# placeholders: /models = weights, /cache = writable cache, /opt/b70 = the native libraries (v0.32/README.md "Build and run" steps 5-6). Pair with preset-4card.args.
# ---- Level Zero / oneCCL on 4 cards ----
# PARAMETER cards: the cards this engine uses (with --tensor-parallel-size and draft_tensor_parallel_size in the args)
ZE_AFFINITY_MASK=0,1,2,3
ZE_FLAT_DEVICE_HIERARCHY=FLAT
# the L0 peer-residency shim (wu1ff's, built from his native sources): without it peer residency mirrors device
# memory into host RAM
LD_PRELOAD=/opt/b70/libl0_peer_residency_shim.so
CCL_ZE_IPC_EXCHANGE=sockets
# oneCCL copies every user buffer into its own regular USM first. Required with expandable segments: the user buffer
# is then never IPC-exported (a VMM range reports one mapped chunk as its extent).
CCL_SYCL_ALLGATHERV_TMP_BUF=1
CCL_SYCL_ALLREDUCE_TMP_BUF=1
CCL_SYCL_REDUCE_SCATTER_TMP_BUF=1
CCL_SYCL_BROADCAST_TMP_BUF=1
CCL_SYCL_ALLTOALL_TMP_BUF=1
# small all-reduces up to 64 KiB on the low-latency path (wu1ff's setting). Do not set
# CCL_SYCL_ALLREDUCE_SIMPLE_THRESHOLD=0 (segfaults oneCCL 2022.1.2 here) or CCL_SYCL_ALLREDUCE_LL=twoshots (corrupts output).
CCL_SYCL_ALLREDUCE_LL_THRESHOLD=65536
# the legacy oneCCL plugin rebuilt with uxlfoundation/oneCCL#229 (build step 6). The shipped 2022.1.2 plugin
# segfaults on the first collective once expandable segments are on.
CCL_PLUGIN=/opt/b70/oneccl-legacy/libccl_legacy.so
VLLM_TARGET_DEVICE=xpu
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_USE_V2_MODEL_RUNNER=1

# ---- compute-runtime debug keys (read only with NEOReadDebugKeys=1) ----
NEOReadDebugKeys=1
# one pinned host allocation of >= ~31 GiB is refused by default; the 32 GiB per-rank KV pool needs this
AllowUnrestrictedSize=1
# small per-step host->device copies no longer wait for the in-order queue to drain (on 0.32 this was a ~9.5 ms
# bubble per decode step at one stream); no effect on the 0.30 line
ExperimentalCopyThroughLock=0
ExperimentalH2DCpuCopyThreshold=0
ExperimentalD2HCpuCopyThreshold=0

# ---- torch allocator ----
# expandable segments (needs the patched plugin above); pinned staging blocks above 1 GiB are not cached
PYTORCH_ALLOC_CONF=expandable_segments:True,pinned_max_cached_size_mb:1024

# ---- offline, caches on a writable volume ----
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=/cache/hf
# keep TMPDIR short: zmq IPC paths are limited to 107 characters
TMPDIR=/cache/tmp
TRITON_CACHE_DIR=/cache/triton
VLLM_CACHE_ROOT=/cache/vllm
XDG_CACHE_HOME=/cache/xdg

# ---- PLE n-gram table: INT8, served from NVMe (B70-L32-0013) ----
B70_PLE_INT8_NVME=1
B70_PLE_INT8_PATH=/models/qwen3.8-flash-next/int8-ple/ple_ngram_int8_rowscale.safetensors
B70_PLE_INT8_NVME_PATH=/models/qwen3.8-flash-next/int8-ple/ple_ngram_int8_rowscale.safetensors
# pinned row cache, 8 GiB in total; the table file is read with O_DIRECT by a native reader compiled on first start
B70_PLE_INT8_NVME_CACHE_GIB=8
B70_PLE_INT8_NVME_IO_THREADS=16
B70_PLE_INT8_NVME_STATS=1
B70_PLE_INT8_NVME_READER=native
B70_PLE_INT8_NVME_NATIVE_DIR=/cache/ple-nvme-native
# n-gram ids hashed on the host: one small device->host copy per step instead of ~50 eager hash kernels (B70-V32-03)
B70_PLE_HOST_IDS=1
# the BF16 table of the checkpoint, used only for the boot cross-check (4096 rows, rel L2 <= 0.02)
PLE_TABLE_PATH=/models/qwen3.8-flash-next/W4A16/ple_table_qwen4exp.pt

# ---- KV offload (CPU tier) ----
# a private pinned (USM host) pool per rank instead of a shared /dev/shm region: loads copy directly, no staging
# blocks pile up in host RAM, and no large /dev/shm is needed (B70-V32-RC1)
B70_OFFLOAD_PRIVATE_PINNED=1
# 0014c (the GDN backstep) stays OFF. With the CPU tier and prefix caching (mamba_cache_mode=align) it restores a wrong GDN state on a
# prefix-cache hit (CHANGELOG, 0.32.0-b70.5). The engine's guard (patches/vllm-models 0008) also forces it off under align.
B70_OFFLOAD_GDN_BACKSTEP=0
# the junction heal is done by the cherry-picked vllm-project/vllm#63566; our older 0014b stays off
B70_OFFLOAD_JUNCTION=0
B70_OFFLOAD_EMPTY_ADVANCE_GUARD=0
# a one-line offload summary every 60 s
B70_OFFLOAD_TRACE=1
B70_OFFLOAD_TRACE_PERIOD_S=60

# ---- model path switches ----
# the target lm_head as FP8 W8A16; the BF16 copy is released (needs the kernels built with oneDNN)
B70_HEAD_FP8=1
# DFlash2's fixed-order hyper-connection down projection only up to 32 rows; wider batches take the stock GEMM
# (the ordered Triton kernel is 4.5-6.7x slower above 32 rows)
B70_HC_ORDERED_MAX_ROWS=32
# no prefill hyper-connection graph regions (frees ~0.7 GiB per card for KV)
B70_PREFILL_HC_GRAPHS=0
# keep vLLM's expert-parallel layout (wu1ff's group ownership is faster at decode but costs ~6 % prefill and ~30K KV)
B70_ASTRA_OWNERSHIP=0
VLLM_XPU_DFLASH_FIXED_SPLITS=32
# MTP/drafter prefill with FULL graphs only on XPU (0021)
B70_MTP_DRAFT_PREFILL_NO_PIECEWISE=1

# ---- chat defaults (0009, 0010, 0012) ----
B70_THINKING_BUDGET=minimal=512,low=512,medium=2048,high=4096,xhigh=8192,max=12288,ultra=12288,default=8192
B70_DEFAULT_PRESENCE_PENALTY=0
B70_DEFAULT_REPETITION_DETECTION=max=1,min=1,count=128
B70_REASONING_EFFORT_ALIAS=1

# ---- sparse QSA (series v0.32/engine/patches/vllm-qsa/) ----
# PARAMETER attention: these three keys + serve-config-qsa.json = sparse (default). Dense = remove the three keys and use the dense
# config (v0.30/engines/serve-config-intel-autoround.json) in the serve dir.
# the sparse attention kernel: attn2 (no register spills on Xe2, B70-QSA-K01/K03); unset = the original kernel, which spills
B70_QSA_ATTN_IMPL=attn2
# block top-k: native_det = the native kernel, post-processed to the torch selector's output (repeatable; plain `native`
# orders equal scores differently on every launch); `torch` is the reference and the slowest
B70_QSA_TOPK=native_det
# the repair of native_det's ties as a fused Triton select (two launches per layer) instead of ~50 torch ops; added in
# b70.3 (patches 0027, 0031). Unset = the torch ops, which give the same output but are the slower of the two
B70_QSA_TOPK_SELECT_IMPL=triton

# ---- opt-outs (code defaults are ON; set to 0 to turn off) ----
# B70_KV_SPLIT_GROUPS=0       sparse engine: back to one packed full-attention KV group (patches 0033/0036)
# B70_KV_DRAFT_PAGE_FIT=0     TP2 only: back to the draft page setting every KV block (patch 0038; no effect at TP4)

# ---- PARAMETER expert offload (hot/cold, series v0.32/engine/patches/vllm-hotcold/): off in this preset (all experts resident) ----
# The 2-card preset turns it on (preset-2card.env has the full block: rankings seed, decode op, swapping, learned state).
# B70_MOE_HOTCOLD=1
# B70_MOE_COLD_EXPERTS=16     cold experts per layer per rank (of 128 at TP4, 256 at TP2); capture-safe (hot/cold patch 0013)
