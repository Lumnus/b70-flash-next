# preset-s8-6-2card.env — Qwen3.8-Flash-Next S8-6, sparse QSA, INT8 execution, INT8 KV, 2 cards.
# docker --env-file / systemd EnvironmentFile format: no quotes, no expansion. Paths are placeholders: /models = weights, /cache = writable
# cache, /opt/b70 = the native libraries (v0.32/README.md "Build and run"). Pair with the .args of the same name.
# serve.sh reads this line: the config.json it puts in the serve dir.
SERVE_CONFIG=serve-config-qsa.json
# A second engine on the other pair: ZE_AFFINITY_MASK=1,2 and --port 8001, own TMPDIR and /cache paths.

# ---- Level Zero / oneCCL ----
# the cards this engine uses, with --tensor-parallel-size and draft_tensor_parallel_size in the .args
ZE_AFFINITY_MASK=0,3
ZE_FLAT_DEVICE_HIERARCHY=FLAT
CCL_ZE_IPC_EXCHANGE=sockets
# oneCCL copies every user buffer into its own regular USM first. Required with expandable segments: the user buffer
# is then never IPC-exported (a VMM range reports one mapped chunk as its extent).
CCL_SYCL_ALLGATHERV_TMP_BUF=1
CCL_SYCL_ALLREDUCE_TMP_BUF=1
CCL_SYCL_REDUCE_SCATTER_TMP_BUF=1
CCL_SYCL_BROADCAST_TMP_BUF=1
CCL_SYCL_ALLTOALL_TMP_BUF=1
# small all-reduces up to 64 KiB on the low-latency path (wu1ff's setting). Do not set
# CCL_SYCL_ALLREDUCE_SIMPLE_THRESHOLD=0 (segfaults oneCCL 2022.1.2 here) or CCL_SYCL_ALLREDUCE_LL=twoshots (corrupts output).
CCL_SYCL_ALLREDUCE_LL_THRESHOLD=65536
# oneCCL core's all-reduce ARC path (read by libccl, not by the engine)
CCL_SYCL_ALLREDUCE_ARC=1
# the legacy oneCCL plugin rebuilt with uxlfoundation/oneCCL#229 (build step 6). The shipped 2022.1.2 plugin
# segfaults on the first collective once expandable segments are on.
CCL_PLUGIN=/opt/b70/oneccl-legacy/libccl_legacy.so
VLLM_TARGET_DEVICE=xpu
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_USE_V2_MODEL_RUNNER=1

# ---- compute-runtime debug keys (read only with NEOReadDebugKeys=1) ----
NEOReadDebugKeys=1
# lifts compute-runtime's refusal of one pinned host allocation of >= ~31 GiB
AllowUnrestrictedSize=1
# small per-step host->device copies no longer wait for the in-order queue to drain
ExperimentalCopyThroughLock=0
ExperimentalH2DCpuCopyThreshold=0
ExperimentalD2HCpuCopyThreshold=0

# ---- torch allocator ----
# expandable segments (needs the patched plugin above); pinned staging blocks above 1 GiB are not cached
PYTORCH_ALLOC_CONF=expandable_segments:True,pinned_max_cached_size_mb:1024

# ---- offline, caches on a writable volume ----
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=/cache/hf
# keep TMPDIR short: zmq IPC paths are limited to 107 characters
TMPDIR=/cache/tmp
TRITON_CACHE_DIR=/cache/triton
VLLM_CACHE_ROOT=/cache/vllm
XDG_CACHE_HOME=/cache/xdg

# ---- PLE n-gram table ----
# the INT8 table on NVMe, read per step, which frees about 49 GiB of host RAM against the RAM table
B70_PLE_INT8_NVME=1
B70_PLE_INT8_PATH=/models/qwen3.8-flash-next/int8-ple/ple_ngram_int8_rowscale.safetensors
B70_PLE_INT8_NVME_PATH=/models/qwen3.8-flash-next/int8-ple/ple_ngram_int8_rowscale.safetensors
# pinned row cache in GiB; the table file is read with O_DIRECT by a native reader compiled on first start
B70_PLE_INT8_NVME_CACHE_GIB=4
B70_PLE_INT8_NVME_IO_THREADS=16
B70_PLE_INT8_NVME_STATS=1
B70_PLE_INT8_NVME_READER=native
B70_PLE_INT8_NVME_NATIVE_DIR=/cache/ple-nvme-native
# n-gram ids hashed on the host: one small device->host copy per step instead of ~50 eager hash kernels
B70_PLE_HOST_IDS=1
# the PLE row gather on the device, in the graph (RAM table); on NVMe the rows still arrive through the row cache
B70_PLE_DEVICE_GATHER=1
# the BF16 table of the checkpoint, used only for the boot cross-check (4096 rows, rel L2 <= 0.02)
PLE_TABLE_PATH=/models/qwen3.8-flash-next/W4A16/ple_table_qwen4exp.pt

# ---- KV offload (CPU tier) ----
# a private pinned (USM host) pool per rank instead of a shared /dev/shm region: loads copy directly, no large /dev/shm needed
B70_OFFLOAD_PRIVATE_PINNED=1
# stays 0: with the CPU tier and prefix caching a backstep restores a wrong GDN state on a prefix hit
B70_OFFLOAD_GDN_BACKSTEP=0
# the junction heal is done by the cherry-picked vllm-project/vllm#63566
B70_OFFLOAD_JUNCTION=0
B70_OFFLOAD_EMPTY_ADVANCE_GUARD=0
# a one-line offload summary every 60 s
B70_OFFLOAD_TRACE=1
B70_OFFLOAD_TRACE_PERIOD_S=60

# ---- model path switches ----
# the target lm_head as FP8 W8A16; the BF16 copy is released (needs the kernels built with oneDNN)
B70_HEAD_FP8=1
# DFlash2's fixed-order hyper-connection down projection only up to 32 rows; wider batches take the stock GEMM
# (the ordered Triton kernel is 4.5-6.7x slower above 32 rows)
B70_HC_ORDERED_MAX_ROWS=32
# no prefill hyper-connection graph regions (frees ~0.7 GiB per card for KV)
B70_PREFILL_HC_GRAPHS=0
# keep vLLM's expert-parallel layout (wu1ff's group ownership is faster at decode but costs ~6 % prefill and ~30K KV)
B70_ASTRA_OWNERSHIP=0
VLLM_XPU_DFLASH_FIXED_SPLITS=32
# drafter prefill with FULL graphs only on XPU
B70_MTP_DRAFT_PREFILL_NO_PIECEWISE=1

# ---- v6 levers, all precisions ----
# top-k first temperature sampling and speculative verification
B70_SAMPLER_FAST=1
# MoE expert-parallel sentinel and rows-per-expert zero in one Triton kernel
B70_MOE_KCUT=1
# in-place XCCL all-reduce at the sites that own their buffers
B70_AR_INPLACE=1
# hc_silu folded into the parallel hyper-connection down kernel
B70_HC_SILU_FUSE=1
# the DFlash2 aux features reuse the next layer's hyper-connection combine
B70_DFLASH2_AUX_REUSE=1

# ---- INT8 execution (0 on the BF16-execution presets) ----
# BF16 dense linears run as W8A8 int8
B70_DENSE_INT8=1
# the lm_head as INT8 W8A8, native int8 DPAS
B70_HEAD_INT8=1
# the oneDNN W8A8 GEMM ahead of Triton
B70_XPU_INT8_ONEDNN=1
# routed experts on the native W4A8 grouped GEMM (2); 0 runs them W4A16
B70_MOE_W4A8=2
# W4A8 from the first row
B70_MOE_W4A8_MIN_TOKENS=1
# drafter context K/V through one KV-only int8 GEMM
B70_DFLASH_KV_INT8=1

# ---- chat defaults ----
B70_THINKING_BUDGET=minimal=512,low=512,medium=2048,high=4096,xhigh=8192,max=12288,ultra=12288,default=8192
B70_DEFAULT_PRESENCE_PENALTY=0
B70_DEFAULT_REPETITION_DETECTION=max=1,min=1,count=128
B70_REASONING_EFFORT_ALIAS=1

# ---- sparse QSA ----
# the sparse attention kernel: attn2 (no register spills on Xe2); unset = the original kernel, which spills
B70_QSA_ATTN_IMPL=attn2
# 2 = native int8 Q.K and P.V DPAS in the QSA kernels; 0 on BF16 execution
B70_QSA_I8DOT=2
# block top-k: native_det = the native kernel, post-processed to the torch selector's output (repeatable; plain `native`
# orders equal scores differently on every launch); `torch` is the reference and the slowest
B70_QSA_TOPK=native_det
# the repair of native_det's ties as a fused Triton select instead of ~50 torch ops
B70_QSA_TOPK_SELECT_IMPL=triton

# ---- hot/cold expert offload (2 cards: this is what fits 262,144 tokens of context) ----
# per layer and rank, cold experts live in pinned host RAM and are read over UVA; the VRAM this frees is what fits the context
B70_MOE_HOTCOLD=1
# cold experts per layer per rank, of 256
B70_MOE_COLD_EXPERTS=145
# the starting order of the hot set (meta.md, Weights); replaced by the learned state below once it holds 12 active periods
B70_MOE_HOTCOLD_RANKINGS=/models/qwen3.8-flash-next/static_hot_cache_rankings.json
# prefill batches of >= 512 tokens copy a layer's cold experts into two VRAM slots ahead of use; graph captures read over UVA
B70_MOE_COLD_PREFETCH=1
# count routes, let the VRAM hot set follow the decode traffic, and keep a learned hot set across restarts (one file per rank)
B70_MOE_ROUTE_COUNT=1
B70_MOE_HOTCOLD_SWAP=1
B70_MOE_HOTCOLD_SWAP_SOURCE=decode
# each hot<->cold exchange is a cycle of side-stream copies and routing flips, one phase per step: decode never waits on the host
B70_MOE_HOTCOLD_ASYNC_SWAP=1
# spare cold rows per layer, pinned host RAM
B70_MOE_HOTCOLD_ASYNC_SPARE=16
B70_MOE_HOTCOLD_SWAP_BUDGET=16
B70_MOE_HOTCOLD_SWAP_DECAY=0.85
B70_MOE_HOTCOLD_STATE=/cache/hotcold-state
# the fused hot+cold decode op (build step 5); without the library the two stock calls run
B70_MOE_DECODE_OP=/opt/b70/libb70_moe_decode.so
# the op's CPU pool for cold experts stays off (it needs AVX-512 BF16)
B70_MOE_CPU=0
