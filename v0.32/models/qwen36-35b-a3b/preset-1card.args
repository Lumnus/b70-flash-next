# preset-1card.args — `vllm serve` flags of the Qwen3.6-35B-A3B 1-card preset, 0.32.0-b70.5: one B70, DFlash K=7, bf16 KV, 8 slots,
# 196,608-token context, 32 GiB host-RAM KV tier. One flag and its value per line; pair with preset-1card.env. Measured 2026-10-31
# (numbers in meta.md). Run: v0.32/engine/serve.sh qwen36-35b-a3b preset-1card
--served-model-name qwen36-35b-a3b
--host 0.0.0.0
# PARAMETER port: ours is 8000 + the lowest card index; any free port works
--port 8001
--dtype bfloat16
--tensor-parallel-size 1
# 0.92 leaves 2.34 GiB of 31.89 free under load; the context is pinned below the 207,360 tokens the start-up fit reports
--gpu-memory-utilization 0.92
--max-model-len 196608
# prefill chunk 4096 tokens
--max-num-batched-tokens 4096
--max-num-seqs 8
# the text model only (the checkpoint's vision tower is not loaded)
--language-model-only
# FULL graphs for uniform decode: every multiple of 1+K = 8 up to 8 x 8, plus three prefill sizes
--compilation-config {"cudagraph_mode":"FULL_AND_PIECEWISE","cudagraph_capture_sizes":[1,8,16,24,32,40,48,56,64,256,512,1024]}
--cudagraph-metrics
--enable-auto-tool-choice
--tool-call-parser qwen3_coder
--reasoning-parser qwen3
# the served template (relative to the kit root; serve.sh runs there): a constant serving line first in the system block, the
# thinking guidance and effort mapping; serving_context="" in chat_template_kwargs renders the checkpoint's own template
--chat-template v0.32/models/qwen36-35b-a3b/chat_template-1card.jinja
# server defaults = the model card's thinking-mode preset for precise coding (t 0.6, top_p 0.95, top_k 20, min_p 0, presence 0); a
# request's own values win. The card's general preset (t 1.0, presence 1.5) scored lower on our agent capability gate (34 against 41 of 50)
--override-generation-config {"temperature": 0.6, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.0}
# when the per-effort thinking budget (B70_THINKING_BUDGET) runs out, close thinking with a short transition
--reasoning-config {"reasoning_end_str": "\n\nI have thought enough; time to answer.\n</think>\n\n"}
# CPU KV tier: 32 GiB of pinned host RAM (one 32 GiB block; AllowUnrestrictedSize=1 in the .env)
# PARAMETER KV offload size (GiB, host RAM): 32
--kv-offloading-size 32
--kv-offloading-backend native
# DFlash drafter z-lab/Qwen3.6-35B-A3B-DFlash @ f181eec, 7 draft tokens, drafter attention FLASH_ATTN
--speculative-config {"method":"dflash","model":"/models/qwen3.6-35b-a3b/DFlash","num_speculative_tokens":7,"draft_tensor_parallel_size":1,"draft_sample_method":"probabilistic","rejection_sample_method":"standard","attention_backend":"FLASH_ATTN"}
--enable-prompt-tokens-details
