# preset-1card.env — environment of the Qwen3.6-35B-A3B 1-card preset, 0.32.0-b70.5. Pair with preset-1card.args.
# docker --env-file / systemd EnvironmentFile format: no quotes, no expansion. Paths are placeholders: /models = weights, /cache =
# writable cache, /opt/b70 = the native libraries (v0.32/README.md "Build and run" steps 5-6).
# ---- Level Zero / oneCCL ----
# PARAMETER cards: one card; measured on card 1 of our host (any single B70)
ZE_AFFINITY_MASK=1
ZE_FLAT_DEVICE_HIERARCHY=FLAT
CCL_ZE_IPC_EXCHANGE=sockets
# the Flash-Next oneCCL block, kept at one card too: without it the first DFlash request segfaulted in oneCCL ccl_comp_copy (the
# drafter still calls all_gather_into_tensor at world size 1). The legacy plugin rebuilt with uxlfoundation/oneCCL#229
# (v0.32/README.md "Build and run" step 6) and a tmp-buf copy for every collective.
CCL_PLUGIN=/opt/b70/oneccl-legacy/libccl_legacy.so
CCL_SYCL_ALLREDUCE_LL_THRESHOLD=65536
CCL_SYCL_ALLGATHERV_TMP_BUF=1
CCL_SYCL_ALLREDUCE_TMP_BUF=1
CCL_SYCL_REDUCE_SCATTER_TMP_BUF=1
CCL_SYCL_BROADCAST_TMP_BUF=1
CCL_SYCL_ALLTOALL_TMP_BUF=1
VLLM_TARGET_DEVICE=xpu
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_USE_V2_MODEL_RUNNER=1

# ---- compute-runtime debug keys (read only with NEOReadDebugKeys=1) ----
NEOReadDebugKeys=1
# one pinned host allocation of >= ~31 GiB is refused by default; the 32 GiB KV tier (one 32 GiB block at one card) needs this
AllowUnrestrictedSize=1
ExperimentalCopyThroughLock=0
ExperimentalH2DCpuCopyThreshold=0
ExperimentalD2HCpuCopyThreshold=0

# ---- torch allocator ----
PYTORCH_ALLOC_CONF=expandable_segments:True,pinned_max_cached_size_mb:1024

# ---- offline, caches on a writable volume ----
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=/cache/hf
TMPDIR=/cache/tmp
TRITON_CACHE_DIR=/cache/triton
VLLM_CACHE_ROOT=/cache/vllm
XDG_CACHE_HOME=/cache/xdg

# ---- KV offload (CPU tier) ----
# a private pinned pool per rank (B70-V32-RC1): loads copy directly, no /dev/shm needed
B70_OFFLOAD_PRIVATE_PINNED=1
# 0014c (the GDN backstep) stays OFF. With the CPU tier and prefix caching (mamba_cache_mode=align) it restores a wrong GDN state on a
# prefix-cache hit; it was found on this model family (CHANGELOG, 0.32.0-b70.5). The engine's guard (patches/vllm-models 0008) also
# forces it off under align.
B70_OFFLOAD_GDN_BACKSTEP=0
B70_OFFLOAD_JUNCTION=0
B70_OFFLOAD_EMPTY_ADVANCE_GUARD=0
B70_OFFLOAD_TRACE=1
B70_OFFLOAD_TRACE_PERIOD_S=60

# ---- chat defaults (patches/vllm 0026, 0027, 0018) ----
B70_THINKING_BUDGET=minimal=512,low=512,medium=2048,high=4096,xhigh=8192,max=12288,ultra=12288,default=8192
B70_REASONING_EFFORT_ALIAS=1
B70_DEFAULT_PRESENCE_PENALTY=0
# stops a request whose output ends in an exact period of 32..512 tokens repeated 3 times (paragraph-scale loops), or one token
# repeated 96 times; min 32 keeps exact short-period runs (zero arrays, rulers) from tripping it
B70_DEFAULT_REPETITION_DETECTION=max=512,min=32,count=3
B70_MTP_DRAFT_PREFILL_NO_PIECEWISE=1

# ---- model path switches ----
# INC (AutoRound) int4 linears: oneDNN int4_gemm_w4a8 (int8 XMX) for GEMMs of >= 512 rows, w4a16 below
VLLM_XPU_INC_WNA16_BACKEND=w4a8
# the target lm_head as FP8 W8A16, shared by the drafter (patches/vllm-models 0001)
B70_HEAD_FP8=1
# routed experts run int4 W4A16 through the XPU grouped GEMM (kernels 0005, the scale-prefetch pitch guard, is required for this
# model's expert shapes); the router and shared-expert gates stay bf16. No draft-vocab key: this drafter is DFlash (v1), the
# shortlist head exists only for DFlash2.
