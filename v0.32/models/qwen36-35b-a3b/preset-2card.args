# preset-2card.args — `vllm serve` flags of the Qwen3.6-35B-A3B 2-card preset, 0.32.0-b70.5: tensor parallel 2, DFlash K=7 (draft
# TP2), bf16 KV, 16 slots, the full 262,144-token context, 64 GiB host-RAM KV tier. One flag and its value per line; pair with
# preset-2card.env. Measured 2026-10-29 (numbers in meta.md). Run: v0.32/engine/serve.sh qwen36-35b-a3b preset-2card
--served-model-name qwen36-35b-a3b
--host 0.0.0.0
# PARAMETER port: ours is 8000 + the lowest card index; any free port works
--port 8001
--dtype bfloat16
--tensor-parallel-size 2
# PARAMETER gpu-memory: 0.89, as the Flash-Next presets
--gpu-memory-utilization 0.89
--max-model-len 262144
# prefill chunk 4096 tokens
--max-num-batched-tokens 4096
--max-num-seqs 16
# the text model only (the checkpoint's vision tower is not loaded)
--language-model-only
# FULL graphs for uniform decode: every multiple of 1+K = 8 up to 16 x 8, plus three prefill sizes
--compilation-config {"cudagraph_mode":"FULL_AND_PIECEWISE","cudagraph_capture_sizes":[1,8,16,24,32,40,48,56,64,72,80,88,96,104,112,120,128,256,512,1024]}
--cudagraph-metrics
--enable-auto-tool-choice
--tool-call-parser qwen3_coder
--reasoning-parser qwen3
# generic template (relative to the kit root; serve.sh runs there): the checkpoint's own template plus the thinking switch
# (off wins); behaviour and attribution belong to the client or gateway layer
--chat-template v0.32/models/qwen36-35b-a3b/chat_template.jinja
# server defaults = the model card's thinking-mode preset for precise coding (t 0.6, top_p 0.95, top_k 20, min_p 0, presence 0); a
# request's own values win. The card's general preset (t 1.0, presence 1.5) scored lower on our agent capability gate (34 against 41 of 50)
--override-generation-config {"temperature": 0.6, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.0}
# when the per-effort thinking budget (B70_THINKING_BUDGET) runs out, close thinking with a short transition
--reasoning-config {"reasoning_end_str": "\n\nI have thought enough; time to answer.\n</think>\n\n"}
# CPU KV tier: 64 GiB of pinned host RAM (32 GiB per rank; AllowUnrestrictedSize=1 in the .env)
# PARAMETER KV offload size (GiB, host RAM): 64
--kv-offloading-size 64
--kv-offloading-backend native
# DFlash drafter z-lab/Qwen3.6-35B-A3B-DFlash @ f181eec, 7 draft tokens, sharded over both cards, drafter attention FLASH_ATTN
--speculative-config {"method":"dflash","model":"/models/qwen3.6-35b-a3b/DFlash","num_speculative_tokens":7,"draft_tensor_parallel_size":2,"draft_sample_method":"probabilistic","rejection_sample_method":"standard","attention_backend":"FLASH_ATTN"}
--enable-prompt-tokens-details
