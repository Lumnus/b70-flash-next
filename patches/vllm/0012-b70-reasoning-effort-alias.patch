From 59a776e68b266a08fe5a8bd8b1a6d021f01d30b1 Mon Sep 17 00:00:00 2001
From: Lumnus <lumnus.org@gmail.com>
Date: Wed, 30 Sep 2026 06:56:32 +0000
Subject: [PATCH] 0012-b70-reasoning-effort-alias (rev 2: env-gated)

B70-0012: map OpenRouter-style {"reasoning":{"effort":X}} (Hermes extra_body)
onto reasoning_effort when the request did not set it, so B70-0009 budgets and
the template effort apply. Rev 2: gated
behind B70_REASONING_EFFORT_ALIAS=1, default off. Rev 1 was ungated; with the env set, rev 2 behaves
identically. Apply after 0010, patch -p1 --fuzz=0 from the directory containing vllm/.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../openai/chat_completion/protocol.py        | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/vllm/entrypoints/openai/chat_completion/protocol.py b/vllm/entrypoints/openai/chat_completion/protocol.py
index 9813798..6dbde45 100644
--- a/vllm/entrypoints/openai/chat_completion/protocol.py
+++ b/vllm/entrypoints/openai/chat_completion/protocol.py
@@ -262,6 +262,25 @@ def _b70_repetition_detection(req):
 
 
 class ChatCompletionRequest(OpenAIBaseModel):
+    # B70-0012: OpenRouter-style clients (Hermes) send the effort as
+    # {"reasoning": {"effort": "medium"}} (extra_body), which vLLM ignores, so
+    # B70-0009 budgets and the template effort fell back to the default.
+    # Map it onto reasoning_effort when the request did not set that field.
+    # Env B70_REASONING_EFFORT_ALIAS=1 enables it (unset = upstream).
+    @model_validator(mode="before")
+    @classmethod
+    def _b70_reasoning_effort_alias(cls, data):
+        import os
+        if os.environ.get("B70_REASONING_EFFORT_ALIAS", "0") != "1":
+            return data
+        if isinstance(data, dict) and data.get("reasoning_effort") is None:
+            r = data.get("reasoning")
+            if isinstance(r, dict) and isinstance(r.get("effort"), str):
+                e = r["effort"].strip().lower()
+                if e in ("none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"):
+                    data = {**data, "reasoning_effort": e}
+        return data
+
     # Ordered by official OpenAI API documentation
     # https://platform.openai.com/docs/api-reference/chat/create
     messages: list[ChatCompletionMessageParam]
