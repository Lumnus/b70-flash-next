# r8g-kv64-0014jb — as r8g-kv64, plus the offload fix's candidate default (docs/offload-fix.md).
KV_OFFLOADING_SIZE=64
B70_OFFLOAD_TRACE=1
B70_OFFLOAD_TRACE_PERIOD_S=60
B70_OFFLOAD_JUNCTION=1
# 0014c off since 0.32.0-b70.5 (measured with 1): with prefix caching on a hybrid model it can restore a GDN state built through
# a different chunk split than the cold path, and greedy output then diverges from the first token. The 0.30 code has no
# guard for it, so this key is the only protection. See CHANGELOG, 0.32.0-b70.5.
B70_OFFLOAD_GDN_BACKSTEP=0
B70_OFFLOAD_EMPTY_ADVANCE_GUARD=0
B70_OFFLOAD_GROUP_EVICT=0
