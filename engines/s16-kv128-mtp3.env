# s16-kv128-mtp3 — the configuration we serve (stable line, 0.30.0-b70.2). The model is a parameter: pair this file
# with one model file from engines/models/ (MODEL=awq, recommended, or MODEL=intel-autoround). Same code, same flags,
# same environment for both; only the weights and the serve config differ.
#   MTP speculative decoding with 3 draft tokens (serve-s16-mtp3.args: --no-async-scheduling and cudagraph capture sizes
#   at every multiple of 4 up to 64, so a uniform spec-decode step is never padded; docs/known-issues.md item 6),
#   16 concurrent sequences, a 128 GiB CPU KV tier (0018 chunks), INT8 PLE table served from NVMe (0013),
#   the offload fix's 0014jb arm.
# Kernels: vllm-xpu-kernels 0.1.14.1+b70.3 (docs/kernels.md; wheel attached to the release), which copies CPU->GPU KV
# loads straight from the pinned pool. With the stock 0.1.14.1 kernels set B70_OFFLOAD_H2D_DIRECT=1 instead (patch
# 0031), keep wu1ff's libgdn_index64.so, and keep B70_MTP_UNIFORM_DRAFTS on (the default), because stock 0.1.14.1 lacks
# the ragged spec-row fix (#600) that structured output with MTP needs.
SERVE_ARGS=serve-s16-mtp3.args
KV_OFFLOADING_SIZE=128
# chat defaults: temperature 0.7 comes from the args file; no server-side presence penalty
B70_DEFAULT_PRESENCE_PENALTY=0
# PLE table on NVMe: an 8 GiB pinned row cache in total instead of 48.9 GiB pinned (docs/ple-nvme.md).
# Set B70_PLE_INT8_NVME=0 (and drop the other B70_PLE_INT8_NVME_* lines) to keep the INT8 table in RAM.
B70_PLE_INT8_NVME=1
B70_PLE_INT8_NVME_PATH=/models/qwen3.8-flash-next/int8-ple/ple_ngram_int8_rowscale.safetensors
B70_PLE_INT8_NVME_CACHE_GIB=8
B70_PLE_INT8_NVME_IO_THREADS=16
B70_PLE_INT8_NVME_STATS=1
B70_PLE_INT8_NVME_READER=native
B70_PLE_INT8_NVME_LOOKAHEAD=0
B70_PLE_INT8_NVME_NATIVE_DIR=/cache/ple-nvme-native
# offload fix, 0014jb arm (docs/offload-fix.md)
B70_OFFLOAD_TRACE=1
B70_OFFLOAD_TRACE_PERIOD_S=60
B70_OFFLOAD_JUNCTION=1
B70_OFFLOAD_GDN_BACKSTEP=1
B70_OFFLOAD_EMPTY_ADVANCE_GUARD=0
B70_OFFLOAD_GROUP_EVICT=0
# MTP on XPU (0021): draft prefill uses FULL graphs only; mixed batches run the draft eagerly
B70_MTP_DRAFT_PREFILL_NO_PIECEWISE=1
# CPU->GPU KV loads: 0 with kernels 0.1.14.1+b70.3 (the kernel copies directly); 1 with stock kernels (see above)
B70_OFFLOAD_H2D_DIRECT=0
