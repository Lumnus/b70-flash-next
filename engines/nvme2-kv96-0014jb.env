# nvme2-kv96-0014jb — INT8 PLE served from NVMe (native reader, 8 GiB row cache in total), which frees ~39 GiB of host
# RAM, spent on a 96 GiB CPU KV tier; plus the offload fix's candidate default.
# 96 GiB = 24 GiB per rank, not a power of two, hence the exact-size pinned allocation below.
KV_OFFLOADING_SIZE=96
PYTORCH_ALLOC_CONF=pinned_max_round_threshold_mb:1024,pinned_max_cached_size_mb:1024
B70_PLE_INT8_NVME=1
B70_PLE_INT8_NVME_PATH=/models/qwen3.8-flash-next/int8-ple/ple_ngram_int8_rowscale.safetensors
B70_PLE_INT8_NVME_CACHE_GIB=8
B70_PLE_INT8_NVME_IO_THREADS=16
B70_PLE_INT8_NVME_STATS=1
B70_PLE_INT8_NVME_READER=native
B70_PLE_INT8_NVME_LOOKAHEAD=0
B70_PLE_INT8_NVME_NATIVE_DIR=/cache/ple-nvme-native
B70_OFFLOAD_TRACE=1
B70_OFFLOAD_TRACE_PERIOD_S=60
B70_OFFLOAD_JUNCTION=1
B70_OFFLOAD_GDN_BACKSTEP=1
B70_OFFLOAD_EMPTY_ADVANCE_GUARD=0
B70_OFFLOAD_GROUP_EVICT=0
