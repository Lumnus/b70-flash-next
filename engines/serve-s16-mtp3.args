--served-model-name qwen38-flash-next
--host 0.0.0.0
--port 8000
--dtype bfloat16
--tensor-parallel-size 4
--enable-expert-parallel
--trust-remote-code
--gpu-memory-utilization 0.88
--max-model-len 262144
--max-num-batched-tokens 1024
--max-num-seqs 16
--limit-mm-per-prompt {"image":2,"video":0}
--compilation-config {"cudagraph_mode":"FULL_AND_PIECEWISE","cudagraph_capture_sizes":[1,2,4,8,12,16,20,24,28,32,36,40,44,48,52,56,60,64,256,512,1024]}
--cudagraph-metrics
--enable-auto-tool-choice
--tool-call-parser qwen3_xml
--reasoning-parser qwen3
--override-generation-config {"temperature": 0.7}
--reasoning-config {"reasoning_end_str": "\n\nI have thought enough; time to answer.\n</think>\n\n"}
--speculative-config {"method":"mtp","num_speculative_tokens":3}
--no-async-scheduling
--enable-prompt-tokens-details
--kv-offloading-backend native
