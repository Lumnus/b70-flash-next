# common.env — environment shared by every example engine (read with `docker run --env-file`; no quotes, no
# variable expansion). Paths are placeholders: /models = the model volume, /cache = a writable cache volume.

# Level Zero / oneCCL on 4 cards (wu1ff's settings)
ZE_AFFINITY_MASK=0,1,2,3
ZE_FLAT_DEVICE_HIERARCHY=FLAT
CCL_SYCL_ALLGATHERV_TMP_BUF=1
CCL_SYCL_ALLREDUCE_TMP_BUF=1
CCL_ZE_IPC_EXCHANGE=sockets
# P7: the peer-residency shim. On compute-runtime 26.35 the engine also boots without it, but uses ~21 GiB more host RAM.
LD_PRELOAD=/opt/b70-residency-shim/libl0_peer_residency_shim.so
VLLM_TARGET_DEVICE=xpu
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_XPU_ENABLE_XPU_GRAPH=1

# offline, caches on a writable volume
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HOME=/cache/hf
TMPDIR=/cache/tmp
TRITON_CACHE_DIR=/cache/triton
VLLM_CACHE_ROOT=/cache/vllm
XDG_CACHE_HOME=/cache/xdg

# PLE table: the checkpoint's BF16 table (boot cross-check reference) + the INT8 table (0006, 0008)
PLE_TABLE_PATH=/models/qwen3.8-flash-next/W4A16/ple_table_qwen4exp.pt
B70_PLE_DIRECT_PINNED=1
B70_PLE_FP8=0
B70_PLE_INT8=1
B70_PLE_INT8_PATH=/models/qwen3.8-flash-next/int8-ple/ple_ngram_int8_rowscale.safetensors

# chat defaults (0009, 0010, 0012)
B70_THINKING_BUDGET=minimal=512,low=512,medium=2048,high=4096,xhigh=8192,max=12288,ultra=12288,default=8192
B70_DEFAULT_PRESENCE_PENALTY=0.7
B70_DEFAULT_REPETITION_DETECTION=max=1,min=1,count=128
B70_REASONING_EFFORT_ALIAS=1

# pinned host memory: do not cache >1 GiB pinned staging blocks (docs/measurements/kv-offload.md)
PYTORCH_ALLOC_CONF=pinned_max_cached_size_mb:1024
