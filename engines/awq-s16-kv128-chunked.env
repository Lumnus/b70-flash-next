# awq-s16-kv128-chunked — the configuration we serve (stable line, 0.30.0-b70.1):
#   AWQ weights (wtdcode/Qwen3.8-Flash-Next-AWQ-W4A16 @ 0939125, snapshot made with tools/awq_snapshot.py),
#   16 concurrent sequences with power-of-two cudagraph capture sizes (serve-s16.args),
#   a 128 GiB CPU KV tier (32 GiB per rank; 0018 splits it into pinned chunks, no driver keys needed),
#   INT8 PLE table served from NVMe (0013) and the offload fix's 0014jb arm (0014b/c on).
# Host RAM: at 128 GiB we saw MemAvailable drift down over hours of use (cause not identified, docs/known-issues.md);
# we currently run KV_OFFLOADING_SIZE=64. Keep the size a power of two (total / 4 ranks).
MODEL_DIR=/models/qwen3.8-flash-next/AWQ-W4A16-snapshot
SERVE_ARGS=serve-s16.args
SERVE_CONFIG=serve-config-awq.json
KV_OFFLOADING_SIZE=128
# chat defaults: temperature 0.7 comes from serve-s16.args; no server-side presence penalty
B70_DEFAULT_PRESENCE_PENALTY=0
# PLE table on NVMe: an 8 GiB pinned row cache in total instead of 48.9 GiB pinned (docs/ple-nvme.md).
# Set B70_PLE_INT8_NVME=0 (and drop the other B70_PLE_INT8_NVME_* lines) to keep the INT8 table in RAM.
B70_PLE_INT8_NVME=1
B70_PLE_INT8_NVME_PATH=/models/qwen3.8-flash-next/int8-ple/ple_ngram_int8_rowscale.safetensors
B70_PLE_INT8_NVME_CACHE_GIB=8
B70_PLE_INT8_NVME_IO_THREADS=16
B70_PLE_INT8_NVME_STATS=1
B70_PLE_INT8_NVME_READER=native
B70_PLE_INT8_NVME_LOOKAHEAD=0
B70_PLE_INT8_NVME_NATIVE_DIR=/cache/ple-nvme-native
# offload fix, 0014jb arm (docs/offload-fix.md)
B70_OFFLOAD_TRACE=1
B70_OFFLOAD_TRACE_PERIOD_S=60
B70_OFFLOAD_JUNCTION=1
B70_OFFLOAD_GDN_BACKSTEP=1
B70_OFFLOAD_EMPTY_ADVANCE_GUARD=0
B70_OFFLOAD_GROUP_EVICT=0
